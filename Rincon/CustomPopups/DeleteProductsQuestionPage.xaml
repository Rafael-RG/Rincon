<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
        xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="Rincon.CustomPopups.DeleteProductsQuestionPage"
        xmlns:models="clr-namespace:Rincon.Models;assembly=Rincon.Models"
        xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
        BackgroundColor="#80000000"
        Title="DeleteProduct"
        CloseWhenBackgroundIsClicked="False">


    <Border
        Margin="150,100,150,100"
        HeightRequest="450"
        WidthRequest="650"
        Padding="40"
        BackgroundColor="White"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Stroke="#79280F"
        StrokeThickness="2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12,12,12,12" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.2" />
        </Border.Shadow>
        <Grid RowDefinitions="auto,auto,*,auto" RowSpacing="20">
            <Frame BackgroundColor="#FFF3E0" 
                   BorderColor="#FF9800" 
                   CornerRadius="50" 
                   HeightRequest="90" 
                   WidthRequest="90" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   HasShadow="False"
                   Padding="0">
                <Image Source="alert_icon.png" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       HeightRequest="60" 
                       WidthRequest="60"/>
            </Frame>
            <Label Text="¿Eliminar este producto?" 
                   Grid.Row="1" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   TextColor="#79280F" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center"/>
            <Frame Grid.Row="2"
                   BackgroundColor="#F8F9FA"
                   BorderColor="#E0E0E0"
                   CornerRadius="8"
                   Padding="15"
                   Margin="10,10,10,10">
                <Label
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    FontSize="16"
                    TextColor="#333333"
                    LineBreakMode="WordWrap"
                    HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span x:Name="ProductId" FontAttributes="Bold"/>
                            <Span Text=" - "/>
                            <Span x:Name="ProductDescription"/>
                            <Span Text=" - "/>
                            <Span x:Name="ProductState" FontAttributes="Italic"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Frame>
            <Grid Grid.Row="3" 
                  ColumnDefinitions="*,*" 
                  ColumnSpacing="20" 
                  HorizontalOptions="Center">
                <Button Grid.Column="0"
                        Text="Cancelar" 
                        BackgroundColor="#FFF6ED" 
                        BorderColor="#79280F"
                        BorderWidth="2"
                        Clicked="CancelDeleteProduct_Clicked" 
                        HeightRequest="50" 
                        TextColor="#79280F" 
                        FontSize="16" 
                        FontAttributes="Bold"
                        CornerRadius="8"
                        MinimumWidthRequest="150"/>
                <Button Grid.Column="1"
                        Text="Eliminar" 
                        BackgroundColor="#DC3545" 
                        Clicked="OkDeleteProduct_Clicked" 
                        HeightRequest="50" 
                        TextColor="White" 
                        FontSize="16" 
                        FontAttributes="Bold"
                        CornerRadius="8"
                        MinimumWidthRequest="150"/>
            </Grid>
        </Grid>
    </Border>
</mopups:PopupPage>

