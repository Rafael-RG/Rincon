<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
        xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="Rincon.CustomPopups.DeleteProductsQuestionPage"
        xmlns:models="clr-namespace:Rincon.Models;assembly=Rincon.Models"
        xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
        BackgroundColor="#80000000"
        Title="DeleteProduct"
        CloseWhenBackgroundIsClicked="False">


    <Border
        Margin="50,100,50,100"
        HeightRequest="450"
        WidthRequest="600"
        MaximumHeightRequest="500"
        MaximumWidthRequest="700"
        Padding="30"
        BackgroundColor="White"
        HorizontalOptions="Center"
        VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20,20,20,20" />
        </Border.StrokeShape>
        <Grid RowDefinitions="auto,auto,auto,auto" RowSpacing="20">
            <Image Source="alert_icon.png" Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="90" WidthRequest="90"/>
            <Label Text="¿Quiere eliminar este producto?" Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black" FontSize="26" FontAttributes="Bold" LineBreakMode="WordWrap"/>
            <Label
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Grid.Row="2"
                Margin="10,0,10,0"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="black"
                LineBreakMode="WordWrap"
                HorizontalTextAlignment="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span x:Name="ProductId"/>
                        <Span Text="     "/>
                        <Span x:Name="ProductDescription"/>
                        <Span Text="     "/>
                        <Span x:Name="ProductState"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="40">
                <Button Text="No" BackgroundColor="#D3AA84" Clicked="CancelDeleteProduct_Clicked" WidthRequest="180" HeightRequest="50" TextColor="Black" FontSize="18" CornerRadius="10"/>
                <Button Text="Sí" BackgroundColor="#FFF6ED" Clicked="OkDeleteProduct_Clicked" WidthRequest="180" HeightRequest="50" TextColor="Black" FontSize="18" CornerRadius="10"/>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</mopups:PopupPage>

