<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
    x:Class="Rincon.CustomPopups.SuccessMessagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    Title="SuccessEditUser"
    BackgroundColor="#80000000"
    CloseWhenBackgroundIsClicked="False">

    <Border
        Margin="200,150,200,150"
        Padding="40"
        BackgroundColor="White"
        HeightRequest="350"
        WidthRequest="700"
        Stroke="#79280F"
        StrokeThickness="2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12,12,12,12" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.2" />
        </Border.Shadow>
        <Grid RowDefinitions="auto,*,auto" RowSpacing="20">
            <Frame BackgroundColor="#E8F5E8" 
                   BorderColor="#4CAF50" 
                   CornerRadius="50" 
                   HeightRequest="90" 
                   WidthRequest="90" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   HasShadow="False"
                   Padding="0">
                <Image
                    HeightRequest="60"
                    HorizontalOptions="Center"
                    Source="check_icon.png"
                    VerticalOptions="Center"
                    WidthRequest="60" />
            </Frame>
            <Label
                x:Name="Message"
                Grid.Row="1"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                TextColor="#333333"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap" />
            <Button
                Grid.Row="2"
                BackgroundColor="#79280F"
                Clicked="ConfirmEditUser_Clicked"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="Continuar"
                TextColor="White"
                CornerRadius="8"
                HorizontalOptions="Center"
                MinimumWidthRequest="180" />
        </Grid>
    </Border>
</mopups:PopupPage>

