<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Rincon.CustomPopups.FinishTaskAuthPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:OperatorsViewModel"
    BackgroundColor="#80000000">
    <Grid HeightRequest="400" WidthRequest="500">
        <Frame Margin="40" Padding="35" BackgroundColor="#D3AA84" CornerRadius="12" HasShadow="True" BorderColor="Transparent" VerticalOptions="Fill" HorizontalOptions="Fill">
            <Frame.Shadow>
                <Shadow Brush="#80000000" Offset="0,4" Radius="8" Opacity="0.5" />
            </Frame.Shadow>
            <StackLayout HorizontalOptions="Fill" VerticalOptions="Fill" Spacing="10">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Margin="0,0,0,40">
                    <Label Text="Identificación" Grid.ColumnSpan="2" HorizontalOptions="Center" FontSize="22" FontAttributes="Bold" TextColor="#303030"/>
                    <ImageButton Source="delete_item_icon" WidthRequest="24" HeightRequest="24" HorizontalOptions="End" Command="{Binding ClosePopupCommand}"/>
                </Grid>    
                <Frame 
                    CornerRadius="12" 
                    WidthRequest="320"
                    BackgroundColor="#FFF6ED"
                    BorderColor="#FFF6ED"
                    HeightRequest="35"
                    HasShadow="False"
                    Padding="3"
                    HorizontalOptions="Fill">            
                    <Entry Placeholder="Usuario" WidthRequest="320" PlaceholderColor="#797979"  Margin="0,10,0,0" HeightRequest="40" Text="{Binding OperatorUser}" />
                </Frame>
                <Frame 
                    HeightRequest="35"
                    WidthRequest="320"
                    CornerRadius="12" 
                    BackgroundColor="#FFF6ED"
                    BorderColor="#FFF6ED"
                    HasShadow="False"
                    Padding="3"
                    HorizontalOptions="Fill">
                    <Entry Placeholder="PIN" WidthRequest="320" PlaceholderColor="#797979"  Margin="0,10,0,0" HeightRequest="40" IsPassword="True" Text="{Binding OperatorPin}" />
                </Frame>
                <Button Text="Finalizar tarea" BackgroundColor="#4A744C" TextColor="#FAFAFA" CornerRadius="8" HorizontalOptions="Center" WidthRequest="320" Margin="0,20,0,0" Command="{Binding FinishTaskAuthCommand}" />
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>
