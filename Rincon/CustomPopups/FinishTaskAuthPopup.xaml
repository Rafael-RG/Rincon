<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Rincon.CustomPopups.FinishTaskAuthPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:OperatorsViewModel"
    BackgroundColor="#80000000">
    <Grid HeightRequest="480" WidthRequest="500">
        <Frame Margin="40" Padding="30" BackgroundColor="#D3AA84" CornerRadius="12" HasShadow="True" BorderColor="Transparent" VerticalOptions="Fill" HorizontalOptions="Fill">
            <Frame.Shadow>
                <Shadow Brush="#80000000" Offset="0,4" Radius="8" Opacity="0.5" />
            </Frame.Shadow>
            <StackLayout HorizontalOptions="Fill" VerticalOptions="Fill" Spacing="10">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Start" Margin="0,0,0,20">
                    <Label Text="Identificación" Grid.ColumnSpan="2" HorizontalOptions="Center" FontSize="22" FontAttributes="Bold" TextColor="#303030"/>
                    <ImageButton Source="delete_item_icon" WidthRequest="24" HeightRequest="24" HorizontalOptions="End" Command="{Binding ClosePopupCommand}"/>
                </Grid>    
                
                <!-- Campo Usuario - Lista desplegable -->
                <Label Text="Seleccione un usuario:" FontSize="16" FontAttributes="Bold" TextColor="#303030" Margin="0,0,0,5"/>
                <Frame 
                    CornerRadius="12" 
                    WidthRequest="320"
                    BackgroundColor="#FFF6ED"
                    BorderColor="#D3AA84"
                    HeightRequest="50"
                    HasShadow="False"
                    Padding="10,5"
                    HorizontalOptions="Fill">            
                    <Picker ItemsSource="{Binding Operators}"
                            SelectedItem="{Binding SelectedOperator}"
                            ItemDisplayBinding="{Binding FullName}"
                            Title="Seleccionar usuario..."
                            FontSize="16"
                            TextColor="#303030"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                            TitleColor="#797979"/>
                </Frame>
                
                <!-- Campo PIN -->
                <Label Text="Ingrese su PIN:" FontSize="16" FontAttributes="Bold" TextColor="#303030" Margin="0,10,0,5"/>
                <Frame 
                    HeightRequest="50"
                    WidthRequest="320"
                    CornerRadius="12" 
                    BackgroundColor="#FFF6ED"
                    BorderColor="#D3AA84"
                    HasShadow="False"
                    Padding="10,5"
                    HorizontalOptions="Fill">
                    <Entry Placeholder="Ingrese su PIN" 
                           PlaceholderColor="#797979"  
                           BackgroundColor="Transparent"
                           FontSize="16"
                           TextColor="#303030"
                           IsPassword="True" 
                           Keyboard="Numeric"
                           Text="{Binding OperatorPin}"
                           IsEnabled="{Binding IsPinEnabled}"
                           VerticalOptions="Center"
                           HorizontalOptions="Fill" />
                </Frame>
                
                <Button Text="Finalizar tarea" 
                        BackgroundColor="#4A744C" 
                        TextColor="#FAFAFA" 
                        CornerRadius="8" 
                        HorizontalOptions="Center" 
                        WidthRequest="320" 
                        HeightRequest="45"
                        FontSize="16"
                        FontAttributes="Bold"
                        Margin="0,15,0,10" 
                        Command="{Binding FinishTaskAuthCommand}"
                        IsEnabled="{Binding IsConfirmEnabled}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsConfirmEnabled}" Value="True">
                            <Setter Property="BackgroundColor" Value="#4A744C" />
                            <Setter Property="TextColor" Value="#FAFAFA" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsConfirmEnabled}" Value="False">
                            <Setter Property="BackgroundColor" Value="#A0A0A0" />
                            <Setter Property="TextColor" Value="#CCCCCC" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>
