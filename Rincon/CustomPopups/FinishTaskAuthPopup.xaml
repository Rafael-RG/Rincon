<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Rincon.CustomPopups.FinishTaskAuthPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:OperatorsViewModel"
    BackgroundColor="#80000000">
    <Grid HeightRequest="600" WidthRequest="550">
        <Frame Margin="40" 
               Padding="30" 
               BackgroundColor="White" 
               BorderColor="#4A744C"
               CornerRadius="12" 
               HasShadow="True" 
               VerticalOptions="Fill" 
               HorizontalOptions="Fill">
            <StackLayout HorizontalOptions="Fill" VerticalOptions="Fill" Spacing="20">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Start" Margin="0,0,0,15">
                    <Label Text="Identificación" 
                           Grid.ColumnSpan="2" 
                           HorizontalOptions="Center" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#4A744C"/>
                    <Frame Grid.Column="1"
                           Padding="6"
                           BackgroundColor="#F8F9FA"
                           CornerRadius="15"
                           HasShadow="False">
                        <ImageButton Source="delete_item_icon.png" 
                                     BackgroundColor="Transparent"
                                     WidthRequest="40" 
                                     HeightRequest="20" 
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Command="{Binding ClosePopupCommand}"/>
                    </Frame>
                </Grid>    
                
                <!-- Separador -->
                <BoxView HeightRequest="2" 
                         Color="#4A744C" 
                         HorizontalOptions="Fill" />
                
                <!-- Campo Usuario - Lista desplegable -->
                <Label Text="Seleccione un usuario:" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#4A744C" 
                       Margin="0,10,0,5"/>
                <Frame CornerRadius="8" 
                       WidthRequest="320"
                       BackgroundColor="White"
                       BorderColor="#4A744C"
                       HeightRequest="75"
                       HasShadow="True"
                       Padding="0"
                       HorizontalOptions="Fill">            
                    <Picker ItemsSource="{Binding Operators}"
                            SelectedItem="{Binding SelectedOperator}"
                            ItemDisplayBinding="{Binding FullName}"
                            Title="Seleccionar usuario..."
                            FontSize="16"
                            TextColor="#333333"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"
                            Margin="15,0"
                            TitleColor="#999999"/>
                </Frame>
                
                <!-- Campo PIN -->
                <Label Text="Ingrese su PIN:" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#4A744C" 
                       Margin="0,15,0,5"/>
                <Frame HeightRequest="55"
                       WidthRequest="320"
                       CornerRadius="8" 
                       BackgroundColor="White"
                       BorderColor="#4A744C"
                       HasShadow="True"
                       Padding="0"
                       HorizontalOptions="Fill">
                    <Entry Placeholder="Ingrese su PIN" 
                           PlaceholderColor="#999999"  
                           BackgroundColor="Transparent"
                           FontSize="16"
                           TextColor="#333333"
                           IsPassword="True" 
                           Keyboard="Numeric"
                           Text="{Binding OperatorPin}"
                           IsEnabled="{Binding IsPinEnabled}"
                           VerticalOptions="Center"
                           Margin="15,0" />
                </Frame>
                
                <Button Text="Finalizar tarea" 
                        BackgroundColor="#4A744C" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HorizontalOptions="Fill" 
                        HeightRequest="55"
                        FontSize="18"
                        FontAttributes="Bold"
                        Margin="0,20,0,0" 
                        Command="{Binding FinishTaskAuthCommand}"
                        IsEnabled="{Binding IsConfirmEnabled}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsConfirmEnabled}" Value="True">
                            <Setter Property="BackgroundColor" Value="#4A744C" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsConfirmEnabled}" Value="False">
                            <Setter Property="BackgroundColor" Value="#A0A0A0" />
                            <Setter Property="TextColor" Value="#CCCCCC" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>
