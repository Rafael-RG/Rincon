<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
    x:Class="Rincon.CustomPopups.ConfirmAddStockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Rincon.Models;assembly=Rincon.Models"
    xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    Title="ConfirmAddStockPage"
    BackgroundColor="#80000000"
    CloseWhenBackgroundIsClicked="False">

    <Border
        Margin="150,60,150,60"
        Padding="30,25"
        BackgroundColor="White">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16,16,16,16" />
        </Border.StrokeShape>

        <Grid
            BackgroundColor="White"
            ColumnDefinitions="*"
            HorizontalOptions="FillAndExpand"
            RowDefinitions="auto,auto,auto,*,auto,auto"
            VerticalOptions="FillAndExpand">
            
            <!-- Título -->
            <Label
                Margin="0,0,0,8"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                Text="Confirmación de Carga de Stock"
                TextColor="#79280F"
                VerticalOptions="Center" />

            <BoxView
                Grid.Row="1"
                Margin="0,0,0,15"
                HeightRequest="2"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                Color="#79280F" />

            <!-- Header de la tabla responsive -->
            <Grid Grid.Row="2" 
                  ColumnDefinitions="*,*,*,120" 
                  ColumnSpacing="8" 
                  Padding="8,6" 
                  BackgroundColor="#F5F5F5"
                  Margin="0,0,0,8">
                <Label Text="Código" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="#79280F" 
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <Label Grid.Column="1" 
                       Text="Descripción" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="#79280F" 
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <Label Grid.Column="2" 
                       Text="Estado" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="#79280F" 
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <Label Grid.Column="3" 
                       Text="Cantidad" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="#79280F" 
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </Grid>
            
            <!-- Lista de productos con diseño compacto -->
            <Frame Grid.Row="3" 
                   CornerRadius="8" 
                   Padding="4" 
                   BackgroundColor="#FAFAFA" 
                   BorderColor="#E0E0E0"
                   Margin="0,0,0,8">
                <CollectionView
                    x:Name="ProductsStockToAdd"
                    SelectionMode="None"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Default">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductStock">
                            <Grid
                                ColumnDefinitions="*,*,*,120"
                                ColumnSpacing="8"
                                RowDefinitions="auto"
                                Padding="8,6"
                                VerticalOptions="Center">
                                
                                <Label
                                    FontSize="13"
                                    Text="{Binding Product.Id}"
                                    TextColor="#000000"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{Binding Product.Description}"
                                    TextColor="#000000"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="13"
                                    Text="{Binding Product.WoodState}"
                                    TextColor="#000000"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    LineBreakMode="TailTruncation" />

                                <Frame
                                    Grid.Column="3"
                                    Padding="6,2"
                                    BackgroundColor="#E8F4E8"
                                    BorderColor="#4A744C"
                                    CornerRadius="6"
                                    HeightRequest="24"
                                    HorizontalOptions="Center">
                                    <Label
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Text="{Binding Quantity}"
                                        TextColor="#2D5A2F"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center" />
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="No hay productos para cargar"
                            TextColor="#797979"
                            VerticalOptions="Center"
                            Padding="20" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Frame>

            <BoxView
                Grid.Row="4"
                HeightRequest="2"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                Margin="0,8,0,12"
                Color="#79280F" />

            <!-- Layout horizontal optimizado para botones -->
            <Grid
                Grid.Row="5"
                ColumnDefinitions="*,auto,140,140,auto,*"
                ColumnSpacing="12"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
                
                <!-- ActivityIndicator superpuesto -->
                <ActivityIndicator
                    x:Name="ActivityIndicatorPDF"
                    Grid.ColumnSpan="6"
                    HeightRequest="32"
                    HorizontalOptions="Center"
                    IsRunning="False"
                    Color="#4A744C"
                    IsVisible="False"
                    VerticalOptions="Center"
                    WidthRequest="32" />
                
                <!-- Contenedor de botones -->
                <Grid
                    x:Name="ButtonsContainer"
                    Grid.ColumnSpan="6"
                    ColumnDefinitions="*,auto,140,140,auto,*"
                    ColumnSpacing="12">
                    
                    <!-- Fecha/hora a la izquierda -->
                    <Label
                        x:Name="DateTime"
                        Grid.Column="1"
                        FontSize="13"
                        TextColor="#79280F"
                        VerticalOptions="Center"
                        HorizontalOptions="Start" />
                    
                    <!-- Botones centrados -->
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#D3AA84"
                        Clicked="OkAddStock_Clicked"
                        HeightRequest="35"
                        Text="Confirmar"
                        TextColor="#000000"
                        FontSize="13"
                        CornerRadius="6" />
                        
                    <Button
                        Grid.Column="3"
                        BackgroundColor="#FFF6ED"
                        Clicked="CancelAddStock_Clicked"
                        HeightRequest="35"
                        Text="Cancelar"
                        TextColor="#000000"
                        FontSize="13"
                        CornerRadius="6" />

                    <!-- Botón PDF a la derecha -->
                    <ImageButton
                        Grid.Column="4"
                        Padding="6"
                        BackgroundColor="#79280F"
                        Clicked="SavePDF_Clicked"
                        CornerRadius="6"
                        HeightRequest="32"
                        HorizontalOptions="End"
                        Source="download_icon.png"
                        WidthRequest="32" />
                </Grid>
            </Grid>
        </Grid>
    </Border>


</mopups:PopupPage>