<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Rincon.CustomPopups.ConfirmCancelEditProductPage"
    xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    BackgroundColor="#80000000"
    Title="ConfirmCancelEditProduct"
    CloseWhenBackgroundIsClicked="False">

    <Border
        Margin="200,150,200,150"
        HeightRequest="400"
        WidthRequest="800"
        Padding="40"
        BackgroundColor="White"
        Stroke="#79280F"
        StrokeThickness="2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12,12,12,12" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.2" />
        </Border.Shadow>
        <Grid RowDefinitions="auto,*,auto" RowSpacing="20">
            <Image Source="alert_icon.png" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   HeightRequest="60" 
                   WidthRequest="60"/>
            <StackLayout Grid.Row="1" Spacing="10" VerticalOptions="Center">
                <Label Text="¿Descartar cambios?" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="#79280F" 
                       FontSize="22" 
                       FontAttributes="Bold"/>
                <Label Text="Al aceptar se borrarán todos los cambios realizados" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="#333333" 
                       FontSize="16" 
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
            </StackLayout>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20">
                <Button Grid.Column="0"
                        Text="Seguir editando" 
                        BackgroundColor="#79280F" 
                        Clicked="ContinueEditProduct_Clicked" 
                        HeightRequest="50" 
                        TextColor="White" 
                        FontSize="16"
                        CornerRadius="8"/>
                <Button Grid.Column="1"
                        Text="Aceptar" 
                        BackgroundColor="#FFF6ED" 
                        BorderColor="#79280F"
                        BorderWidth="2"
                        Clicked="CloseEditProduct_Clicked" 
                        HeightRequest="50" 
                        TextColor="#79280F" 
                        FontSize="16"
                        CornerRadius="8"/>
            </Grid>
        </Grid>
    </Border>

</mopups:PopupPage>

