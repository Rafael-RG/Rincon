<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
    x:Class="Rincon.CustomPopups.SuccessEditProductPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    Title="SuccessEditProduct"
    BackgroundColor="#80000000"
    CloseWhenBackgroundIsClicked="False">

    <Border
        Margin="200,150,200,150"
        Padding="40"
        BackgroundColor="White"
        HeightRequest="350"
        WidthRequest="700"
        Stroke="#79280F"
        StrokeThickness="2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12,12,12,12" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.2" />
        </Border.Shadow>
        <Grid RowDefinitions="auto,*,auto" RowSpacing="20">
            <Image
                HeightRequest="70"
                HorizontalOptions="Center"
                Source="check_icon.png"
                VerticalOptions="Center"
                WidthRequest="70" />
            <StackLayout Grid.Row="1" Spacing="10" VerticalOptions="Center">
                <Label Text="¡Éxito!"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="#79280F"
                       FontSize="26"
                       FontAttributes="Bold" />
                <Label Text="Producto editado con éxito"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="#333333"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </StackLayout>
            <Button
                Grid.Row="2"
                BackgroundColor="#79280F"
                Clicked="CloseEditProduct_Clicked"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="Continuar"
                TextColor="White"
                CornerRadius="8"
                HorizontalOptions="Center"
                WidthRequest="180" />

        </Grid>
    </Border>


</mopups:PopupPage>

