<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
    x:Class="Rincon.CustomPopups.DeleteMessagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    Title="DeleteOperator"
    BackgroundColor="#80000000"
    CloseWhenBackgroundIsClicked="False">

    <Border
        Margin="150,120,150,120"
        Padding="40"
        BackgroundColor="White"
        HeightRequest="400"
        WidthRequest="600"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Stroke="#79280F"
        StrokeThickness="2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12,12,12,12" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.2" />
        </Border.Shadow>
        <Grid RowDefinitions="auto,*,auto" RowSpacing="25">
            <Frame BackgroundColor="#FFF3E0" 
                   BorderColor="#FF9800" 
                   CornerRadius="50" 
                   HeightRequest="90" 
                   WidthRequest="90" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   HasShadow="False"
                   Padding="0">
                <Image
                    HeightRequest="60"
                    HorizontalOptions="Center"
                    Source="alert_icon.png"
                    VerticalOptions="Center"
                    WidthRequest="60" />
            </Frame>
            <Label
                x:Name="Message"
                Grid.Row="1"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                TextColor="#333333"
                VerticalOptions="Center"
                LineBreakMode="WordWrap"
                HorizontalTextAlignment="Center"
                Margin="10,0,10,0" />

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,*"
                ColumnSpacing="20"
                HorizontalOptions="Center">
                <Button
                    Grid.Column="0"
                    BackgroundColor="#FFF6ED"
                    BorderColor="#79280F"
                    BorderWidth="2"
                    Clicked="BackDeleteOperator_Clicked"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Text="Cancelar"
                    TextColor="#79280F"
                    MinimumWidthRequest="150"
                    CornerRadius="8" />

                <Button
                    Grid.Column="1"
                    BackgroundColor="#DC3545"
                    Clicked="ConfirmDeleteOperator_Clicked"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Text="Eliminar"
                    TextColor="White"
                    MinimumWidthRequest="150"
                    CornerRadius="8" />
            </Grid>

        </Grid>
    </Border>
</mopups:PopupPage>

