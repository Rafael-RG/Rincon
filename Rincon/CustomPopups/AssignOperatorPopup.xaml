<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Rincon.CustomPopups.AssignOperatorPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:OperatorsViewModel"
    BackgroundColor="#80000000">
    <Grid VerticalOptions="Center" HorizontalOptions="Center">
        <Frame Margin="40" Padding="25" BackgroundColor="#D3D3D3" CornerRadius="12" HasShadow="True" VerticalOptions="Center" HorizontalOptions="Center">
            <StackLayout>
                <Label Text="Identificación" FontSize="22" FontAttributes="Bold" TextColor="#222" Margin="0,0,0,10" />
                <Entry Placeholder="Usuario" BackgroundColor="#E0E0E0" Margin="0,10,0,0" HeightRequest="40" Text="{Binding OperatorUser}"/>
                <Entry Placeholder="PIN" BackgroundColor="#E0E0E0" Margin="0,10,0,0" HeightRequest="40" IsPassword="True"  Text="{Binding OperatorPin}"/>
                <Button Text="Entrar" BackgroundColor="#F5F5F5" TextColor="#222" CornerRadius="8" HorizontalOptions="Center" WidthRequest="120" Margin="0,20,0,0" Command="{Binding EnterOperatorCommand}" />
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>
