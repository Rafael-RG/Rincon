<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Rincon.CustomPopups.AssignOperatorPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    xmlns:models="clr-namespace:Rincon.Models;assembly=Rincon.Models"
    x:DataType="viewModels:OperatorsViewModel"
    BackgroundColor="#80000000">
    
    <Grid HeightRequest="580" WidthRequest="550">
        <Frame Margin="40" 
               Padding="30" 
               BackgroundColor="White" 
               BorderColor="#4A744C"
               CornerRadius="12" 
               HasShadow="True" 
               VerticalOptions="Fill" 
               HorizontalOptions="Fill">
            <StackLayout HorizontalOptions="Fill" VerticalOptions="Fill" Spacing="15">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Start" Margin="0,0,0,15">
                    <Label Text="Seleccionar Operador" 
                           Grid.ColumnSpan="2" 
                           HorizontalOptions="Center" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#4A744C"/>
                    <Frame Grid.Column="1"
                           Padding="6"
                           BackgroundColor="#F8F9FA"
                           CornerRadius="15"
                           HasShadow="False">
                        <ImageButton Source="delete_item_icon.png" 
                                     BackgroundColor="Transparent"
                                     WidthRequest="40" 
                                     HeightRequest="20" 
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Command="{Binding ClosePopupCommand}"/>
                    </Frame>
                </Grid>
                
                <!-- Separador -->
                <BoxView HeightRequest="1" 
                         Color="#4A744C" 
                         HorizontalOptions="Fill" />
                
                <!-- Lista desplegable de Operadores -->
                <Label Text="Seleccione un operador:" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#4A744C" 
                       Margin="0,5,0,5"/>
                <Frame WidthRequest="320"
                       HeightRequest="75"
                       CornerRadius="8" 
                       BackgroundColor="White"
                       BorderColor="#4A744C"
                       HasShadow="True"
                       Padding="0"
                       HorizontalOptions="Fill">
                    <Picker ItemsSource="{Binding Operators}"
                            SelectedItem="{Binding SelectedOperator}"
                            ItemDisplayBinding="{Binding FullName}"
                            Title="Seleccionar operador..."
                            FontSize="16"
                            TextColor="#333333"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"
                            Margin="12,0"
                            TitleColor="#999999"/>
                </Frame>
                
                <!-- Campo PIN -->
                <Label Text="Ingrese su PIN:" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#4A744C" 
                       Margin="0,10,0,5"/>
                <Frame x:Name="PinFrame"
                       WidthRequest="320"
                       HeightRequest="50"
                       CornerRadius="8" 
                       BackgroundColor="White"
                       BorderColor="#4A744C"
                       HasShadow="True"
                       Padding="0"
                       HorizontalOptions="Fill">
                    <Entry x:Name="PinEntry"
                           Placeholder="Ingrese su PIN" 
                           PlaceholderColor="#999999" 
                           BackgroundColor="Transparent" 
                           FontSize="16"
                           Keyboard="Numeric"
                           TextColor="#333333"
                           IsPassword="True"  
                           Text="{Binding OperatorPin}"
                           IsEnabled="{Binding IsPinEnabled}"
                           VerticalOptions="Center"
                           Margin="12,0"/>
                </Frame>
                
                <Button x:Name="ConfirmButton"
                        Text="Confirmar" 
                        BackgroundColor="#A0A0A0" 
                        TextColor="#FAFAFA" 
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8" 
                        HorizontalOptions="Center" 
                        WidthRequest="320"
                        HeightRequest="45"
                        Margin="0,15,0,10" 
                        Command="{Binding AssignedOperatorCommand}"
                        IsEnabled="{Binding IsConfirmEnabled}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsConfirmEnabled}" Value="True">
                            <Setter Property="BackgroundColor" Value="#4A744C" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsConfirmEnabled}" Value="False">
                            <Setter Property="BackgroundColor" Value="#A0A0A0" />
                            <Setter Property="TextColor" Value="#FAFAFA" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>
