<?xml version="1.0" encoding="utf-8" ?>
<pages:BaseContentPage
    x:Class="Rincon.Pages.OperatorsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extensions="clr-namespace:Rincon.Extensions"
    xmlns:pages="clr-namespace:Rincon.Common.Pages;assembly=Rincon.Common"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:OperatorsViewModel"
    xmlns:local="clr-namespace:Rincon.Converters"
    xmlns:models="clr-namespace:Rincon.Models;assembly=Rincon.Models"
    xmlns:popups="clr-namespace:Rincon.CustomPopups"
    xmlns:pagespop="clr-namespace:Rincon.Pages"
    x:TypeArguments="viewModels:OperatorsViewModel"
    Shell.NavBarIsVisible="False"
    Shell.NavBarHasShadow="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>


    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*,*">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Offset="0.1" Color="#AD6B2A" />
                <GradientStop Offset="1.0" Color="#D3AA84" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Overlay para ActivityIndicator -->
        <Grid Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" 
              BackgroundColor="#80000000" 
              ZIndex="2000">
            <ActivityIndicator
                VerticalOptions="Center"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                Color="#4A744C"
                Scale="1.5"/>
        </Grid>

        <!-- Popups superpuestos SIEMPRE arriba -->
        <!-- ocupar 50% -->
        <pagespop:TaskDetailPage IsVisible="{Binding IsTaskDetailPopupVisible}" ZIndex="1000" Grid.RowSpan="2" Grid.ColumnSpan="2"/> 
        <popups:AssignOperatorPopup IsVisible="{Binding IsAssignOperatorPopupVisible}" ZIndex="1001" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <pagespop:FinishTaskPopup IsVisible="{Binding IsFinishTaskPopupVisible}" ZIndex="1002" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <popups:FinishTaskAuthPopup IsVisible="{Binding IsFinishTaskAuthPopupVisible}" ZIndex="1003" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

        <ImageButton Grid.Column="1" 
                    Source="home_operators"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Command="{Binding LoginCommand}"
                    Margin="0,20,30,0"
                    WidthRequest="40"
                    HeightRequest="40" />
        <Image Source="rincon_white" 
                        HorizontalOptions="Start"
                        Margin="30,20,0,0"
                        WidthRequest="200"
                        HeightRequest="60"/>
        <!-- Contenido principal debajo de los popups -->
        <Frame Grid.ColumnSpan="2" 
               Grid.Row="1" 
               Margin="25,15,25,25" 
               Padding="25" 
               BackgroundColor="White" 
               BorderColor="#79280F" 
               CornerRadius="12" 
               HasShadow="True" 
               ZIndex="1"
               IsVisible="{Binding IsAnyPopupVisible, Converter={StaticResource InvertedBoolConverter}}">
            <Grid RowDefinitions="auto,auto,*" RowSpacing="20">
                <!-- Header mejorado -->
                <Grid Grid.Row="0" ColumnDefinitions="*,auto" RowDefinitions="*" ColumnSpacing="15">
                    <Label Grid.Column="0" 
                           Text="📋 Gestión de Tareas" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           TextColor="#79280F" 
                           VerticalOptions="Center" />
                    <Frame Grid.Column="1"
                           Padding="8"
                           BackgroundColor="#F0F8FF"
                           BorderColor="#79280F"
                           CornerRadius="20"
                           HasShadow="False">
                        <ImageButton Source="refresh.png"
                                     BackgroundColor="Transparent"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     WidthRequest="40"
                                     HeightRequest="40"
                                     Command="{Binding ReloadTasksCommand}" />
                    </Frame>
                </Grid>
                
                <!-- Separador -->
                <BoxView Grid.Row="1" 
                         HeightRequest="2" 
                         Color="#79280F" 
                         HorizontalOptions="Fill" />
                
                <!-- Contenido principal -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="25" RowDefinitions="auto,*" RowSpacing="15">
                    
                    <!-- Headers de las columnas -->
                    <Frame Grid.Row="0" 
                           Grid.Column="0"
                           BackgroundColor="#F8F8F8" 
                           BorderColor="#79280F"
                           CornerRadius="8" 
                           Padding="12,8"
                           HasShadow="False">
                        <Label Text="📌 Tareas Pendientes" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Center"/>
                    </Frame>
                    
                    <Frame Grid.Row="0" 
                           Grid.Column="1"
                           BackgroundColor="#F8F8F8" 
                           BorderColor="#79280F"
                           CornerRadius="8" 
                           Padding="12,8"
                           HasShadow="False">
                        <Label Text="✅ Tareas Asignadas" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Center"/>
                    </Frame>

                    <!-- Lista de tareas pendientes -->
                    <ScrollView Grid.Row="1" 
                                Grid.Column="0" 
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Always"
                                HorizontalScrollBarVisibility="Never"
                                Padding="5">
                        <CollectionView x:Name="TaskPendingList" 
                                        ItemsSource="{Binding PendingTasks}" 
                                        SelectionMode="Single" 
                                        SelectionChanged="TaskPendingSelectionChanged" 
                                        SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                        VerticalOptions="Start"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <Grid Padding="5,10,5,10">
                                        <Frame BackgroundColor="White" 
                                               BorderColor="#79280F"
                                               CornerRadius="10" 
                                               Padding="15" 
                                               HasShadow="True"
                                               Margin="0">
                                            <Grid ColumnDefinitions="*,auto" 
                                                  RowDefinitions="auto,auto,auto"
                                                  RowSpacing="8"
                                                  ColumnSpacing="10">
                                            
                                            <!-- ID de tarea -->
                                            <Frame Grid.Row="0"
                                                   Grid.ColumnSpan="2"
                                                   BackgroundColor="#79280F"
                                                   CornerRadius="6"
                                                   Padding="8,4"
                                                   HasShadow="False"
                                                   HorizontalOptions="Start">
                                                <Label Text="{Binding Id, StringFormat='Tarea #{0:D5}'}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Frame>
                                            
                                            <!-- Material origen -->
                                            <Label Grid.Row="1" 
                                                   Grid.Column="0"
                                                   FontSize="13" 
                                                   TextColor="#333333"
                                                   LineBreakMode="WordWrap">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="📦 Material: " FontAttributes="Bold" TextColor="#79280F" />
                                                        <Span Text="{Binding ProductSource}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            
                                            <!-- Producto destino -->
                                            <Label Grid.Row="2" 
                                                   Grid.Column="0"
                                                   FontSize="13" 
                                                   TextColor="#333333"
                                                   LineBreakMode="WordWrap">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="🔨 Producir: " FontAttributes="Bold" TextColor="#79280F" />
                                                        <Span Text="{Binding ProductDestination}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            
                                            <!-- Estado y prioridad -->
                                            <StackLayout Grid.Row="1"
                                                         Grid.RowSpan="2"
                                                         Grid.Column="1" 
                                                         Spacing="6"
                                                         HorizontalOptions="Center" 
                                                         VerticalOptions="Center">
                                                <Frame BackgroundColor="White"
                                                       BorderColor="#FF9800"
                                                       CornerRadius="20"
                                                       Padding="10"
                                                       HasShadow="True"
                                                       WidthRequest="48"
                                                       HeightRequest="48">
                                                    <Image Source="user_task.png" 
                                                           WidthRequest="28" 
                                                           HeightRequest="28"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Frame>
                                                <Label IsVisible="{Binding Priority}" 
                                                       HorizontalTextAlignment="Center" 
                                                       Text="⚡ Prioridad" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#FF5722" />
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout Spacing="10" Padding="20" VerticalOptions="Center">
                                    <Label Text="📋"
                                           FontSize="32"
                                           TextColor="#CCCCCC"
                                           HorizontalOptions="Center" />
                                    <Label FontSize="14"
                                           HorizontalOptions="Center"
                                           Text="No hay tareas pendientes"
                                           TextColor="#666666" />
                                    <Label FontSize="12"
                                           HorizontalOptions="Center"
                                           Text="Las nuevas tareas aparecerán aquí"
                                           TextColor="#999999" />
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </ScrollView>

                    <!-- Lista de tareas asignadas -->
                    <ScrollView Grid.Row="1" 
                                Grid.Column="1" 
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Always"
                                HorizontalScrollBarVisibility="Never"
                                Padding="5">
                        <CollectionView x:Name="TaskAssignedList" 
                                        ItemsSource="{Binding AssignedTasks}" 
                                        SelectionMode="Single" 
                                        SelectionChanged="TaskAssignedSelectionChanged" 
                                        SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                        VerticalOptions="Start"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <Grid Padding="5,10,5,10">
                                        <Frame BackgroundColor="White" 
                                               BorderColor="#4CAF50"
                                               CornerRadius="10" 
                                               Padding="15" 
                                               HasShadow="True"
                                               Margin="0">
                                            <Grid ColumnDefinitions="*,auto" 
                                                  RowDefinitions="auto,auto,auto"
                                                  RowSpacing="8"
                                                  ColumnSpacing="10">
                                            
                                            <!-- ID de tarea -->
                                            <Frame Grid.Row="0"
                                                   Grid.ColumnSpan="2"
                                                   BackgroundColor="#4CAF50"
                                                   CornerRadius="6"
                                                   Padding="8,4"
                                                   HasShadow="False"
                                                   HorizontalOptions="Start">
                                                <Label Text="{Binding Id, StringFormat='Tarea #{0:D5}'}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Frame>
                                            
                                            <!-- Material origen -->
                                            <Label Grid.Row="1" 
                                                   Grid.Column="0"
                                                   FontSize="13" 
                                                   TextColor="#333333"
                                                   LineBreakMode="WordWrap">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="📦 Material: " FontAttributes="Bold" TextColor="#4CAF50" />
                                                        <Span Text="{Binding ProductSource}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            
                                            <!-- Producto destino -->
                                            <Label Grid.Row="2" 
                                                   Grid.Column="0"
                                                   FontSize="13" 
                                                   TextColor="#333333"
                                                   LineBreakMode="WordWrap">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="🔨 Producir: " FontAttributes="Bold" TextColor="#4CAF50" />
                                                        <Span Text="{Binding ProductDestination}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            
                                            <!-- Operario asignado -->
                                            <StackLayout Grid.Row="1"
                                                         Grid.RowSpan="2"
                                                         Grid.Column="1" 
                                                         Spacing="6"
                                                         HorizontalOptions="Center" 
                                                         VerticalOptions="Center">
                                                <Frame BackgroundColor="White"
                                                       BorderColor="#4CAF50"
                                                       CornerRadius="20"
                                                       Padding="10"
                                                       HasShadow="True"
                                                       WidthRequest="48"
                                                       HeightRequest="48">
                                                    <Image Source="double_check.png" 
                                                           WidthRequest="28" 
                                                           HeightRequest="28"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Frame>
                                                <Label HorizontalTextAlignment="Center" 
                                                       Text="{Binding OperatorName}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold"
                                                       TextColor="#4CAF50"
                                                       MaxLines="2"
                                                       LineBreakMode="WordWrap" />
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout Spacing="10" Padding="20" VerticalOptions="Center">
                                    <Label Text="✅"
                                           FontSize="32"
                                           TextColor="#CCCCCC"
                                           HorizontalOptions="Center" />
                                    <Label FontSize="14"
                                           HorizontalOptions="Center"
                                           Text="No hay tareas asignadas"
                                           TextColor="#666666" />
                                    <Label FontSize="12"
                                           HorizontalOptions="Center"
                                           Text="Las tareas asignadas aparecerán aquí"
                                           TextColor="#999999" />
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </ScrollView>
                </Grid>
            </Grid>
        </Frame>
    </Grid>
</pages:BaseContentPage>