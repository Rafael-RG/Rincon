<?xml version="1.0" encoding="utf-8" ?>
<pages:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Rincon.Converters"
    x:Class="Rincon.Pages.RecoverPasswordPage"
    xmlns:pages="clr-namespace:Rincon.Common.Pages;assembly=Rincon.Common"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:RecoverPasswordViewModel"
    x:TypeArguments="viewModels:RecoverPasswordViewModel"
    Shell.NavBarIsVisible="false">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0" Padding="0">
        <StackLayout.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Offset="0.1" Color="#AD6B2A" />
                <GradientStop Offset="1.0" Color="#D3AA84" />
            </LinearGradientBrush>
        </StackLayout.Background>

        <StackLayout Margin="0,0,0,0" HeightRequest="32" HorizontalOptions="Center">
            <ActivityIndicator
                HeightRequest="32"
                IsRunning="True"
                Color="#4A744C"
                IsVisible="{Binding IsBusy}"
                WidthRequest="32" />
        </StackLayout>

        <Image Source="rincon_white.png" HeightRequest="50" WidthRequest="220" HorizontalOptions="Start" Margin="20,0,0,40" />

        <Frame CornerRadius="18" BackgroundColor="#D3AA84" 
               Margin="20,5,20,10" 
               HorizontalOptions="Center"
               VerticalOptions="Fill"
               WidthRequest="{OnPlatform Default=700, WinUI=800, MacCatalyst=900}"
               MaximumWidthRequest="1000"
               MinimumWidthRequest="600">
            <StackLayout VerticalOptions="Fill" HorizontalOptions="Fill" Spacing="0">
            <Label Text="Recupera tu contraseña" TextColor="Black" FontSize="22" FontAttributes="Bold" 
                   Margin="20,15,20,25" HorizontalOptions="Center"/>
            
            <Grid IsVisible="{Binding IsVisibleFirstForm}" 
                  RowDefinitions="auto,auto,auto" 
                  ColumnDefinitions="1*,1*" 
                  HorizontalOptions="Fill" 
                  VerticalOptions="Fill" 
                  Margin="20,5,20,15"
                  RowSpacing="12"
                  ColumnSpacing="20">

                <!-- Primera fila: Usuario y Pregunta -->
                <Frame CornerRadius="18" HeightRequest="40" BackgroundColor="White" 
                       Margin="0" Padding="0,0,0,0" HorizontalOptions="Fill">
                    <Entry
                        BackgroundColor="Transparent"
                        HeightRequest="40"
                        FontSize="14"
                        PlaceholderColor="Black"
                        HorizontalOptions="Fill"
                        MaxLength="25"
                        Placeholder="Usuario"
                        Text="{Binding Username}" />
                </Frame>
                    
                <Frame Grid.Column="1" BackgroundColor="White" HeightRequest="40" 
                       CornerRadius="18" Margin="0" Padding="10,-3,10,-3"
                       HorizontalOptions="Fill">
                    <Label Text="{Binding SeletedQuestion, Mode=TwoWay}" VerticalOptions="Center" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectQuestionCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>
                <!-- Segunda fila: Lista de preguntas (span completo) -->
                <Frame x:Name="FrameListQuestions" 
                       Grid.Row="1" Grid.ColumnSpan="2"
                       CornerRadius="18" 
                       IsVisible="{Binding IsVisibleListQuestions}" 
                       VerticalOptions="Start" 
                       HeightRequest="100"
                       HorizontalOptions="Fill">
                    <Frame.Background> 
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Offset="0.1" Color="#FFFFFF" />
                            <GradientStop Offset="1.0" Color="#FFF6ED" />
                        </LinearGradientBrush>
                    </Frame.Background>
                    <CollectionView HeightRequest="100" x:Name="Questions" 
                                    SelectionChanged="Questions_SelectionChanged" 
                                    ItemsSource="{Binding Questions}" 
                                    SelectionMode="Single" 
                                    HorizontalOptions="Fill" 
                                    VerticalOptions="Start">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="6"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label FontSize="14" Text="{Binding .}" TextColor="#000000" VerticalOptions="Start" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <!-- Campo de respuesta cuando no hay lista visible -->
                <Frame IsVisible="{Binding IsVisibleListQuestions, Converter={StaticResource InvertedBoolConverter}}" 
                       Grid.Row="1" Grid.ColumnSpan="2"
                       HeightRequest="40" CornerRadius="18" BackgroundColor="White" 
                       Margin="0" Padding="0,0,0,0" HorizontalOptions="Fill">
                    <Entry
                        FontSize="14"
                        BackgroundColor="Transparent"
                        HeightRequest="40"
                        PlaceholderColor="Black"
                        HorizontalOptions="Fill"
                        MaxLength="25"
                        Placeholder="Tu respuesta"
                        Text="{Binding Answer}"/>
                </Frame>
                
                <!-- Tercera fila: Botones -->
                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                       HorizontalOptions="Center" 
                                       Spacing="20" 
                                       VerticalOptions="End"
                                       Margin="0,15,0,0">
                    <Button
                        BackgroundColor="#AD6B2A"
                        WidthRequest="140"
                        HeightRequest="45"
                        TextColor="#FFF6ED"
                        FontSize="16"
                        Command="{Binding BackToLoginCommand}"
                        Text="Cancelar" />
                    <Button
                        BackgroundColor="#4A744C"
                        HeightRequest="45"
                        FontSize="16"
                        WidthRequest="140"
                        TextColor="White"
                        Command="{Binding ConfirmRecoveryCommand}"
                        Text="Recuperar" />
                </HorizontalStackLayout>

            </Grid>
            <Grid Margin="20,5,20,15" IsVisible="{Binding IsVisibleNewPassword}" 
                  RowDefinitions="auto,auto,auto,auto" 
                  ColumnDefinitions="1*,1*" 
                  HorizontalOptions="Fill" 
                  VerticalOptions="Fill" 
                  RowSpacing="12"
                  ColumnSpacing="20">
                
                <!-- Primera fila: Mensaje de bienvenida (span completo) -->
                <Label Grid.ColumnSpan="2" FontSize="18" Margin="0,10,0,0" 
                       VerticalOptions="Start" FontAttributes="Bold"
                       HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Username}"/>
                            <Span Text=", cree su nueva contraseña"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Segunda fila: Nueva contraseña y Confirmar contraseña -->
                <Frame Grid.Row="1" CornerRadius="18" BackgroundColor="White" 
                       Margin="0" Padding="0,0,0,0" HeightRequest="40" HorizontalOptions="Fill">
                    <Entry
                        BackgroundColor="Transparent"
                        HeightRequest="40"
                        PlaceholderColor="Black"
                        HorizontalOptions="Fill"
                        MaxLength="25"
                        Placeholder="Nueva contraseña"
                        Text="{Binding Password}"
                        IsPassword="True" />
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" CornerRadius="18" BackgroundColor="White" 
                       Margin="0" Padding="0,0,0,0" HeightRequest="40" HorizontalOptions="Fill">
                    <Entry
                        BackgroundColor="Transparent"
                        HeightRequest="40"
                        PlaceholderColor="Black"
                        HorizontalOptions="Fill"
                        MaxLength="25"
                        Placeholder="Confirme su nueva contraseña"
                        Text="{Binding RepeatPassword}"
                        IsPassword="True" />
                </Frame>

                <!-- Tercera fila: Botones -->
                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                       HorizontalOptions="Center" 
                                       Spacing="20" 
                                       VerticalOptions="End"
                                       Margin="0,15,0,0">
                    <Button
                        BackgroundColor="#AD6B2A"
                        TextColor="#FFF6ED"
                        WidthRequest="140"
                        HeightRequest="45"
                        FontSize="16"
                        Command="{Binding BackFirstFormCommand}"
                        Text="Volver" />
                    <Button
                        BackgroundColor="#4A744C"
                        TextColor="White"
                        WidthRequest="140"
                        HeightRequest="45"
                        FontSize="16"
                        Command="{Binding RecoveryPasswordCommand}"
                        Text="Confirmar" />
                </HorizontalStackLayout>

            </Grid>
            <Grid Margin="20,5,20,15" IsVisible="{Binding IsVisibleOkRecovery}" 
                  RowDefinitions="auto,auto" 
                  ColumnDefinitions="*" 
                  HorizontalOptions="Fill" 
                  VerticalOptions="Fill" 
                  RowSpacing="20">
                
                <!-- Mensaje de éxito -->
                <Label FontSize="18" Margin="0,20,0,0" 
                       VerticalOptions="Start" FontAttributes="Bold"
                       HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Username}"/>
                            <Span Text=", el cambio de contraseña ha sido realizado con éxito."/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Botón para volver al inicio -->
                <HorizontalStackLayout Grid.Row="1"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="End"
                                       Margin="0,30,0,0">
                    <Button
                        BackgroundColor="#AD6B2A"
                        TextColor="#FFF6ED"
                        HeightRequest="45"
                        WidthRequest="160"
                        FontSize="16"
                        Command="{Binding BackToLoginCommand}"
                        Text="Ir al inicio" />
                </HorizontalStackLayout>

            </Grid>
            </StackLayout>
        </Frame>
    </StackLayout>
</pages:BaseContentPage>
