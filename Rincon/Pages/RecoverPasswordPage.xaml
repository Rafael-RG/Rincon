<?xml version="1.0" encoding="utf-8" ?>
<pages:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Rincon.Converters"
    x:Class="Rincon.Pages.RecoverPasswordPage"
    xmlns:pages="clr-namespace:Rincon.Common.Pages;assembly=Rincon.Common"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:RecoverPasswordViewModel"
    x:TypeArguments="viewModels:RecoverPasswordViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*" Padding="0">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Offset="0.1" Color="#AD6B2A" />
                <GradientStop Offset="1.0" Color="#D3AA84" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Overlay para ActivityIndicator -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsBusy}" 
              BackgroundColor="#80000000" 
              ZIndex="2000">
            <ActivityIndicator
                VerticalOptions="Center"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                Color="#4A744C"
                Scale="1.5"/>
        </Grid>

        <!-- Logo -->
        <Image Grid.Row="0"
               Source="rincon_white.png" 
               HeightRequest="60" 
               WidthRequest="240" 
               HorizontalOptions="Start" 
               Margin="30,20,0,20" />

        <!-- Título principal -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               BorderColor="#79280F"
               CornerRadius="12"
               Margin="30,0,30,15"
               Padding="20,15"
               HasShadow="True">
            <Label Text="🔐 Recupera tu contraseña" 
                   TextColor="#79280F" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"/>
        </Frame>

        <!-- Contenido principal -->
        <Frame Grid.Row="2"
               CornerRadius="12" 
               BackgroundColor="White" 
               BorderColor="#79280F"
               Margin="30,0,30,30" 
               Padding="25"
               HasShadow="True"
               VerticalOptions="Fill">
            <ScrollView VerticalOptions="Fill">
                <StackLayout Spacing="0">
                    <!-- Primer formulario: Usuario y pregunta de seguridad -->
                    <Grid IsVisible="{Binding IsVisibleFirstForm}" 
                          RowDefinitions="auto,auto,auto,auto,auto" 
                          RowSpacing="20">

                        <Label Grid.Row="0"
                               Text="Datos de recuperación" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#79280F" 
                               HorizontalOptions="Center"
                               Margin="0,0,0,15"/>

                        <!-- Campo Usuario -->
                        <StackLayout Grid.Row="1" Spacing="8">
                            <Label Text="Usuario:" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="#79280F"/>
                            <Frame CornerRadius="8" 
                                   BackgroundColor="White" 
                                   BorderColor="#79280F"
                                   HeightRequest="50"
                                   HasShadow="True"
                                   Padding="0">
                                <Entry BackgroundColor="Transparent"
                                       FontSize="16"
                                       PlaceholderColor="#999999"
                                       TextColor="#333333"
                                       Placeholder="Ingrese su usuario"
                                       Text="{Binding Username}"
                                       MaxLength="25"
                                       Margin="15,0" />
                            </Frame>
                        </StackLayout>

                        <!-- Pregunta de seguridad -->
                        <StackLayout Grid.Row="2" Spacing="8">
                            <Label Text="Pregunta de seguridad:" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="#79280F"/>
                            <Frame CornerRadius="8" 
                                   BackgroundColor="White" 
                                   BorderColor="#79280F"
                                   HeightRequest="50"
                                   HasShadow="True"
                                   Padding="15,0">
                                <Label Text="{Binding SeletedQuestion, Mode=TwoWay}" 
                                       VerticalOptions="Center" 
                                       FontSize="16"
                                       TextColor="#333333">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectQuestionCommand}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                        </StackLayout>

                        <!-- Lista de preguntas -->
                        <Frame Grid.Row="3"
                               x:Name="FrameListQuestions" 
                               CornerRadius="8" 
                               BackgroundColor="#F0F8FF"
                               BorderColor="#79280F"
                               IsVisible="{Binding IsVisibleListQuestions}" 
                               HasShadow="True"
                               Padding="10"
                               HeightRequest="120">
                            <ScrollView>
                                <CollectionView x:Name="Questions" 
                                                SelectionChanged="Questions_SelectionChanged" 
                                                ItemsSource="{Binding Questions}" 
                                                SelectionMode="Single">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Frame BackgroundColor="White"
                                                   BorderColor="#E0E0E0"
                                                   CornerRadius="6"
                                                   Padding="12,8"
                                                   HasShadow="False"
                                                   Margin="0,2">
                                                <Label FontSize="14" 
                                                       Text="{Binding .}" 
                                                       TextColor="#333333" />
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </ScrollView>
                        </Frame>

                        <!-- Campo de respuesta -->
                        <StackLayout Grid.Row="3" 
                                     Spacing="8"
                                     IsVisible="{Binding IsVisibleListQuestions, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="Su respuesta:" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="#79280F"/>
                            <Frame CornerRadius="8" 
                                   BackgroundColor="White" 
                                   BorderColor="#79280F"
                                   HeightRequest="50"
                                   HasShadow="True"
                                   Padding="0">
                                <Entry BackgroundColor="Transparent"
                                       FontSize="16"
                                       PlaceholderColor="#999999"
                                       TextColor="#333333"
                                       Placeholder="Ingrese su respuesta"
                                       Text="{Binding Answer}"
                                       MaxLength="25"
                                       Margin="15,0"/>
                            </Frame>
                        </StackLayout>
                        
                        <!-- Botones del primer formulario -->
                        <Grid Grid.Row="4" 
                              ColumnDefinitions="*,*" 
                              ColumnSpacing="20"
                              Margin="0,25,0,0">
                            <Button Grid.Column="0"
                                    BackgroundColor="#DC3545"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    CornerRadius="8"
                                    Command="{Binding BackToLoginCommand}"
                                    Text="Cancelar" />
                            <Button Grid.Column="1"
                                    BackgroundColor="#4A744C"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    CornerRadius="8"
                                    Command="{Binding ConfirmRecoveryCommand}"
                                    Text="Recuperar" />
                        </Grid>
                    </Grid>
                    <!-- Segundo formulario: Nueva contraseña -->
                    <Grid IsVisible="{Binding IsVisibleNewPassword}" 
                          RowDefinitions="auto,auto,auto,auto" 
                          RowSpacing="20">

                        <Label Grid.Row="0"
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#79280F"
                               HorizontalOptions="Center"
                               Margin="0,0,0,15">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Hola "/>
                                    <Span Text="{Binding Username}"/>
                                    <Span Text=", cree su nueva contraseña"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Nueva contraseña -->
                        <StackLayout Grid.Row="1" Spacing="8">
                            <Label Text="Nueva contraseña:" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="#79280F"/>
                            <Frame CornerRadius="8" 
                                   BackgroundColor="White" 
                                   BorderColor="#79280F"
                                   HeightRequest="50"
                                   HasShadow="True"
                                   Padding="0">
                                <Entry BackgroundColor="Transparent"
                                       FontSize="16"
                                       PlaceholderColor="#999999"
                                       TextColor="#333333"
                                       Placeholder="Ingrese su nueva contraseña"
                                       Text="{Binding Password}"
                                       IsPassword="True"
                                       MaxLength="25"
                                       Margin="15,0" />
                            </Frame>
                        </StackLayout>

                        <!-- Confirmar contraseña -->
                        <StackLayout Grid.Row="2" Spacing="8">
                            <Label Text="Confirmar contraseña:" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="#79280F"/>
                            <Frame CornerRadius="8" 
                                   BackgroundColor="White" 
                                   BorderColor="#79280F"
                                   HeightRequest="50"
                                   HasShadow="True"
                                   Padding="0">
                                <Entry BackgroundColor="Transparent"
                                       FontSize="16"
                                       PlaceholderColor="#999999"
                                       TextColor="#333333"
                                       Placeholder="Confirme su nueva contraseña"
                                       Text="{Binding RepeatPassword}"
                                       IsPassword="True"
                                       MaxLength="25"
                                       Margin="15,0"/>
                            </Frame>
                        </StackLayout>

                        <!-- Botones del segundo formulario -->
                        <Grid Grid.Row="3" 
                              ColumnDefinitions="*,*" 
                              ColumnSpacing="20"
                              Margin="0,25,0,0">
                            <Button Grid.Column="0"
                                    BackgroundColor="#6C757D"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    CornerRadius="8"
                                    Command="{Binding BackFirstFormCommand}"
                                    Text="Volver" />
                            <Button Grid.Column="1"
                                    BackgroundColor="#4A744C"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    CornerRadius="8"
                                    Command="{Binding RecoveryPasswordCommand}"
                                    Text="Confirmar" />
                        </Grid>
                    </Grid>

                    <!-- Tercer formulario: Confirmación exitosa -->
                    <Grid IsVisible="{Binding IsVisibleOkRecovery}" 
                          RowDefinitions="auto,auto,auto" 
                          RowSpacing="25">
                        
                        <!-- Ícono de éxito -->
                        <Frame Grid.Row="0"
                               BackgroundColor="#E8F5E8"
                               BorderColor="#4CAF50"
                               CornerRadius="50"
                               WidthRequest="100"
                               HeightRequest="100"
                               HorizontalOptions="Center"
                               HasShadow="True"
                               Padding="0">
                            <Label Text="✅" 
                                   FontSize="48" 
                                   TextColor="#4CAF50"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Mensaje de éxito -->
                        <Label Grid.Row="1"
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#79280F"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               Margin="20,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="🎉 "/>
                                    <Span Text="{Binding Username}"/>
                                    <Span Text=", el cambio de contraseña ha sido realizado con éxito."/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Botón para volver al inicio -->
                        <Button Grid.Row="2"
                                BackgroundColor="#4A744C"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                HeightRequest="55"
                                CornerRadius="8"
                                HorizontalOptions="Center"
                                WidthRequest="200"
                                Command="{Binding BackToLoginCommand}"
                                Text="🏠 Ir al inicio"
                                Margin="0,15,0,0" />
                    </Grid>
                </StackLayout>
            </ScrollView>
        </Frame>
    </Grid>
</pages:BaseContentPage>
