                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Movement">
                            <Grid
                                ColumnDefinitions="25*,25*,25*,25*"
                                RowDefinitions="*"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Date}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding ProductName}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="{Binding MovementType}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="18"
                                    Text="{Binding Quantity}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <BoxView
                    Grid.Row="5"
                    Margin="0,0,0,40"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />


            </Grid>

