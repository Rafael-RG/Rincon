                                FontSize="18"
                                HeightRequest="75"
                                TextColor="#79280F"
                                HorizontalOptions="Start"
                                Text="Comentarios"
                                VerticalOptions="Center" />

                            
                                <Label
                                    Margin="40,0,0,0"
                                    FontSize="18"
                                    HeightRequest="75"
                                    HorizontalOptions="FillAndExpand"
                                    Text="{Binding CommentsTask}"
                                    TextColor="Black"
                                    VerticalOptions="FillAndExpand" />
                        </HorizontalStackLayout>
                    </Grid>
               
                <BoxView
                    Grid.Row="6"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
