                        Text="{Binding ProductTask.Product.WoodState}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="{Binding ProductTask.Available}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="black">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ProductTask.Reserved}" />
                                <Span Text="/" />
                                <Span Text="{Binding ProductTask.Process}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="{Binding ProductTask.Quantity}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                </Grid>

                <Grid Grid.Row="5"
                    Margin="30,100,0,0" RowDefinitions="auto,auto,auto, auto" RowSpacing="45">
