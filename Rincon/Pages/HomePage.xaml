                                TextColor="#79280F" />
                            <Label
                                Grid.Column="1"
                                FontSize="18"
                                Text="Descripcion"
                                TextColor="#79280F" />
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Text="Cantidad"
                                TextColor="#79280F" />
                        </Grid>
