                                    TextColor="#79280F"
                                    HorizontalOptions="Center" />
                                
                                <!-- Mensaje informativo -->
                                <StackLayout Grid.Row="1" Spacing="20">
                                    <Frame
                                        BackgroundColor="#F0F8FF"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        Padding="15"
                                        HasShadow="False">
                                        <Label
                                            FontSize="14"
                                            Text="Por favor confirme su identidad para guardar los cambios del operario en el sistema."
                                            TextColor="#666666"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="WordWrap" />
                                    </Frame>
                                    
                                    <!-- Campos de verificación -->
                                    <Grid RowDefinitions="auto,auto" RowSpacing="20">
                                        <!-- Usuario -->
                                        <StackLayout Grid.Row="0" Spacing="8">
                                            <Label
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                Text="Nombre de Usuario"
                                                TextColor="#79280F" />
                                            <Frame
                                                Padding="0"
                                                BackgroundColor="White"
                                                BorderColor="#79280F"
                                                CornerRadius="8"
                                                HeightRequest="50"
                                                HasShadow="True">
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="16"
                                                    MaxLength="25"
                                                    Placeholder="Ingrese su nombre de usuario"
                                                    PlaceholderColor="#999999"
                                                    Text="{Binding ConfirmUserConfigurations}"
                                                    TextColor="#333333"
                                                    VerticalOptions="Center"
                                                    Margin="15,0"
                                                    IsSpellCheckEnabled="False"
                                                    IsTextPredictionEnabled="False" />
                                            </Frame>
                                        </StackLayout>
                                        
                                        <!-- Contraseña -->
                                        <StackLayout Grid.Row="1" Spacing="8">
                                            <Label
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                Text="Contraseña Actual"
                                                TextColor="#79280F" />
                                            <Frame
                                                Padding="0"
                                                BackgroundColor="White"
                                                BorderColor="#79280F"
                                                CornerRadius="8"
                                                HeightRequest="50"
                                                HasShadow="True">
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    FontSize="16"
                                                    MaxLength="25"
                                                    Placeholder="Ingrese su contraseña"
                                                    PlaceholderColor="#999999"
                                                    Text="{Binding ConfirmPasswordConfigurations}"
                                                    TextColor="#333333"
                                                    VerticalOptions="Center"
                                                    Margin="15,0"
                                                    IsPassword="True"
                                                    IsSpellCheckEnabled="False"
                                                    IsTextPredictionEnabled="False" />
                                            </Frame>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                                
                                <!-- Botones de verificación -->
                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="20"
                                    HorizontalOptions="Center"
                                    MaximumWidthRequest="400">
                                    <Button
                                        Grid.Column="0"
                                        BackgroundColor="#FFF6ED"
                                        BorderColor="#79280F"
                                        BorderWidth="2"
                                        Command="{Binding CancelDeleteOperatorCommand}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HeightRequest="50"
                                        Text="Cancelar"
                                        TextColor="#79280F"
                                        CornerRadius="8" />
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="#4A744C"
                                        Clicked="OkEditOperator_Clicked"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HeightRequest="50"
                                        Text="Confirmar Cambios"
                                        TextColor="White"
                                        CornerRadius="8" />
                                </Grid>
                            </Grid>
                        </Frame>
                    </Grid>
                </StackLayout>

            </Grid>
        </Grid>

    </Grid>


</pages:BaseContentPage>