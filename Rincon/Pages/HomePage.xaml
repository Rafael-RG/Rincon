<?xml version="1.0" encoding="utf-8" ?>
<pages:BaseContentPage
    x:Class="Rincon.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:customControls="clr-namespace:Rincon.CustomControls"
    xmlns:extensions="clr-namespace:Rincon.Extensions"
    xmlns:local="clr-namespace:Rincon.Converters"
    xmlns:models="clr-namespace:Rincon.Models;assembly=Rincon.Models"
    xmlns:pages="clr-namespace:Rincon.Common.Pages;assembly=Rincon.Common"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:HomeViewModel"
    x:TypeArguments="viewModels:HomeViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:ActiveToColorConverter x:Key="ActiveToColorConverter" />
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <local:BoolToTextConverter x:Key="BoolToTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid
        Margin="0,0,0,0"
        Padding="0,0,0,0"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        RowDefinitions="Auto,*">

        <Grid.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Offset="0.1" Color="#AD6B2A" />
                <GradientStop Offset="1.0" Color="#D3AA84" />
            </LinearGradientBrush>
        </Grid.Background>
        <ActivityIndicator
            Grid.Row="0"
            HeightRequest="32"
            HorizontalOptions="Center"
            IsRunning="True"
            Color="#4A744C"
            IsVisible="{Binding IsUserLogin, Converter={StaticResource InvertedBoolConverter}}"
            VerticalOptions="Center"
            WidthRequest="32" />

        <Grid
            Grid.Row="1"
            BackgroundColor="#AD6B2A"
            ColumnDefinitions="*,*,*,*,2*"
            ColumnSpacing="0"
            IsVisible="{Binding IsUserLogin}"
            RowDefinitions="80,80,*"
            RowSpacing="0"
            VerticalOptions="Fill">

            <!--#region botónes principales-->
            <ImageButton
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Margin="30,20,30,10"
                BackgroundColor="#AD6B2A"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="Home"
                HeightRequest="50"
                HorizontalOptions="Start"
                Source="rincon_home.png"
                MaximumWidthRequest="200"
                WidthRequest="200" />
            <Button
                Grid.Row="1"
                Grid.Column="0"
                Margin="20,8,20,8"
                BackgroundColor="{Binding IsMagementStockView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="MagementStock"
                CornerRadius="16"
                FontSize="16"
                MinimumHeightRequest="60"
                HeightRequest="60"
                HorizontalOptions="Fill"
                Text="Gestión de stock"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="12,8,12,8">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                Margin="20,8,20,8"
                BackgroundColor="{Binding IsTasksView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="Tasks"
                CornerRadius="16"
                FontSize="16"
                MinimumHeightRequest="60"
                HeightRequest="60"
                HorizontalOptions="Fill"
                Text="Tareas"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="12,8,12,8">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Margin="20,8,20,8"
                BackgroundColor="{Binding IsOrdersView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="Orders"
                CornerRadius="16"
                FontSize="16"
                MinimumHeightRequest="60"
                HeightRequest="60"
                HorizontalOptions="Fill"
                Text="Pedidos"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="12,8,12,8">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="3"
                Margin="20,8,20,8"
                BackgroundColor="{Binding IsHistoryView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="History"
                CornerRadius="16"
                FontSize="16"
                MinimumHeightRequest="60"
                HeightRequest="60"
                HorizontalOptions="Fill"
                Text="Historial"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="12,8,12,8">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="4"
                Margin="20,8,20,8"
                BackgroundColor="{Binding IsAddProductView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="AddProduct"
                CornerRadius="16"
                FontSize="16"
                MinimumHeightRequest="60"
                HeightRequest="60"
                HorizontalOptions="Fill"
                Text="Añadir producto"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="12,8,12,8">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <!--Menu usuario-->
            <Frame
                Grid.Row="0"
                Grid.Column="4"
                Margin="0,20,20,0"
                Padding="15,8"
                BackgroundColor="White"
                BorderColor="#79280F"
                CornerRadius="25"
                HasShadow="True"
                HorizontalOptions="End"
                VerticalOptions="Start"
                MaximumWidthRequest="280">
                <Grid ColumnDefinitions="*,auto" ColumnSpacing="12" HorizontalOptions="Fill">
                    <!-- Información del usuario -->
                    <StackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label
                            FontSize="16"
                            FontAttributes="Bold"
                            Text="{Binding User.Name}"
                            TextColor="#79280F"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            LineBreakMode="TailTruncation" />
                        <Label
                            FontSize="12"
                            Text="Usuario activo"
                            TextColor="#666666"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" />
                    </StackLayout>
                    
                    <!-- Botón de menú con avatar -->
                    <Frame Grid.Column="1"
                           Padding="0"
                           BackgroundColor="#79280F"
                           CornerRadius="20"
                           HeightRequest="40"
                           WidthRequest="40"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <ImageButton
                            BackgroundColor="Transparent"
                            Clicked="Menu_Clicked"
                            HeightRequest="30"
                            WidthRequest="30"
                            Source="account.png"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Frame>
                </Grid>
                
                <!-- Gesture recognizer para toda el área -->
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Menu_Clicked" />
                </Frame.GestureRecognizers>
            </Frame>


            <!--  Barra lateral  -->
            <Grid
                Grid.Row="2"
                Grid.Column="4"
                Padding="0,0,0,0"
                BackgroundColor="#D3AA84"
                ColumnDefinitions="*"
                RowDefinitions="auto,auto,*">
                <ActivityIndicator
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    HeightRequest="50"
                    WidthRequest="50"
                    Color="#4A744C"
                    IsRunning="True"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent" />
                <!-- Header con botón de refresh -->
                <Frame Grid.Row="0" 
                       Margin="8,10,8,5" 
                       Padding="12,8"
                       BackgroundColor="White"
                       BorderColor="#79280F"
                       CornerRadius="8"
                       HasShadow="True"
                       IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="*,auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="Stock"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#79280F"
                               VerticalOptions="Center"
                               HorizontalOptions="Start" />
                        <ImageButton Grid.Column="1"
                                     BackgroundColor="Transparent"
                                     Command="{Binding RefreshStockCommand}"
                                     HeightRequest="28"
                                     WidthRequest="28"
                                     HorizontalOptions="End"
                                     VerticalOptions="Center"
                                     Source="refresh.png"
                                     Opacity="0.7" />
                    </Grid>
                </Frame>
                <Frame
                    Grid.Row="1"
                    Margin="10,5,10,15"
                    Padding="0"
                    BackgroundColor="White"
                    BorderColor="#79280F"
                    CornerRadius="8"
                    HeightRequest="50"
                    HasShadow="True"
                    IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                    <SearchBar
                        x:Name="SearchBarLateralBar"
                        BackgroundColor="Transparent"
                        CancelButtonColor="#79280F"
                        HeightRequest="32"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        Placeholder="Buscar en stock"
                        PlaceholderColor="#999999"
                        TextChanged="SearchBarLateralBar_TextChanged"
                        TextColor="#333333"
                        FontSize="13" />
                </Frame>
            <!-- Stock List Home-->
                <CollectionView
                    x:Name="LateraBarStock"
                    Grid.Row="2"
                    Margin="5,5,5,5"
                    ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=Cards}"
                    SelectionChanged="LateraBarStock_SelectionChanged"
                    SelectionMode="Single"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never"
                    IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CardStock">
                            <Frame
                                BackgroundColor="White"
                                BorderColor="#79280F"
                                CornerRadius="12"
                                HeightRequest="160"
                                HasShadow="True"
                                VerticalOptions="FillAndExpand"
                                HorizontalOptions="FillAndExpand"
                                Margin="2,4,2,4">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Frame_Tapped" />
                                </Frame.GestureRecognizers>
                                <Grid
                                    Padding="12"
                                    ColumnSpacing="10"
                                    HorizontalOptions="FillAndExpand"
                                    RowSpacing="6"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Margin="0"
                                        HorizontalOptions="Center"
                                        Spacing="8"
                                        VerticalOptions="Center">
                                        <Frame
                                            BackgroundColor="#79280F"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            WidthRequest="100"
                                            HasShadow="False"
                                            HorizontalOptions="Center">
                                            <Label
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                Text="{Binding Id}"
                                                TextColor="White"
                                                HorizontalOptions="Center" />
                                        </Frame>

                                        <Image
                                            HeightRequest="50"
                                            HorizontalOptions="Center"
                                            Source="{Binding Icon}"
                                            WidthRequest="50" />
                                    </StackLayout>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,4,4,0"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        MaxLines="2"
                                        HorizontalOptions="Start"
                                        TextColor="#303030"
                                        VerticalOptions="Start"
                                        LineBreakMode="WordWrap">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Description}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,8,4,4"
                                        HorizontalOptions="Center"
                                        Spacing="4"
                                        VerticalOptions="Center">

                                        <Label
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            Text="Disponible"
                                            TextColor="#666666" />
                                        <Frame
                                            BackgroundColor="#E8F5E8"
                                            BorderColor="#4CAF50"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            HasShadow="False"
                                            HorizontalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                HorizontalOptions="Center"
                                                Text="{Binding StockAvailable}"
                                                TextColor="#2E7D32" />
                                        </Frame>
                                    </StackLayout>

                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="4,8,0,4"
                                        HorizontalOptions="Center"
                                        Spacing="4"
                                        VerticalOptions="Center">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            Text="Reservado"
                                            TextColor="#666666" />
                                        <Frame
                                            BackgroundColor="#FFF3E0"
                                            BorderColor="#FF9800"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            HasShadow="False"
                                            HorizontalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                HorizontalOptions="Center"
                                                Text="{Binding StockReserved}"
                                                TextColor="#F57C00" />
                                        </Frame>
                                    </StackLayout>



                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <StackLayout Spacing="10">

                            <Label
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="No hay stock"
                                TextColor="#797979"
                                VerticalOptions="CenterAndExpand" />

                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <!--#endregion-->

            <!--  Home  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                IsVisible="{Binding IsHomeView}"
                RowDefinitions="*,*,*,*"
                RowSpacing="20">
                <Frame
                    Grid.Row="0"
                    Padding="10"
                    BackgroundColor="#EAEAEA"
                    BorderColor="Transparent">
                    <Grid
                        ColumnDefinitions="*,*,*"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <ImageButton
                            Grid.Column="0"
                            Command="{Binding ChangeViewCommand}"
                            CommandParameter="AddStock"
                            HorizontalOptions="FillAndExpand"
                            Source="add_direct_home.png"
                            VerticalOptions="FillAndExpand" />
                        <ImageButton
                            Grid.Column="1"
                            Command="{Binding ChangeViewCommand}"
                            CommandParameter="NewMovement"
                            HorizontalOptions="FillAndExpand"
                            Source="change_direct_home.png"
                            VerticalOptions="FillAndExpand" />
                        <ImageButton
                            Grid.Column="2"
                            Command="{Binding ChangeViewCommand}"
                            CommandParameter="EditStock"
                            HorizontalOptions="FillAndExpand"
                            Source="edit_direct_home.png"
                            VerticalOptions="FillAndExpand" />
                    </Grid>
                </Frame>
                <!-- Frame tasks -->
                <Frame
                    Grid.Row="1"
                    Grid.RowSpan="4"
                    BackgroundColor="#EAEAEA"
                    BorderColor="Transparent">
                    <Grid>
                        <ActivityIndicator
                            Color="#4A744C"
                            BackgroundColor="Transparent"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"
                            IsRunning="True"
                            IsVisible="{Binding IsTasksLoading}" />
                        <StackLayout
                            Margin="0,0,0,0"
                            Padding="0"
                            Orientation="Vertical"
                            IsVisible="{Binding IsTasksLoading, Converter={StaticResource InvertedBoolConverter}}">
                            <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                                <Label
                                    FontSize="22"
                                    HorizontalOptions="Start"
                                    Text="{Binding TopRecentTasks.Count, StringFormat='Tareas ({0})'}"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                Command="{Binding RefreshTasksCommand}"
                                HeightRequest="35"
                                WidthRequest="35"
                                HorizontalOptions="EndAndExpand"
                                VerticalOptions="Start"
                                Source="refresh.png"
                                Margin="0,0,5,0"
                                Opacity="0.7" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                HeightRequest="35"
                                Clicked="AddTask_Clicked"
                                HorizontalOptions="End"
                                Source="add_circle_button.png"
                                VerticalOptions="Start"
                                WidthRequest="35" />
                        </StackLayout>
                        <BoxView
                            Margin="0,4,0,0"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Start"
                            Color="Gray" />
                            <!-- Frame list tasks -->
                        <CollectionView
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            BackgroundColor="Transparent"
                            ItemsSource="{Binding TopRecentTasks}"
                            SelectionMode="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <Grid Padding="8">
                                        <Frame BackgroundColor="White"
                                               BorderColor="#79280F"
                                               CornerRadius="12"
                                               HasShadow="True"
                                               Padding="15"
                                               HeightRequest="140">
                                            
                                            <Grid RowDefinitions="auto,auto,auto,*,auto" RowSpacing="8">
                                                
                                                <!-- Header con ID y estado -->
                                                <Grid Grid.Row="0" ColumnDefinitions="*,auto,auto" ColumnSpacing="10">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Id, StringFormat='📋 Tarea #{0:D5}'}" 
                                                           FontSize="16" 
                                                           FontAttributes="Bold"
                                                           TextColor="#79280F" 
                                                           VerticalOptions="Center"/>
                                                    
                                                    <Frame Grid.Column="1"
                                                           BackgroundColor="#E8F5E8"
                                                           BorderColor="#4A744C"
                                                           CornerRadius="8"
                                                           Padding="6,3"
                                                           HasShadow="False">
                                                        <Label Text="{Binding TaskStatus}" 
                                                               FontSize="11" 
                                                               FontAttributes="Bold"
                                                               TextColor="#4A744C"
                                                               HorizontalOptions="Center"/>
                                                    </Frame>
                                                    
                                                    <Button Grid.Column="2"
                                                            BackgroundColor="Transparent"
                                                            Clicked="VisivilityTaskItem_Clicked"
                                                            HeightRequest="32"
                                                            WidthRequest="32"
                                                            ImageSource="visibility.png"
                                                            Padding="0" />
                                                </Grid>
                                                
                                                <!-- Material origen -->
                                                <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="5">
                                                    <Label Text="🔧" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Material:" 
                                                           FontSize="13" 
                                                           FontAttributes="Bold"
                                                           TextColor="#666666" 
                                                           VerticalOptions="Center"/>
                                                    <Label Text="{Binding ProductSource}" 
                                                           FontSize="13" 
                                                           TextColor="#333333"
                                                           LineBreakMode="TailTruncation"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                
                                                <!-- Producto destino -->
                                                <StackLayout Grid.Row="2" Orientation="Horizontal" Spacing="5">
                                                    <Label Text="🎯" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Producir:" 
                                                           FontSize="13" 
                                                           FontAttributes="Bold"
                                                           TextColor="#666666" 
                                                           VerticalOptions="Center"/>
                                                    <Label Text="{Binding ProductDestination}" 
                                                           FontSize="13" 
                                                           TextColor="#333333"
                                                           LineBreakMode="TailTruncation"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                
                                                <!-- Espaciador -->
                                                <BoxView Grid.Row="3" />
                                                
                                                <!-- Footer con fecha -->
                                                <Label Grid.Row="4"
                                                       Text="{Binding CreatedAt, StringFormat='📅 Creada {0:dd/MM/yyyy HH:mm}'}"
                                                       FontSize="11"
                                                       TextColor="#999999"
                                                       HorizontalOptions="End"
                                                       VerticalOptions="End" />
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           Spacing="15"
                                           Padding="20">
                                    <Frame BackgroundColor="#F8F9FA"
                                           BorderColor="#E9ECEF"
                                           CornerRadius="12"
                                           Padding="25"
                                           HasShadow="False">
                                        <StackLayout Spacing="10" HorizontalOptions="Center">
                                            <Label Text="📋"
                                                   FontSize="32"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="No hay tareas"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#6C757D"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Las tareas aparecerán aquí cuando se creen"
                                                   FontSize="12"
                                                   TextColor="#ADB5BD"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Frame>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    
                    </StackLayout>
                </Grid>
                </Frame>
                <!-- Frame bookings -->
                <Frame
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    BackgroundColor="#EAEAEA"
                    BorderColor="Transparent">
                    <Grid>
                        <ActivityIndicator
                            Color="#4A744C"
                            BackgroundColor="Transparent"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"
                            IsRunning="True"
                            IsVisible="{Binding IsBookingsLoading}" />
                        <StackLayout
                            Margin="0"
                            Padding="0"
                            Orientation="Vertical"
                            IsVisible="{Binding IsBookingsLoading, Converter={StaticResource InvertedBoolConverter}}">
                            <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                                <Label
                                    FontSize="22"
                                    HorizontalOptions="Start"
                                    Text="{Binding TopRecentBookings.Count, StringFormat='Reservas ({0})'}"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                Command="{Binding RefreshBookingsCommand}"
                                HeightRequest="35"
                                WidthRequest="35"
                                HorizontalOptions="EndAndExpand"
                                VerticalOptions="Start"
                                Source="refresh.png"
                                Margin="0,0,5,0"
                                Opacity="0.7" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                HeightRequest="35"
                                Clicked="AddBooking_Clicked"
                                HorizontalOptions="End"
                                Source="add_circle_button.png"
                                VerticalOptions="Start"
                                WidthRequest="35" />
                        </StackLayout>
                        <BoxView
                            Margin="0,0,0,0"
                            BackgroundColor="Gray"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Start" />
                            <!-- Frame list bookings -->
                        <CollectionView
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            BackgroundColor="Transparent"
                            ItemsSource="{Binding TopRecentBookings}"
                            SelectionMode="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:BookingOrder">
                                    <Grid Padding="8">
                                        <Frame BackgroundColor="White"
                                               BorderColor="#79280F"
                                               CornerRadius="12"
                                               HasShadow="True"
                                               Padding="15"
                                               HeightRequest="120">
                                            
                                            <Grid RowDefinitions="auto,auto,*,auto" RowSpacing="8">
                                                
                                                <!-- Header con cliente y botón -->
                                                <Grid Grid.Row="0" ColumnDefinitions="*,auto" ColumnSpacing="10">
                                                    <Label Grid.Column="0"
                                                           FontSize="16" 
                                                           FontAttributes="Bold"
                                                           TextColor="#79280F" 
                                                           VerticalOptions="Center"
                                                           LineBreakMode="TailTruncation">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="👤 " />
                                                                <Span Text="{Binding Client}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    
                                                    <Button Grid.Column="1"
                                                            BackgroundColor="Transparent"
                                                            Clicked="VisivilityBookingItem_Clicked"
                                                            HeightRequest="32"
                                                            WidthRequest="32"
                                                            ImageSource="visibility.png"
                                                            Padding="0"
                                                            InputTransparent="False"
                                                            IsEnabled="True" />
                                                </Grid>
                                                
                                                <!-- Información de contacto -->
                                                <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="5">
                                                    <Label Text="📞" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Teléfono:" 
                                                           FontSize="13" 
                                                           FontAttributes="Bold"
                                                           TextColor="#666666" 
                                                           VerticalOptions="Center"/>
                                                    <Label Text="{Binding Phone}" 
                                                           FontSize="13" 
                                                           TextColor="#333333"
                                                           VerticalOptions="Center"
                                                           LineBreakMode="TailTruncation"
                                                           HorizontalOptions="Fill"/>
                                                </StackLayout>
                                                
                                                <!-- Espaciador -->
                                                <BoxView Grid.Row="2" />
                                                
                                                <!-- Footer con fecha -->
                                                <Label Grid.Row="3"
                                                       Text="{Binding CreatedAt, StringFormat='📅 Creada {0:dd/MM/yyyy}'}"
                                                       FontSize="11"
                                                       TextColor="#999999"
                                                       HorizontalOptions="End"
                                                       VerticalOptions="End" />
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           Spacing="15"
                                           Padding="20">
                                    <Frame BackgroundColor="#F8F9FA"
                                           BorderColor="#E9ECEF"
                                           CornerRadius="12"
                                           Padding="25"
                                           HasShadow="False">
                                        <StackLayout Spacing="10" HorizontalOptions="Center">
                                            <Label Text="📋"
                                                   FontSize="32"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="No hay reservas"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#6C757D"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Las reservas aparecerán aquí cuando se creen"
                                                   FontSize="12"
                                                   TextColor="#ADB5BD"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Frame>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    
                    </StackLayout>
                </Grid>
                </Frame>
                <!-- Frame notes -->
                <Frame
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    BackgroundColor="#EAEAEA"
                    BorderColor="Transparent">
                    <Grid>
                        <ActivityIndicator
                            Color="#4A744C"
                            BackgroundColor="Transparent"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"
                            IsRunning="True"
                            IsVisible="{Binding IsNotesLoading}" />
                        <StackLayout
                            Margin="0"
                            Padding="0"
                            Orientation="Vertical"
                            IsVisible="{Binding IsNotesLoading, Converter={StaticResource InvertedBoolConverter}}">
                            <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                                <Label
                                    FontSize="22"
                                    HorizontalOptions="Start"
                                    Text="{Binding TopRecentNotes.Count, StringFormat='Notas ({0})'}"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                Command="{Binding RefreshNotesCommand}"
                                HeightRequest="35"
                                WidthRequest="35"
                                HorizontalOptions="EndAndExpand"
                                VerticalOptions="Start"
                                Source="refresh.png"
                                Margin="0,0,5,0"
                                Opacity="0.7" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                Clicked="AddNote_Clicked"
                                HeightRequest="35"
                                HorizontalOptions="End"
                                Source="add_circle_button.png"
                                VerticalOptions="Start"
                                WidthRequest="35" />
                        </StackLayout>

                        <BoxView
                            Margin="0,0,0,0"
                            BackgroundColor="Gray"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Start" />
                        <!-- Frame list notes -->
                        <CollectionView
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            BackgroundColor="Transparent"
                            ItemsSource="{Binding TopRecentNotes}"
                            SelectionMode="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Note">
                                    <Grid Padding="8">
                                        <Frame BackgroundColor="White"
                                               BorderColor="#79280F"
                                               CornerRadius="12"
                                               HasShadow="True"
                                               Padding="15"
                                               HeightRequest="140">
                                            
                                            <Grid RowDefinitions="auto,auto,*,auto" RowSpacing="8">
                                                
                                                <!-- Header con título y botones -->
                                                <Grid Grid.Row="0" ColumnDefinitions="*,auto,auto" ColumnSpacing="8">
                                                    <Label Grid.Column="0"
                                                           FontSize="16" 
                                                           FontAttributes="Bold"
                                                           TextColor="#79280F" 
                                                           VerticalOptions="Center"
                                                           LineBreakMode="TailTruncation">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="📝 " />
                                                                <Span Text="{Binding Title}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    
                                                    <Button Grid.Column="1"
                                                            BackgroundColor="Transparent"
                                                            Clicked="DeleteNote_Clicked"
                                                            HeightRequest="30"
                                                            WidthRequest="30"
                                                            ImageSource="delete_item_icon.png"
                                                            Padding="0"
                                                            InputTransparent="False"
                                                            IsEnabled="True" />
                                                    
                                                    <Button Grid.Column="2"
                                                            BackgroundColor="Transparent"
                                                            Clicked="VisivilityNote_Clicked"
                                                            HeightRequest="30"
                                                            WidthRequest="30"
                                                            ImageSource="visibility.png"
                                                            Padding="0"
                                                            InputTransparent="False"
                                                            IsEnabled="True" />
                                                </Grid>
                                                
                                                <!-- Contenido de la nota -->
                                                <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="5">
                                                    <Label Text="💭" FontSize="14" VerticalOptions="Start"/>
                                                    <Label Text="Contenido:" 
                                                           FontSize="13" 
                                                           FontAttributes="Bold"
                                                           TextColor="#666666" 
                                                           VerticalOptions="Start"/>
                                                </StackLayout>
                                                
                                                <Label Grid.Row="2"
                                                       Text="{Binding Content}"
                                                       FontSize="13"
                                                       TextColor="#333333"
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="3"
                                                       VerticalOptions="Start"
                                                       Margin="0,0,0,5"/>
                                                
                                                <!-- Footer con fecha -->
                                                <Label Grid.Row="3"
                                                       Text="{Binding CreatedAt, StringFormat='📅 Creada {0:dd/MM/yyyy HH:mm}'}"
                                                       FontSize="11"
                                                       TextColor="#999999"
                                                       HorizontalOptions="End"
                                                       VerticalOptions="End" />
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           Spacing="15"
                                           Padding="20">
                                    <Frame BackgroundColor="#F8F9FA"
                                           BorderColor="#E9ECEF"
                                           CornerRadius="12"
                                           Padding="25"
                                           HasShadow="False">
                                        <StackLayout Spacing="10" HorizontalOptions="Center">
                                            <Label Text="📝"
                                                   FontSize="32"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="No hay notas"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#6C757D"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Las notas aparecerán aquí cuando se creen"
                                                   FontSize="12"
                                                   TextColor="#ADB5BD"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Frame>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </StackLayout>
                </Grid>
                </Frame>
            </Grid>

            <!--  Gestión de Stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsMagementStockView}"
                RowDefinitions="auto,auto,*"
                RowSpacing="10">
                
                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    Margin="0,0,0,20"
                    FontSize="32"
                    HorizontalOptions="Start"
                    Text="Gestión de Stock"
                    TextColor="#79280F"
                    VerticalOptions="Start" />
                    
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,30"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Lista de opciones compacta -->
                <StackLayout Grid.Row="2" Spacing="20" HorizontalOptions="Start" MaximumWidthRequest="800">
                    <!-- Carga de stock -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="add_stock_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="AddStock" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Carga de stock"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="AddStock" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Nuevo movimiento -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="new_movement_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="NewMovement" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Nuevo movimiento"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="NewMovement" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Consulta de stock -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="consult_stock_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CheckStock" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Consulta de stock"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CheckStock" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Editar stock -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="edit_stock_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="EditStock" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Editar stock"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="EditStock" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Inventario -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="inventory_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="Inventory" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Inventario"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="Inventory" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                </StackLayout>
            </Grid>

            <!--  Añadir producto  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="25"
                BackgroundColor="White"
                IsVisible="{Binding IsAddProductView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="15">

                <Label
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    FontAttributes="Bold"
                    FontSize="32"
                    HorizontalOptions="Start"
                    Text="Nuevo Producto"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,25"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Grid Grid.Row="2" ColumnDefinitions="1.3*,1.2*" ColumnSpacing="35" RowDefinitions="*" Padding="0" VerticalOptions="Fill">
                    <!-- Columna izquierda - Información básica -->
                    <StackLayout Grid.Column="0" Spacing="18" VerticalOptions="Fill">
                        <!-- Código del producto -->
                        <Grid ColumnDefinitions="auto,300" ColumnSpacing="20" HorizontalOptions="Start" Padding="0">
                            <Label
                                FontSize="18"
                                Text="Código:"
                                TextColor="#79280F"
                                VerticalOptions="Center"
                                FontAttributes="Bold" />
                            
                            <Frame
                                Grid.Column="1"
                                Padding="0"
                                BackgroundColor="White"
                                BorderColor="#797979"
                                HeightRequest="45"
                                CornerRadius="8">
                                <Entry
                                    FontSize="16"
                                    HeightRequest="45"
                                    Placeholder="Código del producto"
                                    Text="{Binding ProductCode}"
                                    TextColor="Black"
                                    BackgroundColor="Transparent"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    Margin="8,0" />
                            </Frame>
                        </Grid>

                        <!-- Tipo de producto -->
                        <StackLayout Spacing="12">
                            <Label
                                FontSize="18"
                                Text="Tipo de Producto"
                                TextColor="#79280F"
                                FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="15" RowSpacing="0">
                                <RadioButton
                                    Grid.Column="0"
                                    Content="Tirante"
                                    FontSize="16"
                                    GroupName="Type"
                                    HorizontalOptions="Center"
                                    IsChecked="{Binding IsTiranteSelect}"
                                    Value="Tirante" />

                                <RadioButton
                                    Grid.Column="1"
                                    Content="Polin"
                                    FontSize="16"
                                    GroupName="Type"
                                    HorizontalOptions="Center"
                                    IsChecked="{Binding IsPolinSelect}"
                                    Value="Polin" />

                                <RadioButton
                                    Grid.Column="2"
                                    Content="Medio Polin"
                                    FontSize="16"
                                    GroupName="Type"
                                    HorizontalOptions="Center"
                                    IsChecked="{Binding IsMedioPolinSelect}"
                                    Value="Medio Polin" />

                                <RadioButton
                                    Grid.Column="3"
                                    Content="Tabla"
                                    FontSize="16"
                                    GroupName="Type"
                                    HorizontalOptions="Center"
                                    IsChecked="{Binding IsTablaSelect}"
                                    Value="Tabla" />
                                <RadioButton
                                    Grid.Column="4"
                                    Content="Poste"
                                    FontSize="16"
                                    GroupName="Type"
                                    HorizontalOptions="Center"
                                    IsChecked="{Binding IsPosteSelect}"
                                    Value="Poste" />
                            </Grid>
                        </StackLayout>

                        <!-- Medidas para productos con medidas -->
                        <StackLayout IsVisible="{Binding IsMeasureSelect}" Spacing="12">
                            <Label
                                FontSize="18"
                                Text="Medidas"
                                TextColor="#79280F"
                                FontAttributes="Bold" />
                            
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15" RowDefinitions="auto,auto">
                                <!-- Grosor -->
                                <StackLayout Grid.Column="0" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="45"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Grosor"
                                            Text="{Binding Thickness}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Grosor (mm)"
                                        TextColor="#666666" />
                                </StackLayout>

                                <!-- Ancho -->
                                <StackLayout Grid.Column="1" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="45"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Ancho"
                                            Text="{Binding Width}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Ancho (mm)"
                                        TextColor="#666666" />
                                </StackLayout>

                                <!-- Largo -->
                                <StackLayout Grid.Column="2" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="45"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Largo"
                                            Text="{Binding Length}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Largo (mm)"
                                        TextColor="#666666" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>

                        <!-- Medidas para Polin -->
                        <StackLayout IsVisible="{Binding IsPolinSelect}" Spacing="12">
                            <Label
                                FontSize="18"
                                Text="Medidas"
                                TextColor="#79280F"
                                FontAttributes="Bold" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <!-- Diámetro -->
                                <StackLayout Grid.Column="0" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            HeightRequest="45"
                                            MaxLength="9"
                                            Placeholder="Diámetro"
                                            Text="{Binding Diameter}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Diámetro (mm)"
                                        TextColor="#666666" />
                                </StackLayout>

                                <!-- Largo -->
                                <StackLayout Grid.Column="1" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="45"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Largo"
                                            Text="{Binding Length}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Largo (mm)"
                                        TextColor="#666666" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>

                        <!-- Medidas para Medio Polin -->
                        <StackLayout IsVisible="{Binding IsMedioPolinSelect}" Spacing="12">
                            <Label
                                FontSize="18"
                                Text="Medidas"
                                TextColor="#79280F"
                                FontAttributes="Bold" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <!-- Diámetro -->
                                <StackLayout Grid.Column="0" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="45"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Diámetro"
                                            Text="{Binding Diameter}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Diámetro (mm)"
                                        TextColor="#666666" />
                                </StackLayout>

                                <!-- Largo -->
                                <StackLayout Grid.Column="1" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="45"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Largo"
                                            Text="{Binding Length}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Largo (mm)"
                                        TextColor="#666666" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                        
                        <!-- Medidas para Poste -->
                        <StackLayout IsVisible="{Binding IsPosteSelect}" Spacing="12">
                            <Label
                                FontSize="18"
                                Text="Medidas"
                                TextColor="#79280F"
                                FontAttributes="Bold" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <!-- Diámetro -->
                                <StackLayout Grid.Column="0" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            HeightRequest="45"
                                            MaxLength="9"
                                            Placeholder="Diámetro"
                                            Text="{Binding Diameter}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Diámetro (mm)"
                                        TextColor="#666666" />
                                </StackLayout>

                                <!-- Largo -->
                                <StackLayout Grid.Column="1" Spacing="8">
                                    <Frame
                                        Padding="5"
                                        BackgroundColor="White"
                                        BorderColor="#797979"
                                        HeightRequest="45"
                                        CornerRadius="8">
                                        <Entry
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="45"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Largo"
                                            Text="{Binding Length}"
                                            TextColor="Black"
                                            BackgroundColor="Transparent" />
                                    </Frame>
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="Largo (mm)"
                                        TextColor="#666666" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>

                    </StackLayout>

                    <!-- Columna derecha - Información adicional -->
                    <StackLayout Grid.Column="1" Spacing="18" VerticalOptions="Fill">
                        <!-- Estado -->
                        <StackLayout Spacing="10">
                            <Label
                                FontSize="18"
                                Text="Estado"
                                TextColor="#79280F"
                                FontAttributes="Bold" />

                            <Frame
                                Padding="12,8"
                                BackgroundColor="White"
                                BorderColor="#797979"
                                CornerRadius="8"
                                HeightRequest="45">
                                <Label
                                    FontSize="16"
                                    Text="{Binding SelectedState, Mode=TwoWay}"
                                    VerticalOptions="Center"
                                    TextColor="Black">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectStateCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                            
                            <Frame
                                CornerRadius="8"
                                HeightRequest="120"
                                IsVisible="{Binding IsVisibleListStates}"
                                VerticalOptions="Start"
                                BorderColor="#E0E0E0"
                                HasShadow="True"
                                Padding="8">
                                <Frame.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Offset="0.1" Color="#FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#FFF6ED" />
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <CollectionView
                                    x:Name="StatesList"
                                    ItemsSource="{Binding States}"
                                    SelectionChanged="States_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Fill"
                                    Margin="0">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="6" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Frame
                                                Margin="2,1"
                                                Padding="10,6"
                                                BackgroundColor="#FFFFFF"
                                                BorderColor="#E0E0E0"
                                                CornerRadius="6"
                                                HasShadow="False">
                                                <Label
                                                    FontSize="16"
                                                    Text="{Binding .}"
                                                    TextColor="#000000"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="Start" />
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>
                        </StackLayout>

                        <!-- Derivado de -->
                        <StackLayout Spacing="10">
                            <Label
                                FontSize="18"
                                Text="Derivado de"
                                TextColor="#79280F"
                                FontAttributes="Bold" />

                            <Frame
                                Padding="12,8"
                                BackgroundColor="White"
                                BorderColor="#797979"
                                CornerRadius="8"
                                HeightRequest="45">
                                <Grid ColumnDefinitions="*,auto">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.Description, TargetNullValue='Selecciónar producto (opcional)', FallbackValue='selecciónar producto (opcional)'}"
                                        VerticalOptions="Center"
                                        TextColor="Black" />
                                    <Button
                                        Grid.Column="1"
                                        Text="?"
                                        FontSize="16"
                                        BackgroundColor="Transparent"
                                        TextColor="#CC0000"
                                        Padding="8,0"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        CornerRadius="15"
                                        Command="{Binding ClearSelectedProductCommand}" />
                                </Grid>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectProductMocvementCommand}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                            
                            <Frame
                                CornerRadius="8"
                                HeightRequest="130"
                                IsVisible="{Binding IsVisibleListProducts}"
                                VerticalOptions="Start"
                                BorderColor="#E0E0E0"
                                HasShadow="True"
                                Padding="8">
                                <Frame.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Offset="0.1" Color="#FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#FFF6ED" />
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <CollectionView
                                    x:Name="ProductList"
                                    ItemsSource="{Binding Products}"
                                    SelectionChanged="Product_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Fill"
                                    Margin="0">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="6" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Product">
                                            <Frame
                                                Margin="2,1"
                                                Padding="10,6"
                                                BackgroundColor="#FFFFFF"
                                                BorderColor="#E0E0E0"
                                                CornerRadius="6"
                                                HasShadow="False">
                                                <Label
                                                    FontSize="16"
                                                    Text="{Binding .}"
                                                    TextColor="#000000"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="Start" />
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>
                        </StackLayout>

                        <!-- Machimbre y Deck -->
                        <Grid IsVisible="{Binding IsMachimbreOption}" ColumnDefinitions="*,auto,*,auto" ColumnSpacing="20" RowSpacing="15">
                            <!-- Machimbre -->
                            <Label
                                Grid.Column="0"
                                FontSize="16"
                                Text="Machimbre"
                                TextColor="#79280F"
                                VerticalOptions="Center"
                                FontAttributes="Bold" />

                            <CheckBox
                                Grid.Column="1"
                                HeightRequest="40"
                                IsChecked="{Binding IsMachimbre}"
                                WidthRequest="40"
                                Color="#79280F" />

                            <!-- Deck -->
                            <Label
                                Grid.Column="2"
                                FontSize="16"
                                IsVisible="{Binding IsDeckOption}"
                                Text="Deck"
                                TextColor="#79280F"
                                VerticalOptions="Center"
                                FontAttributes="Bold" />

                            <CheckBox
                                Grid.Column="3"
                                HeightRequest="40"
                                IsChecked="{Binding IsDeck}"
                                IsVisible="{Binding IsDeckOption}"
                                WidthRequest="40"
                                Color="#79280F" />
                        </Grid>

                        <!-- Lista de Machimbre -->
                        <StackLayout IsVisible="{Binding IsMachimbreTablaSelect}" Spacing="10">
                            <Label
                                FontSize="18"
                                Text="Tipo de Machimbre"
                                TextColor="#79280F"
                                FontAttributes="Bold" />

                            <Frame
                                Padding="12,8"
                                BackgroundColor="White"
                                BorderColor="#797979"
                                CornerRadius="8"
                                HeightRequest="45">
                                <Label
                                    FontSize="16"
                                    Text="{Binding SelectedMachimbre, TargetNullValue='Seleccionar tipo de machimbre', FallbackValue='Seleccionar tipo de machimbre'}"
                                    VerticalOptions="Center"
                                    TextColor="Black" />
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectMachimbreCommand}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                            
                            <Frame
                                x:Name="FrameListMachimbres"
                                CornerRadius="8"
                                HeightRequest="130"
                                IsVisible="{Binding IsVisibleListMachimbres}"
                                VerticalOptions="Start"
                                BorderColor="#E0E0E0"
                                HasShadow="True"
                                Padding="8">
                                <Frame.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Offset="0.1" Color="#FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#FFF6ED" />
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <CollectionView
                                    x:Name="MachimbreList"
                                    ItemsSource="{Binding Machimbres}"
                                    SelectionChanged="Machimbres_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Fill"
                                    Margin="0">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="6" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Frame
                                                Margin="2,1"
                                                Padding="10,6"
                                                BackgroundColor="#FFFFFF"
                                                BorderColor="#E0E0E0"
                                                CornerRadius="6"
                                                HasShadow="False">
                                                <Label
                                                    FontSize="16"
                                                    Text="{Binding .}"
                                                    TextColor="#000000"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="Start" />
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>
                        </StackLayout>

                        <!-- Ubicación, Comentarios y Proveedor en layout vertical mejorado -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="auto,auto,auto,auto,auto" RowSpacing="12">
                            <!-- Ubicación -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="16"
                                Text="Ubicación"
                                TextColor="#79280F"
                                FontAttributes="Bold" />

                            <Frame
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="8"
                                BackgroundColor="White"
                                BorderColor="#797979"
                                HeightRequest="45"
                                CornerRadius="8">
                                <Entry
                                    FontSize="16"
                                    HeightRequest="45"
                                    Text="{Binding Location}"
                                    TextColor="Black"
                                    Placeholder="Ubicación del producto"
                                    BackgroundColor="Transparent" />
                            </Frame>

                            <!-- Proveedor -->
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="16"
                                Text="Proveedor"
                                TextColor="#79280F"
                                FontAttributes="Bold" />

                            <Frame
                                Grid.Row="3"
                                Grid.Column="0"
                                Padding="8"
                                BackgroundColor="White"
                                BorderColor="#797979"
                                HeightRequest="45"
                                CornerRadius="8">
                                <Entry
                                    FontSize="16"
                                    Keyboard="Text"
                                    HeightRequest="45"
                                    Text="{Binding Supplier}"
                                    TextColor="Black"
                                    Placeholder="Nombre del proveedor"
                                    BackgroundColor="Transparent" />
                            </Frame>

                            <!-- Comentarios -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="16"
                                Text="Comentarios"
                                TextColor="#79280F"
                                FontAttributes="Bold" />

                            <Frame
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                Padding="8"
                                BackgroundColor="White"
                                BorderColor="#797979"
                                HeightRequest="100"
                                CornerRadius="8">
                                <Editor
                                    AutoSize="TextChanges"
                                    FontSize="16"
                                    HeightRequest="100"
                                    Text="{Binding Comments}"
                                    TextColor="Black"
                                    Placeholder="Comentarios adicionales"
                                    BackgroundColor="Transparent" />
                            </Frame>
                        </Grid>
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    VerticalOptions="End"
                    HeightRequest="3"
                    Color="#79280F"
                    Margin="0,25,0,0" />

                <Grid
                    Grid.Row="4"
                    Margin="0,20,0,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="25"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="600">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#D3AA84"
                        Command="{Binding SaveProductCommand}"
                        CommandParameter="AddProduct"
                        FontSize="18"
                        HeightRequest="50"
                        Text="Crear Producto"
                        TextColor="#000000"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        MinimumWidthRequest="180" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelAddProductCommand}"
                        FontSize="18"
                        HeightRequest="50"
                        Text="Cancelar"
                        TextColor="#000000"
                        CornerRadius="8"
                        BorderColor="#D3AA84"
                        BorderWidth="2"
                        MinimumWidthRequest="180" />
                </Grid>

            </Grid>

            <!--  Carga de stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsAddStockView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="12">

                <Label
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Carga de Stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Layout horizontal optimizado para landscape -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="*">
                    
                    <!-- Panel único: Búsqueda y lista de productos -->
                    <StackLayout Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
                        <!-- Búsqueda compacta -->
                        <Frame
                            Padding="0"
                            HeightRequest="50"
                            BackgroundColor="White"
                            BorderColor="#79280F"
                            CornerRadius="8"
                            HasShadow="True">
                            <SearchBar
                                x:Name="SearchBarAddStock"
                                BackgroundColor="Transparent"
                                CancelButtonColor="#79280F"
                                Focused="SearchBar_Focused"
                                HeightRequest="32"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"
                                Placeholder="Buscar producto para agregar"
                                PlaceholderColor="#999999"
                                TextChanged="OnAddStockTextChanged"
                                TextColor="#333333"
                                FontSize="13"
                                Unfocused="SearchBar_Unfocused" />
                        </Frame>

                        <!-- Lista de productos para agregar -->
                        <Frame
                            x:Name="FrameListAddStock"
                            CornerRadius="8"
                            IsVisible="{Binding IsVisibleListAddStock}"
                            HeightRequest="180"
                            HorizontalOptions="Fill"
                            BackgroundColor="White"
                            BorderColor="#79280F"
                            HasShadow="True"
                            Padding="8">
                            <CollectionView
                                x:Name="ProductsAddStock"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding Products}"
                                SelectionChanged="Collection_SelectionChanged"
                                SelectionMode="Single"
                                VerticalOptions="Fill">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="8" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Product">
                                        <Frame
                                            BackgroundColor="White"
                                            BorderColor="#E0E0E0"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="4,2"
                                            HasShadow="False">
                                            <Grid
                                                ColumnDefinitions="60,*,60"
                                                ColumnSpacing="12"
                                                RowDefinitions="auto"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontSize="14"
                                                    Text="{Binding Id}"
                                                    TextColor="#79280F"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="14"
                                                    Text="{Binding Description}"
                                                    TextColor="#333333"
                                                    VerticalOptions="Center"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Grid.Column="2"
                                                    FontSize="14"
                                                    Text="{Binding WoodState}"
                                                    TextColor="#666666"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <StackLayout Spacing="10" Padding="20" VerticalOptions="Center">
                                        <Image Source="search_icon.png" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" Opacity="0.5" />
                                        <Label
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            Text="No se encontraron productos"
                                            TextColor="#999999"
                                            HorizontalTextAlignment="Center" />
                                    </StackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Frame>

                        <!-- Lista de productos agregados para carga de stock -->
                        <StackLayout Spacing="8">
                            <Frame 
                                BackgroundColor="White" 
                                BorderColor="#79280F" 
                                CornerRadius="8" 
                                HasShadow="True" 
                                Padding="12,8"
                                Margin="0,10,0,5">
                                <Label Text="Productos a cargar:" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="#79280F" />
                            </Frame>
                            
                            <!-- Header de la lista -->
                            <Frame 
                                BackgroundColor="#F8F9FA" 
                                BorderColor="#79280F" 
                                CornerRadius="8" 
                                HasShadow="False" 
                                Padding="12,8">
                                <Grid ColumnDefinitions="*,*,*,120,40" ColumnSpacing="8">
                                    <Label Text="Código" FontSize="14" FontAttributes="Bold" TextColor="#79280F" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="Descripción" FontSize="14" FontAttributes="Bold" TextColor="#79280F" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="Estado" FontSize="14" FontAttributes="Bold" TextColor="#79280F" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="Cantidad" FontSize="14" FontAttributes="Bold" TextColor="#79280F" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="" FontSize="14" FontAttributes="Bold" TextColor="#79280F" HorizontalTextAlignment="Center" />
                                </Grid>
                            </Frame>
                            
                            <!-- Lista de productos -->
                            <Frame 
                                CornerRadius="8" 
                                Padding="8" 
                                BackgroundColor="White" 
                                BorderColor="#79280F" 
                                HasShadow="True" 
                                HeightRequest="220">
                                <CollectionView
                                    ItemsSource="{Binding ProductsStock, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    VerticalOptions="Fill">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="8" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15" Padding="40">
                                            <Image Source="package_icon.png" HeightRequest="50" WidthRequest="50" HorizontalOptions="Center" Opacity="0.5" />
                                            <Label
                                                FontSize="15"
                                                HorizontalOptions="Center"
                                                Text="No hay productos agregados para cargar"
                                                TextColor="#999999"
                                                VerticalOptions="Center" />
                                        </StackLayout>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProductStock">
                                            <Frame
                                                BackgroundColor="White"
                                                BorderColor="#E0E0E0"
                                                CornerRadius="6"
                                                Padding="12,8"
                                                Margin="4,2"
                                                HasShadow="False">
                                                <Grid
                                                    ColumnDefinitions="*,*,*,120,40"
                                                    ColumnSpacing="12"
                                                    RowDefinitions="auto"
                                                    VerticalOptions="Center">
                                                    
                                                    <Label
                                                        FontSize="14"
                                                        Text="{Binding Product.Id}"
                                                        TextColor="#79280F"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Grid.Column="1"
                                                        FontSize="14"
                                                        Text="{Binding Product.Description}"
                                                        TextColor="#333333"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalOptions="Center"
                                                        LineBreakMode="TailTruncation" />

                                                    <Label
                                                        Grid.Column="2"
                                                        FontSize="14"
                                                        Text="{Binding Product.WoodState}"
                                                        TextColor="#666666"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalOptions="Center" />

                                                    <Frame
                                                        Grid.Column="3"
                                                        Padding="8"
                                                        BackgroundColor="#F8F9FA"
                                                        BorderColor="#79280F"
                                                        CornerRadius="8"
                                                        HeightRequest="40"
                                                        HasShadow="False">
                                                        <Entry
                                                            FontSize="14"
                                                            HorizontalOptions="Fill"
                                                            HorizontalTextAlignment="Center"
                                                            Text="{Binding Quantity, Mode=TwoWay}"
                                                            TextColor="#333333"
                                                            BackgroundColor="Transparent"
                                                            Keyboard="Numeric"
                                                            VerticalOptions="Center" />
                                                    </Frame>

                                                    <ImageButton
                                                        Grid.Column="4"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=RemoveProductToAddedCommand}"
                                                        CommandParameter="{Binding .}"
                                                        HeightRequest="30"
                                                        Source="delete_item_icon.png"
                                                        WidthRequest="30"
                                                        BackgroundColor="Transparent"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>
                        </StackLayout>
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="0,10,0,0"
                    Color="#79280F" />

                <!-- botónes optimizados para horizontal -->
                <Grid
                    Grid.Row="4"
                    Margin="0,12,0,5"
                    ColumnDefinitions="*,180,180,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <ActivityIndicator
                        HeightRequest="32"
                        Grid.ColumnSpan="4"
                        HorizontalOptions="Center"
                        IsRunning="True"
                        Color="#4A744C"
                        IsVisible="{Binding IsBusy}"
                        VerticalOptions="Center"
                        WidthRequest="32" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#79280F"
                        Clicked="AddStock_Clicked"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        HeightRequest="45"
                        Text="Cargar Stock"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelAddStockCommand}"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        HeightRequest="45"
                        Text="Cancelar"
                        TextColor="#79280F"
                        FontSize="16"
                        FontAttributes="Bold"
                        BorderColor="#79280F"
                        BorderWidth="2"
                        CornerRadius="8" />
                </Grid>

            </Grid>

            <!--  Editar stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsEditStockView}"
                RowDefinitions="auto,auto,auto,auto,auto,*,auto"
                RowSpacing="10">

                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Editar stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <VerticalStackLayout
                    Grid.Row="2"
                    Margin="0,0,0,20"
                    Padding="0,0,0,0">
                    <Frame
                        Margin="0"
                        Padding="0"
                        BackgroundColor="White"
                        BorderColor="#79280F"
                        CornerRadius="8"
                        HeightRequest="50"
                        HasShadow="True">
                        <SearchBar
                            x:Name="SearchBarEditStock"
                            BackgroundColor="Transparent"
                            CancelButtonColor="#79280F"
                            Focused="SearchBar_EditStockFocused"
                            HeightRequest="32"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            Placeholder="Buscar producto para editar"
                            PlaceholderColor="#999999"
                            TextChanged="OnEditStockTextChanged"
                            TextColor="#333333"
                            FontSize="13"
                            Unfocused="SearchBar_EditStockUnfocused" />

                    </Frame>


                    <Frame
                        x:Name="FrameListEditStock"
                        CornerRadius="8"
                        IsVisible="{Binding IsVisibleListEditStock}"
                        BackgroundColor="White"
                        BorderColor="#79280F"
                        HasShadow="True"
                        Padding="8">
                        <CollectionView
                            x:Name="ProductsEditStock"
                            HorizontalOptions="Fill"
                            ItemsSource="{Binding ProductsWithStock}"
                            SelectionChanged="CollectionEditStock_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="Fill">

                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductStock">
                                    <Frame BackgroundColor="White" 
                                           BorderColor="#79280F" 
                                           CornerRadius="8" 
                                           HasShadow="False" 
                                           Padding="12,8" 
                                           Margin="2">
                                        <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="15">
                                            <Label Grid.Column="0"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   Text="{Binding Id}"
                                                   TextColor="#333333"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                                                   FontSize="14"
                                                   Text="{Binding Product.Description}"
                                                   TextColor="#333333"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="2"
                                                   FontSize="13"
                                                   Text="{Binding Product.WoodState}"
                                                   TextColor="#79280F"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout Spacing="8" Padding="20">
                                    <Image Source="search_icon.png" 
                                           HeightRequest="32" 
                                           WidthRequest="32" 
                                           HorizontalOptions="Center" 
                                           Opacity="0.5" />
                                    <Label FontSize="15"
                                           HorizontalOptions="Center"
                                           Text="No se encontraron productos para editar stock"
                                           TextColor="#666666"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Frame>

                </VerticalStackLayout>

                <Frame
                    Grid.Row="3"
                    Margin="0,0,0,15"
                    IsVisible="{Binding IsSelectedProductEditStock}"
                    BackgroundColor="White"
                    BorderColor="#79280F"
                    CornerRadius="8"
                    HasShadow="True"
                    Padding="15">
                    <Grid RowDefinitions="auto,auto" RowSpacing="12">
                        <!-- Headers -->
                        <Grid Grid.Row="0" ColumnDefinitions="1.2*,2*,1.2*,1.2*,1.5*,1*" ColumnSpacing="10">
                            <Label Grid.Column="0" FontSize="15" FontAttributes="Bold" Text="Código" TextColor="#79280F" />
                            <Label Grid.Column="1" FontSize="15" FontAttributes="Bold" Text="Descripción" TextColor="#79280F" />
                            <Label Grid.Column="2" FontSize="15" FontAttributes="Bold" Text="Estado" TextColor="#79280F" />
                            <Label Grid.Column="3" FontSize="15" FontAttributes="Bold" Text="Stock Disponible" TextColor="#79280F" />
                            <Label Grid.Column="4" FontSize="15" FontAttributes="Bold" Text="Reserva / Proceso" TextColor="#79280F" />
                            <Label Grid.Column="5" FontSize="15" FontAttributes="Bold" Text="Total" TextColor="#79280F" />
                        </Grid>
                        
                        <!-- Data -->
                        <Grid Grid.Row="1" ColumnDefinitions="1.2*,2*,1.2*,1.2*,1.5*,1*" ColumnSpacing="10">
                            <Label Grid.Column="0" FontSize="14" Text="{Binding ProductEditStock.Id}" TextColor="#333333" />
                            <Label Grid.Column="1" FontSize="14" Text="{Binding ProductEditStock.Product.Description}" TextColor="#333333" />
                            <Label Grid.Column="2" FontSize="14" Text="{Binding ProductEditStock.Product.WoodState}" TextColor="#333333" />
                            <Label Grid.Column="3" FontSize="14" Text="{Binding ProductEditStock.Available}" TextColor="#333333" />
                            <Label Grid.Column="4" FontSize="14" FontAttributes="Bold" TextColor="#333333">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ProductEditStock.Reserved}" />
                                        <Span Text=" / " />
                                        <Span Text="{Binding ProductEditStock.Process}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Column="5" FontSize="14" Text="{Binding ProductEditStock.Quantity}" TextColor="#333333" />
                        </Grid>
                    </Grid>
                </Frame>

                <Frame
                    Grid.Row="4"
                    Margin="0,10,0,15"
                    BackgroundColor="White"
                    BorderColor="#79280F"
                    CornerRadius="8"
                    HasShadow="True"
                    Padding="15">
                    <StackLayout Orientation="Horizontal" Spacing="15" HorizontalOptions="Start">
                        <Label FontSize="16"
                               FontAttributes="Bold"
                               Text="Ingrese nuevo Total de stock:"
                               TextColor="#79280F"
                               VerticalOptions="Center" />
                        <Frame BackgroundColor="#F8F9FA"
                               BorderColor="#79280F"
                               CornerRadius="8"
                               Padding="12,8"
                               HasShadow="False">
                            <Entry FontSize="15"
                                   Text="{Binding QuantityEditStock}"
                                   TextColor="#333333"
                                   BackgroundColor="Transparent"
                                   WidthRequest="120"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="Center" />
                        </Frame>
                    </StackLayout>
                </Frame>
                <BoxView
                    Grid.Row="5"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="EndAndExpand"
                    Margin="0,5,0,0"
                    Color="#79280F" />

                <Grid
                    Grid.Row="6"
                    Margin="0,15,0,0"
                    VerticalOptions="End"
                    ColumnDefinitions="*,180,180,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#79280F"
                        Clicked="EditStock_Clicked"
                        HeightRequest="45"
                        Text="Editar Stock"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelEditStockCommand}"
                        HeightRequest="45"
                        Text="Cancelar"
                        TextColor="#79280F"
                        FontSize="16"
                        FontAttributes="Bold"
                        BorderColor="#79280F"
                        BorderWidth="2"
                        CornerRadius="8" />
                </Grid>


            </Grid>

            <!--  Nuevo Movimiento  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsNewMovementView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="12">

                <Label
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Movimiento de Stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Layout horizontal optimizado para landscape -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="*">
                    
                    <!-- Panel izquierdo: Búsqueda y selección de producto -->
                    <StackLayout Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
                        <!-- Búsqueda compacta -->
                        <Frame
                            Padding="0"
                            HeightRequest="50"
                            BackgroundColor="White"
                            BorderColor="#79280F"
                            CornerRadius="8"
                            HasShadow="True">
                            <SearchBar
                                x:Name="SearchBarNewMovement"
                                BackgroundColor="Transparent"
                                CancelButtonColor="#79280F"
                                Focused="SearchBar_NewMovementFocused"
                                HeightRequest="32"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"
                                Placeholder="Buscar producto"
                                PlaceholderColor="#999999"
                                TextChanged="OnNewMovementTextChanged"
                                TextColor="#333333"
                                FontSize="13"
                                Unfocused="SearchBar_NewMovementUnfocused" />
                        </Frame>

                        <!-- Lista de productos compacta -->
                        <Frame
                            x:Name="FrameListNewMovoment"
                            CornerRadius="8"
                            IsVisible="{Binding IsVisibleListNewMovement}"
                            HeightRequest="180"
                            HorizontalOptions="Fill"
                            BackgroundColor="White"
                            BorderColor="#79280F"
                            HasShadow="True"
                            Padding="8">
                            <CollectionView
                                x:Name="ProductsNewMovement"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding ProductsWithStock}"
                                SelectionChanged="CollectionNewMovement_SelectionChanged"
                                SelectionMode="Single"
                                VerticalOptions="Fill">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="8" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductStock">
                                        <Frame
                                            BackgroundColor="White"
                                            BorderColor="#E0E0E0"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="4,2"
                                            HasShadow="False">
                                            <Grid
                                                ColumnDefinitions="60,*,60"
                                                ColumnSpacing="12"
                                                RowDefinitions="auto"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontSize="14"
                                                    Text="{Binding Id}"
                                                    TextColor="#79280F"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="14"
                                                    Text="{Binding Product.Description}"
                                                    TextColor="#333333"
                                                    VerticalOptions="Center"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Grid.Column="2"
                                                    FontSize="14"
                                                    Text="{Binding Product.WoodState}"
                                                    TextColor="#666666"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <StackLayout Spacing="10" Padding="20" VerticalOptions="Center">
                                        <Image Source="search_icon.png" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" Opacity="0.5" />
                                        <Label
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            Text="No se encontraron productos"
                                            TextColor="#999999"
                                            HorizontalTextAlignment="Center" />
                                    </StackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Frame>

                        <!-- Información del producto seleccionado compacta -->
                        <Frame IsVisible="{Binding IsSelectedProductMovement}"
                               BackgroundColor="White"
                               BorderColor="#79280F"
                               CornerRadius="8"
                               HasShadow="True"
                               Padding="15">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="25">
                                
                                <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,auto,auto,auto" ColumnSpacing="15" RowSpacing="8">
                                    
                                    <Label Grid.Row="1" Text="Código:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProductMovement.Id}" FontSize="15" HorizontalOptions="Start" TextColor="#333333" />
                                    
                                    <Label Grid.Row="2" Text="Descripción:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProductMovement.Product.Description}" 
                                           FontSize="15" TextColor="#333333" LineBreakMode="TailTruncation" />
                                    
                                    <Label Grid.Row="3" Text="Estado:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding ProductMovement.Product.WoodState}" FontSize="15" TextColor="#333333" />
                                </Grid>
                                
                                <!-- Stock info en una línea -->
                                <Grid Grid.Column="1" RowDefinitions="*,*,*" ColumnDefinitions="auto,*" ColumnSpacing="15" RowSpacing="8">
                                    <Label Text="Disponible:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Column="1" Text="{Binding ProductMovement.Available}" FontSize="15" TextColor="#333333" />

                                    <Label Grid.Row="1" Text="Reserva/Proceso:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                        <Label Grid.Row="1" Grid.Column="1" FontSize="15" TextColor="#333333">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ProductMovement.Reserved}" />
                                                    <Span Text="/" />
                                                    <Span Text="{Binding ProductMovement.Process}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    
                                    <Label Grid.Row="2" Text="Total:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProductMovement.Quantity}" FontSize="15" TextColor="#333333" />
                                    
                                </Grid>
                            </Grid>
                        </Frame>

                        <Frame IsVisible="{Binding IsSelectedProductMovement,Converter = { StaticResource InvertedBoolConverter }}"
                               BackgroundColor="White" 
                               BorderColor="#E0E0E0" 
                               CornerRadius="8" 
                               HasShadow="True" 
                               Padding="20">
                            <StackLayout Spacing="10" HorizontalOptions="Center">
                                <Image Source="product_icon.png" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" Opacity="0.5" />
                                <Label TextColor="#79280F" 
                                       FontSize="15" 
                                       FontAttributes="Bold"
                                       Text="Seleccione un producto para realizar movimiento"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>
                                
                        <StackLayout Spacing="15">
                            
                            <!-- Tipo de movimiento optimizado -->
                            <Grid IsVisible="{Binding IsSelectedProductMovement}" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="auto">
                                <!-- Tipo de movimiento -->
                                <Frame Grid.Column="0" 
                                       BackgroundColor="White" 
                                       BorderColor="#79280F" 
                                       CornerRadius="8" 
                                       HasShadow="True" 
                                       Padding="15">
                                    <StackLayout Spacing="12">
                                        <Label Text="Tipo de movimiento:" 
                                               TextColor="#79280F"
                                               FontSize="15" 
                                               FontAttributes="Bold"/>
                                        <StackLayout Orientation="Horizontal" Spacing="15">
                                            <RadioButton
                                                Content="Venta"
                                                GroupName="MovementType"
                                                IsChecked="{Binding IsSale}"
                                                TextColor="#79280F"
                                                FontSize="14"
                                                Value="Sale" />
                                            <RadioButton
                                                Content="Cambio de estado"
                                                GroupName="MovementType"
                                                IsChecked="{Binding IsChangeOfState}"
                                                TextColor="#79280F"
                                                FontSize="14"
                                                Value="ChangeOfState" />
                                            <RadioButton
                                                Content="Para pérdida"
                                                GroupName="MovementType"
                                                IsChecked="{Binding IsLoss}"
                                                TextColor="#79280F"
                                                FontSize="14"
                                                Value="Loss" />
                                        </StackLayout>
                                    </StackLayout>
                                </Frame>

                                <!-- Cantidad -->
                                <Frame Grid.Column="1" 
                                       BackgroundColor="White" 
                                       BorderColor="#79280F" 
                                       CornerRadius="8" 
                                       HasShadow="True" 
                                       Padding="15">
                                    <StackLayout Spacing="12">
                                        <Label
                                            Text="Cantidad"
                                            TextColor="#79280F"
                                            FontSize="15"
                                            FontAttributes="Bold" />
                                        <Frame
                                            Padding="8"
                                            BackgroundColor="#F8F9FA"
                                            BorderColor="#79280F"
                                            CornerRadius="8"
                                            HeightRequest="45">
                                            <Entry
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding QuantityMovement}"
                                                TextColor="#333333"
                                                FontSize="14"
                                                Keyboard="Numeric"                                        
                                                BackgroundColor="Transparent"
                                                Placeholder="Ingrese cantidad"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Center" />
                                        </Frame>
                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <!-- Opciones condicionales -->
                            <!-- Cambio de estado -->
                            <Frame IsVisible="{Binding IsChangeOfState}" 
                                   BackgroundColor="White" 
                                   BorderColor="#79280F" 
                                   CornerRadius="8" 
                                   HasShadow="True" 
                                   Padding="15">
                                <Grid ColumnDefinitions="auto,*" ColumnSpacing="15" RowDefinitions="auto">
                                    <Label Grid.Column="0"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Text="Siguiente estado:"
                                        TextColor="#79280F"
                                        VerticalOptions="Center" />

                                    <Frame Grid.Column="1"
                                        Padding="8"
                                        BackgroundColor="#F8F9FA"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="75"
                                        HorizontalOptions="Fill">
                                        <Picker
                                            ItemsSource="{Binding DependingProducts}"
                                            SelectedItem="{Binding SelectedDependingProducts}"
                                            TextColor="#333333"
                                            FontSize="14"
                                            Title="Seleccione un estado"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center" />
                                    </Frame>
                                </Grid>
                            </Frame>

                            <!-- Venta -->
                            <Frame IsVisible="{Binding IsSale}" 
                                   BackgroundColor="White" 
                                   BorderColor="#79280F" 
                                   CornerRadius="8" 
                                   HasShadow="True" 
                                   Padding="15">
                                <Grid ColumnDefinitions="auto,*" ColumnSpacing="15" RowDefinitions="auto">
                                    <Label Grid.Column="0"
                                        FontSize="15"
                                        IsVisible="{Binding IsSelectedProductMovement}"
                                        FontAttributes="Bold"
                                        Text="Cliente:"
                                        TextColor="#79280F"
                                        VerticalOptions="Center" />

                                    <Frame Grid.Column="1"
                                        Padding="8"
                                        IsVisible="{Binding IsSelectedProductMovement}"
                                        BackgroundColor="#F8F9FA"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="45"
                                        HorizontalOptions="Fill">
                                        <Entry
                                            Text="{Binding SaleClient}"
                                            TextColor="#333333"
                                            FontSize="14"
                                            BackgroundColor="Transparent"
                                            Placeholder="Nombre del cliente"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center" />
                                    </Frame>
                                </Grid>
                            </Frame>

                            <!-- Pérdida -->
                            <Frame IsVisible="{Binding IsLoss}" 
                                   BackgroundColor="White" 
                                   BorderColor="#79280F" 
                                   CornerRadius="8" 
                                   HasShadow="True" 
                                   Padding="15">
                                <Grid ColumnDefinitions="auto,*" ColumnSpacing="15" RowDefinitions="auto">
                                    <Label Grid.Column="0"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Text="Motivo:"
                                        TextColor="#79280F"
                                        VerticalOptions="Start" />

                                    <Frame Grid.Column="1"
                                        Padding="8"
                                        BackgroundColor="#F8F9FA"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="80"
                                        HorizontalOptions="Fill">
                                        <Editor
                                            Text="{Binding LossMotive}"
                                            TextColor="#333333"
                                            FontSize="14"
                                            Placeholder="Motivo de la pérdida"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            AutoSize="TextChanges" />
                                    </Frame>
                                </Grid>
                            </Frame>
                        </StackLayout>
                   
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="0,10,0,0"
                    Color="#79280F" />

                <!-- Botónes optimizados para horizontal -->
                <Grid
                    Grid.Row="4"
                    Margin="0,12,0,5"
                    ColumnDefinitions="*,180,180,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#79280F"
                        Clicked="NewMovement_Clicked"
                        HeightRequest="45"
                        Text="Confirmar"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelNewMovementCommand}"
                        HeightRequest="45"
                        Text="Cancelar"
                        TextColor="#79280F"
                        FontSize="16"
                        FontAttributes="Bold"
                        BorderColor="#79280F"
                        BorderWidth="2"
                        CornerRadius="8" />
                </Grid>

            </Grid>

            <!--  Inventario  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="10,15,10,10"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsInventoryView}"
                RowDefinitions="auto,auto,auto,*"
                RowSpacing="8">

                <!-- Título y búsqueda en la misma fila para tablets -->
                <Grid Grid.Row="0" ColumnDefinitions="auto,*" ColumnSpacing="20" Margin="0,0,0,10">
                    <Label
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        Text="Inventario"
                        TextColor="#79280F"
                        VerticalOptions="Center" />
                    
                    <Frame
                        Grid.Column="1"
                        Padding="0"
                        HeightRequest="32"
                        BackgroundColor="Transparent"
                        BorderColor="#797979"
                        CornerRadius="8"
                        MaximumWidthRequest="400">
                        <SearchBar
                            x:Name="SearchBarInventory"
                            BackgroundColor="Transparent"
                            CancelButtonColor="#79280F"
                            Placeholder="Buscar producto..."
                            HeightRequest="28"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            FontSize="13"
                            TextChanged="OnSearchStockInventoryTextChanged"
                            TextColor="#333333"
                            PlaceholderColor="#999999" />
                    </Frame>
                </Grid>

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Encabezados de columnas ultra-compactos -->
                <Grid Grid.Row="2" Margin="12,5,12,8" ColumnDefinitions="1.8*,2.5*,1.5*,1.5*,0.8*,0.8*" ColumnSpacing="8">
                    <Label Grid.Column="0" FontSize="14" FontAttributes="Bold" Text="#Código" TextColor="#79280F" VerticalOptions="Center" />
                    <Label Grid.Column="1" FontSize="14" FontAttributes="Bold" Text="Descripción" TextColor="#79280F" VerticalOptions="Center" />
                    <Label Grid.Column="2" FontSize="14" FontAttributes="Bold" Text="Estado" TextColor="#79280F" VerticalOptions="Center" />
                    <Label Grid.Column="3" FontSize="14" FontAttributes="Bold" Text="Ubicación" TextColor="#79280F" VerticalOptions="Center" />
                    <Label Grid.Column="4" FontSize="14" FontAttributes="Bold" Text="" TextColor="#79280F" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="5" FontSize="14" FontAttributes="Bold" Text="" TextColor="#79280F" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                </Grid>

                <!-- Lista de productos ultra-compacta -->
                <Frame Grid.Row="3" Margin="0,0,0,0" Padding="8" BackgroundColor="#FAFAFA" CornerRadius="12" HasShadow="False">
                    <CollectionView
                        x:Name="ProductsSearchStockInventory"
                        ItemsSource="{Binding Products}"
                        SelectionMode="Single"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Default">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Frame Margin="0,2" Padding="8,6" BackgroundColor="White" CornerRadius="8" HasShadow="False">
                                    <Grid ColumnDefinitions="1.8*,2.5*,1.5*,1.5*,0.8*,0.8*" ColumnSpacing="8" RowDefinitions="auto" MinimumHeightRequest="32">
                                        <Label Grid.Column="0" FontSize="13" Text="{Binding Id}" TextColor="#000000" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" FontSize="13" Text="{Binding Description}" TextColor="#000000" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2" FontSize="13" Text="{Binding WoodState}" TextColor="#000000" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="3" FontSize="13" Text="{Binding Location}" TextColor="#000000" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <Button
                                            Grid.Column="4"
                                            BackgroundColor="Transparent"
                                            Clicked="VisivilityProduct_Clicked"
                                            ImageSource="visibility.png"
                                            CornerRadius="16"
                                            Padding="4"
                                            HeightRequest="28"
                                            WidthRequest="28"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                        <Button
                                            Grid.Column="5"
                                            BackgroundColor="Transparent"
                                            Clicked="DeleteProduct_Clicked"
                                            ImageSource="delete_item_icon.png"
                                            CornerRadius="16"
                                            Padding="4"
                                            HeightRequest="28"
                                            WidthRequest="28"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

            </Grid>

            <!--  Inventario vista de productos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="25"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsInventoryEditView}"
                RowDefinitions="auto,auto,*,auto"
                RowSpacing="15">
                
                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    FontSize="32"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    Text="Detalle del Producto"
                    TextColor="#79280F"
                    VerticalOptions="Center"
                    Margin="0,0,0,15" />

                <!-- Separador -->
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,25"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Información del producto en layout optimizado para desktop -->
                <Frame
                    Grid.Row="2"
                    BackgroundColor="White"
                    BorderColor="#79280F"
                    CornerRadius="12"
                    HasShadow="True"
                    Padding="25"
                    Margin="0,0,0,20">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="50" RowDefinitions="auto,auto,auto,auto">
                        
                        <!-- Primera columna - Información básica -->
                        <StackLayout Grid.Column="0" Spacing="20">
                            <StackLayout Orientation="Horizontal" Spacing="15">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Código:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center"
                                    WidthRequest="120" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="10,8" HasShadow="False">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.Id}"
                                        TextColor="#333333"
                                        VerticalOptions="Center" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Orientation="Horizontal" Spacing="15">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Descripción:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center"
                                    WidthRequest="120" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="10,8" HasShadow="False" VerticalOptions="Fill">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.Description}"
                                        TextColor="#333333"
                                        VerticalOptions="Center"
                                        LineBreakMode="WordWrap" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Orientation="Horizontal" Spacing="15">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Estado:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center"
                                    WidthRequest="120" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="10,8" HasShadow="False">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.WoodState}"
                                        TextColor="#333333"
                                        VerticalOptions="Center" />
                                </Frame>
                            </StackLayout>
                        </StackLayout>

                        <!-- Segunda columna - Información adicional -->
                        <StackLayout Grid.Column="1" Spacing="20">
                            <StackLayout Orientation="Horizontal" Spacing="15">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Ubicación:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center"
                                    WidthRequest="120" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="10,8" HasShadow="False">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.Location}"
                                        TextColor="#333333"
                                        VerticalOptions="Center" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Orientation="Horizontal" Spacing="15">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Proveedor:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center"
                                    WidthRequest="120" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="10,8" HasShadow="False">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.Supplier}"
                                        TextColor="#333333"
                                        VerticalOptions="Center" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Spacing="12">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Comentarios:"
                                    TextColor="#79280F" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="15,12" HasShadow="False" HeightRequest="80">
                                    <Label
                                        FontSize="15"
                                        Text="{Binding SelectedProduct.Comment}"
                                        TextColor="#333333"
                                        LineBreakMode="WordWrap"
                                        VerticalOptions="Start" />
                                </Frame>
                            </StackLayout>
                        </StackLayout>

                    </Grid>

                </Frame>

                <!-- Botones de acción optimizados -->
                <Grid
                    Grid.Row="3"
                    HorizontalOptions="Center"
                    ColumnDefinitions="200,200"
                    ColumnSpacing="25"
                    Margin="0,15,0,0">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#FFF6ED"
                        BorderColor="#79280F"
                        BorderWidth="2"
                        Clicked="BackToInventory_Clicked"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Volver"
                        TextColor="#79280F"
                        CornerRadius="8" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#79280F"
                        Clicked="EditProductPage_Clicked"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Editar Producto"
                        TextColor="White"
                        CornerRadius="8" />
                </Grid>

            </Grid>

            <!--  Inventario vista de edición de productos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="25"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsInventoryEditProductView}"
                RowDefinitions="auto,auto,*,auto"
                RowSpacing="15">
                
                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    FontSize="32"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    Text="Editar Producto"
                    TextColor="#79280F"
                    VerticalOptions="Center"
                    Margin="0,0,0,15" />

                <!-- Separador -->
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,25"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Formulario de edición optimizado para desktop -->
                <Frame
                    Grid.Row="2"
                    BackgroundColor="White"
                    BorderColor="#79280F"
                    CornerRadius="12"
                    HasShadow="True"
                    Padding="25"
                    Margin="0,0,0,20">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="50" RowDefinitions="auto,auto,auto,auto">
                        
                        <!-- Primera columna - Información básica (solo lectura) -->
                        <StackLayout Grid.Column="0" Spacing="20">
                            <StackLayout Orientation="Horizontal" Spacing="15">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Código:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center"
                                    WidthRequest="120" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="10,8" HasShadow="False">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.Id}"
                                        TextColor="#333333"
                                        VerticalOptions="Center" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Orientation="Horizontal" Spacing="15">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Descripción:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center"
                                    WidthRequest="120" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="10,8" HasShadow="False" VerticalOptions="Fill">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.Description}"
                                        TextColor="#333333"
                                        VerticalOptions="Center"
                                        LineBreakMode="WordWrap" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Orientation="Horizontal" Spacing="15">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Estado:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center"
                                    WidthRequest="120" />
                                <Frame BackgroundColor="#F8F9FA" BorderColor="#E0E0E0" CornerRadius="6" Padding="10,8" HasShadow="False">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding SelectedProduct.WoodState}"
                                        TextColor="#333333"
                                        VerticalOptions="Center" />
                                </Frame>
                            </StackLayout>
                        </StackLayout>

                        <!-- Segunda columna - Campos editables -->
                        <StackLayout Grid.Column="1" Spacing="20">
                            <StackLayout Spacing="12">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Ubicación:"
                                    TextColor="#79280F" />
                                <Frame
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="#79280F"
                                    CornerRadius="8"
                                    HasShadow="True"
                                    HeightRequest="50">
                                    <Entry
                                        FontSize="16"
                                        Text="{Binding ProductLocationEdit}"
                                        TextColor="#333333"
                                        Placeholder="Ingrese ubicación"
                                        PlaceholderColor="#999999"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center"
                                        Margin="15,8" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Spacing="12">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Proveedor:"
                                    TextColor="#79280F" />
                                <Frame
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="#79280F"
                                    CornerRadius="8"
                                    HasShadow="True"
                                    HeightRequest="50">
                                    <Entry
                                        FontSize="16"
                                        Text="{Binding ProduSupplierEdit}"
                                        TextColor="#333333"
                                        Placeholder="Ingrese proveedor"
                                        PlaceholderColor="#999999"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center"
                                        Margin="15,8" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Spacing="12">
                                <Label
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Text="Comentarios:"
                                    TextColor="#79280F" />
                                <Frame
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="#79280F"
                                    CornerRadius="8"
                                    HasShadow="True"
                                    HeightRequest="100">
                                    <Editor
                                        FontSize="15"
                                        Text="{Binding ProductCommentEdit}"
                                        TextColor="#333333"
                                        Placeholder="Ingrese comentarios"
                                        PlaceholderColor="#999999"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Fill"
                                        Margin="15,12" />
                                </Frame>
                            </StackLayout>
                        </StackLayout>

                    </Grid>

                </Frame>

                <!-- Botones de acción optimizados -->
                <Grid
                    Grid.Row="3"
                    HorizontalOptions="Center"
                    ColumnDefinitions="200,200"
                    ColumnSpacing="25"
                    Margin="0,15,0,0">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#FFF6ED"
                        BorderColor="#79280F"
                        BorderWidth="2"
                        Clicked="CancelEditProductPage_Clicked"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Cancelar"
                        TextColor="#79280F"
                        CornerRadius="8" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#79280F"
                        Clicked="SaveEditProductPage_Clicked"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Guardar Cambios"
                        TextColor="White"
                        CornerRadius="8" />
                </Grid>

            </Grid>

            <!--  Consultar stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsCheckStockView}"
                RowDefinitions="auto,auto,auto,*"
                RowSpacing="12">
                
                <!-- Título y búsqueda optimizados para landscape -->
                <Grid Grid.Row="0" ColumnDefinitions="auto,*" ColumnSpacing="25" Margin="0,0,0,0">
                    <Label
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        Text="Consulta de Stock"
                        TextColor="#79280F"
                        VerticalOptions="Center" />
                    
                    <Frame
                        Grid.Column="1"
                        Padding="0"
                        HeightRequest="32"
                        BackgroundColor="Transparent"
                        BorderColor="#797979"
                        CornerRadius="8"
                        MaximumWidthRequest="400">
                        <SearchBar
                            x:Name="SearchBarSeachStock"
                            BackgroundColor="Transparent"
                            CancelButtonColor="#79280F"
                            Placeholder="Buscar producto..."
                            HeightRequest="28"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            FontSize="13"
                            TextChanged="OnSearchStockTextChanged"
                            TextColor="#333333"
                            PlaceholderColor="#999999" />
                    </Frame>
                </Grid>

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Encabezados ultra-compactos para landscape -->
                <Frame Grid.Row="2" 
                       Margin="0,0,0,8"
                       Padding="0"
                       BackgroundColor="#F5F5F5"
                       CornerRadius="8"
                       HasShadow="False">
                    <Grid ColumnDefinitions="1.5*,2.5*,1.5*,1.3*,1.3*,1.2*" 
                          ColumnSpacing="8" 
                          Padding="15,8,15,8">
                        <Label Grid.Column="0" FontSize="14" FontAttributes="Bold" Text="#Código" TextColor="#79280F" VerticalOptions="Center" />
                        <Label Grid.Column="1" FontSize="14" FontAttributes="Bold" Text="Descripción" TextColor="#79280F" VerticalOptions="Center" />
                        <Label Grid.Column="2" FontSize="14" FontAttributes="Bold" Text="Estado" TextColor="#79280F" VerticalOptions="Center" />
                        <Label Grid.Column="3" FontSize="14" FontAttributes="Bold" Text="Disponible" TextColor="#79280F" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" FontSize="14" FontAttributes="Bold" Text="Reserva/Proceso" TextColor="#79280F" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="5" FontSize="14" FontAttributes="Bold" Text="Total" TextColor="#79280F" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    </Grid>
                </Frame>

                <!-- Lista de stock ultra-optimizada -->
                <Frame Grid.Row="3" 
                       Margin="0,0,0,0" 
                       Padding="8" 
                       BackgroundColor="#FAFAFA" 
                       CornerRadius="12" 
                       HasShadow="False">
                    <CollectionView
                        x:Name="ProductsSearchStock"
                        ItemsSource="{Binding Stock, Mode=TwoWay}"
                        SelectionMode="None"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Default">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductStock">
                                <Grid ColumnDefinitions="1.5*,2.5*,1.5*,1.3*,1.3*,1.2*" 
                                      ColumnSpacing="8" 
                                      Padding="15,12,15,12"
                                      BackgroundColor="White">
                                    <Label Grid.Column="0" 
                                           FontSize="13" 
                                           Text="{Binding Id}" 
                                           TextColor="#333333" 
                                           VerticalOptions="Center" 
                                           LineBreakMode="TailTruncation" />
                                    
                                    <Label Grid.Column="1" 
                                           FontSize="13" 
                                           Text="{Binding Product.Description}" 
                                           TextColor="#333333" 
                                           VerticalOptions="Center" 
                                           LineBreakMode="WordWrap" />
                                    
                                    <Label Grid.Column="2" 
                                           FontSize="13" 
                                           Text="{Binding Product.WoodState}" 
                                           TextColor="#333333" 
                                           VerticalOptions="Center" 
                                           LineBreakMode="TailTruncation" />
                                    
                                    <Label Grid.Column="3" 
                                           FontSize="13" 
                                           Text="{Binding Available}" 
                                           TextColor="#333333" 
                                           VerticalOptions="Center" 
                                           HorizontalTextAlignment="Center" />
                                    
                                    <Label Grid.Column="4" 
                                           FontSize="13" 
                                           TextColor="#333333" 
                                           VerticalOptions="Center" 
                                           HorizontalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontAttributes="Bold" Text="{Binding Reserved}" />
                                                <Span Text=" / " />
                                                <Span FontAttributes="Bold" Text="{Binding Process}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    
                                    <Label Grid.Column="5" 
                                           FontSize="13" 
                                           FontAttributes="Bold"
                                           Text="{Binding Quantity}" 
                                           TextColor="#333333" 
                                           VerticalOptions="Center" 
                                           HorizontalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

            </Grid>

            <!--  Tareas  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsTasksView}"
                RowDefinitions="auto,auto,*"
                RowSpacing="10">

                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    Margin="0,0,0,20"
                    FontSize="32"
                    HorizontalOptions="Start"
                    Text="Tareas"
                    TextColor="#79280F"
                    VerticalOptions="Start" />
                    
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,30"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Lista de opciones compacta -->
                <StackLayout Grid.Row="2" Spacing="20" HorizontalOptions="Start" MaximumWidthRequest="800">
                    <!-- Administrar tareas -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="add_stock_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ManagementTasks" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Administrar tareas"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ManagementTasks" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Crear Tarea -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="new_movement_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CreateTask" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Crear Tarea"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CreateTask" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                </StackLayout>
            </Grid>

            <!--  Crear Tareas  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                IsVisible="{Binding IsCreateTaskView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="12">

                <Label
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Nueva Tarea"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Layout horizontal optimizado para landscape -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="*">
                    
                    <!-- Panel izquierdo: Búsqueda y selección de producto -->
                    <StackLayout Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
                        <!-- Búsqueda compacta -->
                        <Label Text="Buscar productos" FontSize="16" TextColor="#79280F" FontAttributes="Bold"/>
                        <Frame
                            Padding="12"
                            HeightRequest="50"
                            BackgroundColor="White"
                            BorderColor="#79280F"
                            CornerRadius="8"
                            HasShadow="True">
                            <SearchBar
                                x:Name="SearchBarNewTask"
                                BackgroundColor="Transparent"
                                CancelButtonColor="#79280F"
                                Focused="SearchBar_NewTaskFocused"
                                HeightRequest="40"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"
                                Placeholder="Buscar producto para tarea"
                                PlaceholderColor="#999999"
                                TextChanged="OnNewTaskTextChanged"
                                TextColor="#333333"
                                FontSize="15"
                                Unfocused="SearchBar_NewTaskUnfocused" />
                        </Frame>

                        <!-- Lista de productos compacta -->
                        <Label Text="Productos disponibles" FontSize="16" TextColor="#79280F" FontAttributes="Bold"/>
                        <Frame
                            x:Name="FrameListNewTask"
                            Padding="8"
                            BackgroundColor="White"
                            BorderColor="#79280F"
                            CornerRadius="10"
                            IsVisible="{Binding IsVisibleListNewTask}"
                            HeightRequest="160"
                            HorizontalOptions="Fill">
                            <CollectionView
                                x:Name="ProductsNewTask"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding ProductsWithStock}"
                                SelectionChanged="CollectionNewTask_SelectionChanged"
                                SelectionMode="Single"
                                VerticalOptions="Fill"
                                BackgroundColor="Transparent">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="6" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductStock">
                                        <Frame
                                            Padding="8"
                                            Margin="2"
                                            BackgroundColor="#F8F8F8"
                                            BorderColor="#E0E0E0"
                                            CornerRadius="6"
                                            HasShadow="False">
                                            <Grid
                                                ColumnDefinitions="80,*,80"
                                                ColumnSpacing="10"
                                                RowDefinitions="auto"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    Text="{Binding Id}"
                                                    TextColor="#333333"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="14"
                                                    Text="{Binding Product.Description}"
                                                    TextColor="#333333"
                                                    VerticalOptions="Center"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Grid.Column="2"
                                                    FontSize="13"
                                                    Text="{Binding Product.WoodState}"
                                                    TextColor="#666666"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                        <Label
                                            FontSize="15"
                                            FontAttributes="Italic"
                                            HorizontalOptions="Center"
                                            Text="🔍 No se encontraron productos"
                                            TextColor="#999999"
                                            Padding="15"
                                            VerticalOptions="Center"
                                            HorizontalTextAlignment="Center" />
                                    </StackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Frame>

                        <!-- Información del producto selecciónado compacta -->
                        <Frame IsVisible="{Binding IsSelectedProductTask}"
                               BackgroundColor="White"
                               BorderColor="#79280F"
                               CornerRadius="8"
                               HasShadow="True"
                               Padding="15">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="54">
                                
                                <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,auto,auto,auto" ColumnSpacing="24" RowSpacing="6">
                                    
                                    <Label Grid.Row="1" Text="Código:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="1"  Grid.Column="1" Text="{Binding ProductTask.Id}" FontSize="15" HorizontalOptions="Start" TextColor="#000000" />
                                    
                                    <Label Grid.Row="2" Text="Descripción:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProductTask.Product.Description}" 
                                           FontSize="15" TextColor="#000000" LineBreakMode="TailTruncation" />
                                    
                                    <Label Grid.Row="3" Text="Estado:" FontSize="15" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding ProductTask.Product.WoodState}" FontSize="15" TextColor="#000000" />
                                </Grid>
                                
                                <!-- Stock info en una línea -->
                                <Grid Grid.Column="1" RowDefinitions="*,*,*" ColumnDefinitions="auto,*" ColumnSpacing="8">
                                    <Label Text="Disponible:" FontSize="15" FontAttributes="Bold" TextColor="#79280F"  />
                                    <Label Grid.Column="1" Text="{Binding ProductTask.Available}" FontSize="15" TextColor="#000000"  />

                                    <Label Grid.Row="1" Text="Reserva/Proceso:" FontSize="15" FontAttributes="Bold" TextColor="#79280F"  />
                                        <Label Grid.Row="1" Grid.Column="1" FontSize="15" TextColor="#000000" >
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ProductTask.Reserved}" />
                                                    <Span Text="/" />
                                                    <Span Text="{Binding ProductTask.Process}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    
                                    <Label Grid.Row="2" Text="Total:" FontSize="15" FontAttributes="Bold" TextColor="#79280F"  />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProductTask.Quantity}" FontSize="15" TextColor="#000000"  />
                                    
                                </Grid>
                            </Grid>
                        </Frame>

                        <Label IsVisible="{Binding IsSelectedProductTask,Converter = { StaticResource InvertedBoolConverter }}" 
                               TextColor="#79280F" FontSize="14" Text="Seleccione un producto para crear una tarea"
                               HorizontalTextAlignment="Center" />
                                <StackLayout Spacing="15">
                            
                            <!-- Fila 1: Prioridad y Cantidad en horizontal -->
                            <Grid IsVisible="{Binding IsSelectedProductTask}" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="auto">
                                <!-- Prioridad -->
                                <StackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="¿Dar prioridad?" 
                                           TextColor="#79280F"
                                           FontSize="15" 
                                           FontAttributes="Bold"/>
                                    <StackLayout Orientation="Horizontal" Spacing="15">
                                        <RadioButton
                                            Content="No"
                                            GroupName="PriorityType"
                                            IsChecked="{Binding IsNoPriorityTask}"
                                            TextColor="#79280F"
                                            FontSize="15"
                                            Value="no" />
                                        <RadioButton
                                            Content="Sí"
                                            TextColor="#79280F"
                                            FontSize="15"
                                            GroupName="PriorityType"
                                            IsChecked="{Binding IsYesPriorityTask}"
                                            Value="yes" />
                                    </StackLayout>
                                </StackLayout>

                                <!-- Cantidad -->
                                <StackLayout Grid.Column="1" Spacing="8">
                                    <Label
                                        Text="Cantidad a procesar"
                                        TextColor="#79280F"
                                        FontSize="15"
                                        FontAttributes="Bold" />
                                <Frame
                                        Padding="12"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="50"
                                        HasShadow="True"
                                        HorizontalOptions="Start">
                                    <Entry
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding QuantityTask}"
                                        TextColor="Black"
                                        FontSize="15"
                                        Keyboard="Numeric"                                        
                                        BackgroundColor="Transparent"
                                        Placeholder="Ingrese cantidad"
                                        HorizontalOptions="Start"
                                        HeightRequest="35" />
                                        </Frame>
                                </StackLayout>
                            </Grid>

                            <!-- Producto final en una línea -->
                            <Grid IsVisible="{Binding IsSelectedProductTask}" ColumnDefinitions="150,*" ColumnSpacing="15" RowDefinitions="auto,auto">
                                <Label Grid.Column="0"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Text="Producto final:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center" />

                                <Frame Grid.Column="1"
                                    Padding="12"
                                    BackgroundColor="White"
                                    BorderColor="#79280F"
                                    CornerRadius="8"
                                    HeightRequest="50"
                                    HasShadow="True"
                                    HorizontalOptions="Fill">
                                    <Label
                                        FontSize="15"
                                        TextColor="Black"
                                        Text="{Binding SelectedDerivateProducts, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Fill" >
        <Label.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding SelectProductDerivateTaskCommand}" />
        </Label.GestureRecognizers>
    </Label>
                                </Frame>

                                <Frame Grid.Row="1" Grid.ColumnSpan="2"
                                    CornerRadius="8"
                                    HeightRequest="120"
                                    IsVisible="{Binding IsVisibleListProductsDerivateTask}"
                                    Padding="10"
                                    BorderColor="#79280F"
                                    HasShadow="True"
                                    HorizontalOptions="Fill">
                                    <Frame.Background>
                                        <LinearGradientBrush EndPoint="0,1">
                                            <GradientStop Offset="0.1" Color="#FFFFFF" />
                                            <GradientStop Offset="1.0" Color="#FFF6ED" />
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <CollectionView
                                        x:Name="ProductListDerivateTask"
                                        HeightRequest="100"
                                        HorizontalOptions="Fill"
                                        ItemsSource="{Binding DerivateProducts}"
                                        SelectionChanged="ProductDerivate_SelectionChanged"
                                        SelectionMode="Single"
                                        VerticalOptions="Fill">

                                        <CollectionView.ItemsLayout>
                                            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="3" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:Product">
                                                <Frame
                                                    BackgroundColor="White"
                                                    BorderColor="#E0E0E0"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="2"
                                                    HasShadow="False">
                                                    <Label
                                                        FontSize="14"
                                                        Text="{Binding .}"
                                                        TextColor="#333333"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Start" />
                                                </Frame>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Frame>
                            </Grid>

                            <!-- Comentarios compactos -->
                            <Grid IsVisible="{Binding IsSelectedProductTask}" ColumnDefinitions="150,*" ColumnSpacing="15" RowDefinitions="auto">
                                <Label Grid.Column="0"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Text="Comentarios:"
                                    TextColor="#79280F"
                                    VerticalOptions="Start" />

                                <Frame Grid.Column="1"
                                    Padding="12"
                                    BackgroundColor="White"
                                    BorderColor="#79280F"
                                    CornerRadius="8"
                                    HeightRequest="80"
                                    HasShadow="True"
                                    HorizontalOptions="Fill">
                                    <Editor
                                        AutoSize="TextChanges"
                                        FontSize="15"
                                        Margin="0"
                                        HeightRequest="60"
                                        HorizontalOptions="Fill"
                                        Text="{Binding CommentsTask}"
                                        TextColor="Black"
                                        BackgroundColor="Transparent"
                                        Placeholder="Comentarios adicionales..."
                                        VerticalOptions="Fill" />
                                </Frame>
                            </Grid>
                        </StackLayout>
                   
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="0,10,0,0"
                    Color="#79280F" />

                <!-- Botones optimizados para horizontal -->
                <Grid
                    Grid.Row="4"
                    Margin="0,12,0,5"
                    ColumnDefinitions="*,180,180,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <ActivityIndicator
            HeightRequest="32"
            Grid.ColumnSpan="4"
            HorizontalOptions="CenterAndExpand"
            IsRunning="True"
            Color="#4A744C"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="CenterAndExpand"
            WidthRequest="32" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#D3AA84"
                        Clicked="CreateTask_Clicked"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        HeightRequest="45"
                        Text="Crear Tarea"
                        TextColor="#000000"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelCreateTaskCommand}"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        HeightRequest="45"
                        Text="Cancelar"
                        TextColor="#79280F"
                        FontSize="16"
                        FontAttributes="Bold"
                        BorderColor="#79280F"
                        BorderWidth="2"
                        CornerRadius="8" />
                </Grid>

            </Grid>

            <!--  Historial de Tareas  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsHistoryOfTaskView}"
                RowDefinitions="auto,auto,auto,*"
                RowSpacing="12">

                <!-- Título y búsqueda en la misma fila para tablets -->
                <Grid Grid.Row="0" ColumnDefinitions="auto,*" ColumnSpacing="20" Margin="0,0,0,10">
                    <Label
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        Text="Historial de Tareas"
                        TextColor="#79280F"
                        VerticalOptions="Center" />
                    
                    <Frame
                        Grid.Column="1"
                        Padding="0"
                        HeightRequest="32"
                        BackgroundColor="Transparent"
                        BorderColor="#797979"
                        CornerRadius="8"
                        MaximumWidthRequest="400">
                        <SearchBar
                            x:Name="SearchBarTask"
                            BackgroundColor="Transparent"
                            CancelButtonColor="#79280F"
                            Placeholder="Buscar tareas..."
                            HeightRequest="28"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            FontSize="13"
                            TextChanged="OnSearchTaskTextChanged"
                            TextColor="#333333"
                            PlaceholderColor="#999999" />
                    </Frame>
                </Grid>

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Encabezados ultra-compactos para landscape -->
                <Frame Grid.Row="2" 
                       Margin="0,0,0,8"
                       Padding="0"
                       BackgroundColor="#F5F5F5"
                       CornerRadius="8"
                       HasShadow="False">
                    <Grid ColumnDefinitions="1.2*,2.2*,1*,2.2*,1.3*,1.3*,0.8*,0.8*" 
                          ColumnSpacing="8" 
                          Padding="12,8,12,6">
                        <Label Text="Código" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" 
                               Text="Producto Inicial" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Start"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2" 
                               Text="Cant." 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" 
                               Text="Producto Final" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Start"
                               VerticalOptions="Center" />
                        <Label Grid.Column="4" 
                               Text="Estado" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="5" 
                               Text="Fecha" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="6" 
                               Text="Ver" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="7" 
                               Text="Edit" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#79280F" 
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Lista de tareas ultra-optimizada -->
                <Frame Grid.Row="3" 
                       Margin="0,0,0,0" 
                       Padding="8" 
                       BackgroundColor="#FAFAFA" 
                       CornerRadius="12" 
                       HasShadow="False"
                       VerticalOptions="FillAndExpand">
                    <CollectionView
                        x:Name="TaskItemsSearch"
                        ItemsSource="{Binding TaskItems}"
                        SelectionMode="Single"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Default"
                        BackgroundColor="Transparent">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskItem">
                                <Frame
                                    Padding="8,6"
                                    Margin="0,2"
                                    BackgroundColor="White"
                                    MinimumHeightRequest="36"
                                    BorderColor="#E8E8E8"
                                    CornerRadius="8"
                                    HasShadow="False">
                                    <Grid
                                        ColumnDefinitions="1.2*,2.2*,1*,2.2*,1.3*,1.3*,0.8*,0.8*"
                                        ColumnSpacing="8"
                                        VerticalOptions="Center">
                                        
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Id}"
                                            TextColor="#000000"
                                            HorizontalTextAlignment="Center"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{Binding ProductSource}"
                                            TextColor="#000000"
                                            HorizontalTextAlignment="Start"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="12"
                                            Text="{Binding Quantity}"
                                            TextColor="#000000"
                                            HorizontalTextAlignment="Center"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="3"
                                            FontSize="12"
                                            Text="{Binding ProductDestination}"
                                            TextColor="#000000"
                                            HorizontalTextAlignment="Start"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Grid.Column="4"
                                            FontSize="11"
                                            Text="{Binding TaskStatus}"
                                            TextColor="#666666"
                                            HorizontalTextAlignment="Center"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Grid.Column="5"
                                            FontSize="11"
                                            Text="{Binding CreatedAt, StringFormat='{0:dd/MM}'}"
                                            TextColor="#666666"
                                            HorizontalTextAlignment="Center"
                                            VerticalOptions="Center" />

                                        <Button
                                            Grid.Column="6"
                                            BackgroundColor="Transparent"
                                            Clicked="VisivilityTaskItem_Clicked"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            ImageSource="visibility.png"
                                            HeightRequest="28"
                                            WidthRequest="28"
                                            Padding="4"
                                            CornerRadius="14" />
                                            
                                        <Button
                                            Grid.Column="7"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Clicked="VisivilityTaskItemEdit_Clicked"
                                            ImageSource="edit_operators.png"
                                            HeightRequest="28"
                                            WidthRequest="28"
                                            Padding="4"
                                            CornerRadius="14" />

                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <StackLayout 
                                Spacing="15" 
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Padding="40">
                                <Image 
                                    Source="no_data_icon.png" 
                                    HeightRequest="64" 
                                    WidthRequest="64"
                                    HorizontalOptions="Center"
                                    Opacity="0.6" />
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    Text="No hay tareas disponibles"
                                    TextColor="#999999"
                                    FontAttributes="Italic"
                                    HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Frame>

            </Grid>

            <!--  Editar Tarea  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                IsVisible="{Binding IsTaskItemEditView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="12">

                <Label
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Editar Tarea"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Layout horizontal optimizado para landscape -->
                <Grid Grid.Row="2" ColumnDefinitions="1.8*,1*" ColumnSpacing="20" RowDefinitions="*">
                    
                    <!-- Panel izquierdo: Búsqueda y selección de producto -->
                    <StackLayout Grid.Column="0" Spacing="12">
                       <Frame
                        IsVisible="False"
                            Padding="10,-2,10,-2"
                            HeightRequest="42"
                            BackgroundColor="LightGray"
                            BorderColor="Transparent"
                            CornerRadius="24"
                            MaximumWidthRequest="450">
                            <SearchBar
                                x:Name="SearchBarEditTask"
                                BackgroundColor="Transparent"
                                CancelButtonColor="#79280F"
                                Placeholder="Buscar producto..."
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"
                                FontSize="14"
                                Focused="SearchBar_EditTaskFocused"
                                TextChanged="OnEditTaskTextChanged"
                                TextColor="#333333"
                                PlaceholderColor="#999999"
                                Unfocused="SearchBar_EditTaskUnfocused" />
                        </Frame>

                        <!-- Lista de productos compacta -->
                        <Frame
                            x:Name="FrameListEditTask"
                            Padding="8"
                            BackgroundColor="#FAFAFA"
                            CornerRadius="12"
                            HasShadow="False"
                            HeightRequest="180"
                            IsVisible="False">
                            <CollectionView
                                x:Name="ProductsEditTask"
                                ItemsSource="{Binding ProductsWithStock}"
                                SelectionChanged="CollectionEditTask_SelectionChanged"
                                SelectionMode="Single"
                                VerticalOptions="FillAndExpand"
                                VerticalScrollBarVisibility="Default">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="4" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductStock">
                                        <Grid ColumnDefinitions="1.2*,2.5*,1.3*" ColumnSpacing="12" Padding="8,6" RowDefinitions="auto">
                                            <Label FontSize="13" Text="{Binding Id}" TextColor="#333333" VerticalOptions="Center" />
                                            <Label Grid.Column="1" FontSize="13" Text="{Binding Product.Description}" TextColor="#333333" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" FontSize="13" Text="{Binding Product.WoodState}" TextColor="#333333" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label FontSize="14" HorizontalOptions="Center" Text="No se encontraron productos" TextColor="#666666" VerticalOptions="Center" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Frame>
                        <!-- Información del producto selecciónado compacta -->
                        <Frame IsVisible="{Binding IsSelectedProductTask}"
                               Padding="15"
                               BackgroundColor="White"
                               BorderColor="#79280F"
                               CornerRadius="8"
                               HasShadow="True">
                            <Grid ColumnDefinitions="1.2*,1.3*,1*,1.2*,1*" ColumnSpacing="10" RowDefinitions="auto,auto,auto,auto" RowSpacing="10">
                                <!-- Encabezados primera fila -->
                                <Label FontSize="14" Text="Código" TextColor="#79280F" FontAttributes="Bold" />
                                <Label Grid.Column="1" FontSize="14" Text="Estado" TextColor="#79280F" FontAttributes="Bold" />
                                <Label Grid.Column="2" FontSize="14" Text="Disponible" TextColor="#79280F" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3" FontSize="14" Text="Reserva/Proceso" TextColor="#79280F" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="4" FontSize="14" Text="Total" TextColor="#79280F" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                
                                <!-- Datos primera fila -->
                                <Label Grid.Row="1" FontSize="15" Text="{Binding ProductTask.Id}" TextColor="Black" />
                                <Label Grid.Row="1" Grid.Column="1" FontSize="15" Text="{Binding ProductTask.Product.WoodState}" TextColor="Black" />
                                <Label Grid.Row="1" Grid.Column="2" FontSize="15" Text="{Binding ProductTask.Available}" TextColor="Black" HorizontalTextAlignment="Center" />
                                <Label Grid.Row="1" Grid.Column="3" FontSize="15" TextColor="Black" HorizontalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ProductTask.Reserved}" />
                                            <Span Text="/" />
                                            <Span Text="{Binding ProductTask.Process}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="1" Grid.Column="4" FontSize="15" Text="{Binding ProductTask.Quantity}" TextColor="Black" HorizontalTextAlignment="Center" />
                                
                                <!-- Encabezado descripción -->
                                <Label Grid.Row="2" Grid.ColumnSpan="5" FontSize="14" Text="Descripción" TextColor="#79280F" FontAttributes="Bold" Margin="0,10,0,5" />
                                
                                <!-- Descripción del producto -->
                                <Label Grid.Row="3" Grid.ColumnSpan="5" FontSize="15" Text="{Binding ProductTask.Product.Description}" TextColor="Black" Margin="0,2,0,0" LineBreakMode="WordWrap" />
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Panel derecho: Formulario de edición -->
                    <StackLayout Grid.Column="1" Spacing="15">
                        <!-- Prioridad y Cantidad en línea horizontal -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="auto">
                            <Frame Grid.Column="0" Padding="15" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HasShadow="True">
                                <StackLayout Spacing="10">
                                    <Label Text="¿Dar prioridad?" FontSize="16" TextColor="#79280F" FontAttributes="Bold" />
                                    <StackLayout Orientation="Horizontal" Spacing="15">
                                        <RadioButton Content="No" GroupName="PriorityTypeEdit" IsChecked="{Binding IsNoPriorityTask}" TextColor="Black" FontSize="14" Value="no" />
                                        <RadioButton Content="Sí" GroupName="PriorityTypeEdit" IsChecked="{Binding IsYesPriorityTask}" TextColor="Black" FontSize="14" Value="si" />
                                    </StackLayout>
                                </StackLayout>
                            </Frame>
                            
                            <Frame Grid.Column="1" Padding="15" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HasShadow="True">
                                <StackLayout Spacing="10">
                                    <Label Text="Cantidad" FontSize="16" TextColor="#79280F" FontAttributes="Bold" />
                                    <Frame Padding="12" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HeightRequest="45" HasShadow="True">
                                        <Entry Text="{Binding QuantityTask}" TextColor="Black" FontSize="15" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                    </Frame>
                                </StackLayout>
                            </Frame>
                        </Grid>

                        <!-- Producto final -->
                        <StackLayout Spacing="10">
                            <Label Text="Producto final" FontSize="16" TextColor="#79280F" FontAttributes="Bold" />
                            <Frame Padding="15" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HasShadow="True" HeightRequest="50">
                                <Label FontSize="15" Text="{Binding SelectedDerivateProducts, Mode=TwoWay}" TextColor="Black" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectProductDerivateTaskCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                            
                            <!-- Lista de productos derivados -->
                            <Frame IsVisible="{Binding IsVisibleListProductsDerivateTask}"
                                   Padding="10"
                                   BackgroundColor="White"
                                   BorderColor="#79280F"
                                   CornerRadius="8"
                                   HasShadow="True"
                                   HeightRequest="120">
                                <CollectionView x:Name="ProductListDerivateEditTask"
                                              ItemsSource="{Binding DerivateProducts}"
                                              SelectionChanged="ProductDerivateEdit_SelectionChanged"
                                              SelectionMode="Single">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="6" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Product">
                                            <Frame
                                                BackgroundColor="#F8F8F8"
                                                BorderColor="#E0E0E0"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="2"
                                                HasShadow="False">
                                                <Label FontSize="15" Text="{Binding .}" TextColor="#333333" VerticalOptions="Center" />
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>
                        </StackLayout>

                        <!-- Comentarios -->
                        <StackLayout Spacing="10">
                            <Label Text="Comentarios" FontSize="16" TextColor="#79280F" FontAttributes="Bold" />
                            <Frame Padding="15" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HasShadow="True" HeightRequest="100">
                                <Editor AutoSize="TextChanges" FontSize="15" HeightRequest="80" Text="{Binding CommentsTask}" TextColor="Black" BackgroundColor="Transparent" Placeholder="Comentarios adicionales..." />
                            </Frame>
                        </StackLayout>
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="0,10,0,0"
                    Color="#79280F" />

                <!-- Botones optimizados para horizontal -->
                <Grid
                    Grid.Row="4"
                    Margin="0,12,0,5"
                    ColumnDefinitions="*,180,180,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <ActivityIndicator
            HeightRequest="32"
            Grid.ColumnSpan="4"
            HorizontalOptions="CenterAndExpand"
            IsRunning="True"
            Color="#4A744C"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="CenterAndExpand"
            WidthRequest="32" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#79280F"
                        Clicked="EditTask_Clicked"
                        HeightRequest="45"
                        Text="Editar Tarea"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#FFF6ED"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Command="{Binding CancelEditTaskCommand}"
                        HeightRequest="45"
                        Text="Cancelar"
                        TextColor="#79280F"
                        FontSize="16"
                        FontAttributes="Bold"
                        BorderColor="#79280F"
                        BorderWidth="2"
                        CornerRadius="8" />
                </Grid>

            </Grid>

            <!--  Ver Tarea  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsTaskItemView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="12">

                <Label
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Ver Tarea"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Layout horizontal optimizado para landscape -->
                <Grid Grid.Row="2" ColumnDefinitions="1.8*,1*" ColumnSpacing="20" RowDefinitions="*">
                    
                    <!-- Panel izquierdo: Información del producto -->
                    <StackLayout Grid.Column="0" Spacing="12">
                        <!-- Información del producto selecciónado compacta -->
                        <Frame IsVisible="{Binding IsSelectedProductTask}"
                               Padding="15"
                               BackgroundColor="White"
                               BorderColor="#79280F"
                               CornerRadius="8"
                               HasShadow="True">
                            <Grid ColumnDefinitions="1.2*,1.3*,1*,1.2*,1*" ColumnSpacing="10" RowDefinitions="auto,auto,auto,auto" RowSpacing="10">
                                <!-- Encabezados -->
                                <Label Grid.Row="0" Grid.Column="0" FontSize="16" FontAttributes="Bold" Text="Código" TextColor="#79280F" />
                                <Label Grid.Row="0" Grid.Column="1" FontSize="16" FontAttributes="Bold" Text="Estado" TextColor="#79280F" />
                                <Label Grid.Row="0" Grid.Column="2" FontSize="16" FontAttributes="Bold" Text="Disponible" TextColor="#79280F" HorizontalTextAlignment="Center" />
                                <Label Grid.Row="0" Grid.Column="3" FontSize="16" FontAttributes="Bold" Text="Reserva/Proceso" TextColor="#79280F" HorizontalTextAlignment="Center" />
                                <Label Grid.Row="0" Grid.Column="4" FontSize="16" FontAttributes="Bold" Text="Total" TextColor="#79280F" HorizontalTextAlignment="Center" />
                                
                                <!-- Datos -->
                                <Label Grid.Row="1" Grid.Column="0" FontSize="16" Text="{Binding ProductTask.Id}" TextColor="#000000" />
                                <Label Grid.Row="1" Grid.Column="1" FontSize="16" Text="{Binding ProductTask.Product.WoodState}" TextColor="#000000" />
                                <Label Grid.Row="1" Grid.Column="2" FontSize="16" Text="{Binding ProductTask.Available}" TextColor="#000000" HorizontalTextAlignment="Center" />
                                <Label Grid.Row="1" Grid.Column="3" FontSize="16" TextColor="#000000" HorizontalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ProductTask.Reserved}" />
                                            <Span Text="/" />
                                            <Span Text="{Binding ProductTask.Process}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="1" Grid.Column="4" FontSize="16" Text="{Binding ProductTask.Quantity}" TextColor="#000000" HorizontalTextAlignment="Center" />
                                
                                <!-- Encabezado de descripción -->
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" FontSize="16" FontAttributes="Bold" Text="Descripción" TextColor="#79280F" Margin="0,10,0,5" />
                                
                                <!-- Descripción completa -->
                                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" FontSize="16" Text="{Binding ProductTask.Product.Description}" TextColor="#000000" LineBreakMode="WordWrap" />
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Panel derecho: Información adicional de la tarea -->
                    <StackLayout Grid.Column="1" Spacing="15">
                        <!-- Prioridad y Cantidad -->
                        <StackLayout Spacing="15">
                            <Frame Padding="15" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HasShadow="True">
                                <StackLayout Orientation="Horizontal" Spacing="15">
                                    <Label Text="¿Dar prioridad?" FontSize="16" FontAttributes="Bold" TextColor="#79280F" VerticalOptions="Center" />
                                    <Label Text="{Binding SelectedTaskItem.Priority, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Sí|No'}" FontSize="16" TextColor="#000000" VerticalOptions="Center" />
                                </StackLayout>
                            </Frame>
                            
                            <Frame Padding="15" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HasShadow="True">
                                <StackLayout Orientation="Horizontal" Spacing="15">
                                    <Label Text="Cantidad:" FontSize="16" FontAttributes="Bold" TextColor="#79280F" VerticalOptions="Center" />
                                    <Label Text="{Binding QuantityTask}" FontSize="16" TextColor="#000000" VerticalOptions="Center" />
                                </StackLayout>
                            </Frame>
                        </StackLayout>

                        <!-- Producto final -->
                        <StackLayout Spacing="10">
                            <Label Text="Producto final:" FontSize="16" FontAttributes="Bold" TextColor="#79280F" />
                            <Frame Padding="15" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HasShadow="True" HeightRequest="50">
                                <Label FontSize="15" Text="{Binding SelectedDerivateProducts, Mode=TwoWay}" TextColor="Black" VerticalOptions="Center" LineBreakMode="WordWrap" />
                            </Frame>
                        </StackLayout>

                        <!-- Comentarios -->
                        <StackLayout Spacing="10">
                            <Label Text="Comentarios:" FontSize="16" FontAttributes="Bold" TextColor="#79280F" />
                            <Frame Padding="15" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HasShadow="True" HeightRequest="120" VerticalOptions="FillAndExpand">
                                <Label FontSize="15" Text="{Binding CommentsTask}" TextColor="Black" LineBreakMode="WordWrap" VerticalOptions="Start" />
                            </Frame>
                        </StackLayout>
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="0,10,0,0"
                    Color="#79280F" />

                <!-- Botónes optimizados para horizontal -->
                <Grid
                    Grid.Row="4"
                    Margin="0,12,0,5"
                    ColumnDefinitions="*,200,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#79280F"
                        Command="{Binding BackViewTaskCommand}"
                        HeightRequest="45"
                        Text="Volver"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="8"/>
                </Grid>


            </Grid>


            <!--  Reservas y Pedidos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsOrdersView}"
                RowDefinitions="auto,auto,*"
                RowSpacing="10">

                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    Margin="0,0,0,20"
                    FontSize="32"
                    HorizontalOptions="Start"
                    Text="Reservas y Pedidos"
                    TextColor="#79280F"
                    VerticalOptions="Start" />
                    
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,30"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Lista de opciones compacta -->
                <StackLayout Grid.Row="2" Spacing="20" HorizontalOptions="Start" MaximumWidthRequest="800">
                    <!-- Nuevo Pedido/Reserva -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="add_stock_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CreateBookingOrder" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Nuevo Pedido/Reserva"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CreateBookingOrder" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Lista de Reservas -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="new_movement_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ListBooking" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Lista de Reservas"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ListBooking" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Lista de Pedidos -->
                    <StackLayout Orientation="Horizontal" Spacing="25">
                        <Image
                            HeightRequest="50"
                            HorizontalOptions="Start"
                            Source="new_movement_icon_small.png"
                            WidthRequest="50"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ListOrders" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="Lista de Pedidos"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="250">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ListOrders" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                </StackLayout>
            </Grid>

            <!--  Crear reservas o pedidos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15"
                BackgroundColor="White"
                ColumnDefinitions="*,1.5*"
                ColumnSpacing="20"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                IsVisible="{Binding IsVisibleCreateBookingOrderView}"
                RowDefinitions="auto,auto,*,auto"
                RowSpacing="5"
                VerticalOptions="FillAndExpand">

                <!-- Título -->
                <Label
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Nueva reserva o pedido"
                    TextColor="#79280F"
                    VerticalOptions="Center" />
                
                <!-- Separador -->
                <BoxView
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Formulario principal compacto -->
                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="15"
                    RowDefinitions="auto,auto,auto,auto,auto"
                    RowSpacing="8">
                    
                    <!-- Tipo y Cliente -->
                    <StackLayout Grid.Column="0" Spacing="12" Grid.ColumnSpan="2">
                        <Label Text="Tipo:" FontSize="16" TextColor="#79280F" FontAttributes="Bold"/>
                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <RadioButton
                                Content="Reserva"
                                GroupName="BookingOrderType"
                                IsChecked="{Binding IsBooking}"
                                FontSize="14"
                                TextColor="Black"
                                Value="reserva" />
                            <RadioButton
                                Content="Pedido"
                                GroupName="BookingOrderType"
                                IsChecked="{Binding IsOrder}"
                                FontSize="14"
                                TextColor="Black"
                                Value="pedido" />
                        </StackLayout>
                        
                        <Label Text="Cliente" TextColor="#79280F" FontSize="16" FontAttributes="Bold"/>
                        <Frame Padding="10" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HeightRequest="50" HasShadow="True">
                            <Entry 
                                BackgroundColor="Transparent"
                                FontSize="15"
                                HeightRequest="40"
                                Placeholder="Nombre del cliente"
                                Text="{Binding ClientBookingOrder}"
                                TextColor="#333333"
                                VerticalOptions="Center"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False" />
                        </Frame>
                        
                        <Label Text="Fecha despacho" FontSize="16" TextColor="#79280F" FontAttributes="Bold"/>
                        <Frame Padding="10" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HeightRequest="50" HasShadow="True">
                        <DatePicker
                            Date="{Binding DateBookingOrder}"
                            TextColor="#333333"
                            HeightRequest="40"
                            FontSize="15"
                            VerticalOptions="Center" />
                        </Frame>
                        <Label Text="Dirección" FontSize="16" TextColor="#79280F" FontAttributes="Bold"/>
                        <Frame Padding="10" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HeightRequest="50" HasShadow="True">
                            <Entry
                                BackgroundColor="Transparent"
                                FontSize="15"
                                HeightRequest="40"
                                Placeholder="Dirección de entrega"
                                Text="{Binding AddressBookingOrder}"
                                TextColor="#333333"
                                VerticalOptions="Center"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False" />
                        </Frame>
                    <Label Text="Teléfono" FontSize="16" TextColor="#79280F" FontAttributes="Bold"/>
                        <Frame Padding="10" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HeightRequest="50" HasShadow="True">
                            <Entry
                                BackgroundColor="Transparent"
                                FontSize="15"
                                HeightRequest="40"
                                Placeholder="Número de teléfono"
                                Text="{Binding PhoneBookingOrder}"
                                TextColor="#333333"
                                VerticalOptions="Center"
                                Keyboard="Telephone"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False" />
                        </Frame>
                        
                        <Label Text="Envío" FontSize="16" TextColor="#79280F" FontAttributes="Bold" />
                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <RadioButton
                                Content="No"
                                GroupName="BookingOrderShipment"
                                IsChecked="{Binding IsNoShipmentTask}"
                                FontSize="14"
                                TextColor="Black"
                                Value="no" />
                            <RadioButton
                                Content="Sí"
                                GroupName="BookingOrderShipment"
                                IsChecked="{Binding IsShipmentTask}"
                                FontSize="14"
                                TextColor="Black"
                                Value="si" />
                        </StackLayout>
                        
                        
                    </StackLayout>
                </Grid>

                <!-- Panel de búsqueda y selección de productos -->
                <StackLayout
                    Grid.Row="2"
                    Grid.Column="1"
                    Spacing="8">
                    
                    <!-- Búsqueda de productos -->
                    <Label Text="Buscar productos" FontSize="16" TextColor="#79280F" FontAttributes="Bold"/>
                    <Frame Padding="12" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HeightRequest="50" HasShadow="True">
                        <SearchBar
                            x:Name="SearchBarAddProductsBookingOrder"
                            BackgroundColor="Transparent"
                            CancelButtonColor="#79280F"
                            Focused="SearchBarProductBookingOrder_Focused"
                            FontSize="15"
                            HeightRequest="40"
                            HorizontalOptions="FillAndExpand"
                            Placeholder="Buscar producto"
                            TextChanged="OnProductsBookingORderTextChanged"
                            TextColor="#333333"
                            VerticalOptions="Center"
                            Unfocused="SearchBarProductBookingOrder_Unfocused" />
                    </Frame>

                    <!-- Lista de productos disponibles -->
                    <Frame
                        x:Name="FrameListProductsBookingOrder"
                        Padding="8"
                        CornerRadius="10"
                        BackgroundColor="White"
                        BorderColor="#79280F"
                        HasShadow="True"
                        HeightRequest="120"
                        IsVisible="{Binding IsVisibleListProductsBookingOrders}">
                        <CollectionView
                            x:Name="ProductsBookingOrder"
                            HorizontalOptions="FillAndExpand"
                            ItemsSource="{Binding ProductsWithStock}"
                            SelectionChanged="CollectionProductsBookingOrder_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand"
                            BackgroundColor="Transparent">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="4" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductStock">
                                    <Frame
                                        Padding="8"
                                        Margin="2"
                                        BackgroundColor="#F8F8F8"
                                        BorderColor="#E0E0E0"
                                        CornerRadius="6"
                                        HasShadow="False">
                                        <Grid
                                            ColumnDefinitions="*"
                                            RowDefinitions="*"
                                            VerticalOptions="Center"
                                            ColumnSpacing="8">
                                            <Label FontSize="12" VerticalOptions="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Id}" FontAttributes="Bold" TextColor="#333333" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Product.Description}" TextColor="#333333" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Product.WoodState}" TextColor="#666666" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                                    <Label
                                        FontSize="14"
                                        FontAttributes="Italic"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="🔍 No se encontraron productos"
                                        TextColor="#999999"
                                        VerticalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Frame>
                    
                    <!-- Headers de productos selecciónados -->
                    <Frame Padding="12,8" BackgroundColor="#79280F" CornerRadius="8" HasShadow="True" Margin="0,15,0,8">
                        <Grid ColumnDefinitions="0.8*,1.5*,0.8*,1*,0.3*" ColumnSpacing="8">
                            <Label
                                FontSize="14"
                                Text="Código"
                                TextColor="White"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Descripción"
                                TextColor="White"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="14"
                                Text="Estado"
                                TextColor="White"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="3"
                                FontSize="14"
                                Text="Cantidad"
                                TextColor="White"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="4"
                                FontSize="14"
                                Text=""
                                TextColor="White"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                    
                    <!-- Lista de productos selecciónados -->
                    <Frame
                        Padding="8"
                        CornerRadius="10"
                        BackgroundColor="White"
                        BorderColor="#79280F"
                        HasShadow="True"
                        HeightRequest="200">
                        <CollectionView
                            ItemsSource="{Binding ProductsBookingOrder, Mode=TwoWay}"
                            SelectionMode="Single"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Default"
                            BackgroundColor="Transparent">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="5" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                                    <Label
                                        FontSize="15"
                                        FontAttributes="Italic"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="No se han seleccionado productos"
                                        TextColor="#999999"
                                        VerticalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductStock">
                                    <Frame
                                        Padding="8"
                                        Margin="2"
                                        BackgroundColor="#F8F8F8"
                                        BorderColor="#E0E0E0"
                                        CornerRadius="6"
                                        HasShadow="False">
                                        <Grid  
                                            ColumnDefinitions="0.8*,1.5*,0.8*,1*,0.3*"
                                            RowDefinitions="*"
                                            VerticalOptions="Center"
                                            ColumnSpacing="8">
                                            <Label
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                Text="{Binding Product.Id}"
                                                TextColor="#333333"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                FontSize="13"
                                                Text="{Binding Product.Description}"
                                                TextColor="#333333"
                                                VerticalOptions="Center"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Grid.Column="2"
                                                FontSize="12"
                                                Text="{Binding Product.WoodState}"
                                                TextColor="#666666"
                                                VerticalOptions="Center" />
                                            <Frame
                                                Grid.Column="3"
                                                Padding="5"
                                                BackgroundColor="White"
                                                BorderColor="#79280F"
                                                CornerRadius="6"
                                                HeightRequest="35"
                                                HorizontalOptions="Center"
                                                WidthRequest="80"
                                                HasShadow="False">
                                                <Entry
                                                    BackgroundColor="Transparent"
                                                    HeightRequest="30"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    Keyboard="Numeric"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{Binding QuantityBookingOrder, Mode=TwoWay}"
                                                    TextColor="#333333"
                                                    VerticalOptions="Center"
                                                    VerticalTextAlignment="Center"
                                                    IsSpellCheckEnabled="False"
                                                    IsTextPredictionEnabled="False" />
                                            </Frame>
                                            <Frame
                                                Grid.Column="4"
                                                Padding="3"
                                                BackgroundColor="#FFE6E6"
                                                BorderColor="#FFE6E6"
                                                CornerRadius="20"
                                                HeightRequest="30"
                                                WidthRequest="30"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                HasShadow="False">
                                                <ImageButton
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=RemoveProductToAddedBookingOrderCommand}"
                                                    CommandParameter="{Binding .}"
                                                    HeightRequest="20"
                                                    Source="delete_item_icon.png"
                                                    WidthRequest="20"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="Transparent" />
                                            </Frame>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Frame>
                    <Label Text="Comentarios" FontSize="16" TextColor="#79280F" FontAttributes="Bold"/>
                        <Frame Padding="10" BackgroundColor="White" BorderColor="#79280F" CornerRadius="8" HeightRequest="70" HasShadow="True">
                            <Entry
                                BackgroundColor="Transparent"
                                FontSize="15"
                                HeightRequest="60"
                                Placeholder="Comentarios adicionales"
                                Text="{Binding CommentsBookingOrder}"
                                TextColor="#333333"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Start"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False" />
                        </Frame>
                </StackLayout>

                <!-- Headers de productos selecciónados - Eliminar -->
                
                <!-- Lista de productos selecciónados - Eliminar -->

                <!-- Separador final y botónes -->
                <BoxView
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,8"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Grid
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,20,0,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="20"
                    HorizontalOptions="Center"
                    WidthRequest="500">
                    <ActivityIndicator
            HeightRequest="40"
            Grid.ColumnSpan="2"
            HorizontalOptions="CenterAndExpand"
            IsRunning="True"
            Color="#4A744C"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="CenterAndExpand"
            WidthRequest="40" />
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#79280F"
                        BorderColor="#79280F"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Clicked="CreateBookingOrder_Clicked"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="CREAR"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="15,5" />
                    <Button
                        Grid.Column="1"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#F5F5F5"
                        BorderColor="#CCCCCC"
                        Command="{Binding CancelCreateBookingOrderCommand}"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="CANCELAR"
                        TextColor="#666666"
                        CornerRadius="8"
                        Padding="15,5" />
                </Grid>

            </Grid>

            <!--  Historial de pedidos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="10,15,10,10"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsVisibleListOrdersView}"
                RowDefinitions="auto,auto,auto,*"
                RowSpacing="8">

                <!-- Título y búsqueda en la misma fila para tablets -->
                <Grid Grid.Row="0" ColumnDefinitions="auto,*" ColumnSpacing="20" Margin="0,0,0,10">
                    <Label
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        Text="Historial de Pedidos"
                        TextColor="#79280F"
                        VerticalOptions="Center" />
                    
                    <Frame
                        Grid.Column="1"
                        Padding="0"
                        HeightRequest="32"
                        BackgroundColor="Transparent"
                        BorderColor="#797979"
                        CornerRadius="8"
                        MaximumWidthRequest="400">
                        <SearchBar
                            x:Name="SearchBarOrder"
                            BackgroundColor="Transparent"
                            CancelButtonColor="#79280F"
                            Placeholder="Buscar pedido..."
                            HeightRequest="28"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            FontSize="13"
                            TextChanged="OnSearchOrderTextChanged"
                            TextColor="#333333"
                            PlaceholderColor="#999999" />
                    </Frame>
                </Grid>

