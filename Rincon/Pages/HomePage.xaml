                                        Command="{Binding CancelConfirmConfigurationCommand}"
                                        MinimumHeightRequest="35"
                                        MinimumWidthRequest="200"
                                        Text="Volver"
                                        TextColor="#FFF6ED" />
                                    <Button
                                        Margin="0,60,60,60"
                                        BackgroundColor="#79280F"
                                        Clicked="ConfirmChange_Clicked"
                                        MinimumHeightRequest="35"
                                        MinimumWidthRequest="200"
                                        Text="Confirmar Cambios"
                                        TextColor="White" />
                                </HorizontalStackLayout>
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>

