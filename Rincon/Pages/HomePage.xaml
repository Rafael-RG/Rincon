                                    Source="delete_item_icon.png"
                                    WidthRequest="15" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <BoxView
                    Grid.Row="4"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
