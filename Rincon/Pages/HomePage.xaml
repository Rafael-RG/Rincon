                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Product.Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding Product.Description}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="{Binding Product.WoodState}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

