                                    RowSpacing="10"
                                    VerticalOptions="FillAndExpand">
                                    <Label
                                        Margin="0,20,0,0"
                                        FontSize="16"
                                        Text="Nombre"
                                        TextColor="Black" />
                                    <Frame
                                        Grid.Column="1"
