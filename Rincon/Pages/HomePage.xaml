                            FontSize="18"
                            Text="Descripcion"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="2"
                            FontSize="18"
                            Text="Estado"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="3"
                            FontSize="18"
                            Text="Stock Disponible"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="4"
                            FontSize="18"
                            Text="Reserva / Proceso"
