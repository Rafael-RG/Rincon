                                    <Label
                                        Grid.Row="4"
                                        Margin="0,10,0,0"
                                        FontSize="16"
                                        Text="Respuesta"
                                        TextColor="Black" />
                                    <Frame
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,0,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding IsVisibleListQuestions, Converter={StaticResource InvertedBoolConverter}}"
                                        MinimumWidthRequest="200">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            MaxLength="25"
                                            MinimumWidthRequest="200"
