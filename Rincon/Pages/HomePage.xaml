                RowSpacing="5">
                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Movimientos"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />
                <Grid
                    Grid.Row="2"
                    Margin="30,0,0,40"
                    ColumnDefinitions="auto,*,auto"
                    ColumnSpacing="60"
                    RowDefinitions="auto,30,30,30">
                    <Frame
                        Grid.RowSpan="4"
                        Grid.ColumnSpan="3"
                        Margin="-10,-10,40,-10"
                        BackgroundColor="Transparent"
                        BorderColor="#79280F"
                        HorizontalOptions="FillAndExpand" />

                    <Label
                        Margin="0,0,0,10"
                        FontSize="30"
                        Text="Filtros"
                        TextColor="#79280F"
                        VerticalTextAlignment="Center" />

                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="40,0,0,6"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalOptions="End">
                        <Label
                            FontSize="16"
                            Text="Tipo de movimiento:"
                            TextColor="Black"
                            VerticalOptions="Center" />
                        <Picker
                            ItemsSource="{Binding MovementTypes}"
                            SelectedItem="{Binding SelectedFilterMovementType, Mode=TwoWay}"
                            TextColor="black"
                            WidthRequest="200" />
                    </StackLayout>

                    <StackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="40,0,0,6"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            FontSize="16"
                            Text="Producto:"
                            TextColor="Black"
                            VerticalOptions="Center" />
                        <Picker
                            ItemsSource="{Binding ProductsMovementsFilter}"
                            SelectedItem="{Binding SelectedFilterMovementProduct, Mode=TwoWay}"
                            TextColor="Black"
                            WidthRequest="300" />
                    </StackLayout>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="40,3,0,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Label
                            FontSize="16"
                            Text="Fecha del movimiento:"
                            TextColor="Black" />
                        <DatePicker
                            Date="{Binding SelectedFilterMovementDate}"
                            TextColor="Black"
                            WidthRequest="200" />
                    </StackLayout>

                    <StackLayout
                        Grid.RowSpan="4"
                        Grid.Column="2"
                        Margin="0,0,60,0"
                        Spacing="10"
                        VerticalOptions="CenterAndExpand">
                        <Button
                            BackgroundColor="#FFF6ED"
                            BorderColor="#79280F"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=ApplyFiltersMovementsCommand}"
                            FontSize="15"
                            HeightRequest="45"
                            Text="Aplicar filtros"
                            TextColor="#79280F"
                            WidthRequest="140" />
                        <Button
                            BackgroundColor="#FFF6ED"
                            BorderColor="#79280F"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=ClearFiltersMovementsCommand}"
                            FontSize="15"
                            HeightRequest="45"
                            Text="Limpiar filtros"
                            TextColor="#79280F"
                            WidthRequest="140" />
                    </StackLayout>

                </Grid>

                <Grid
                    Grid.Row="3"
                    Margin="30,0,0,0"
                    ColumnDefinitions="25*,25*,25*,25*">
                    <Label
                        FontSize="18"
                        Text="Fecha"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="Producto"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="Tipo de movimiento"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="Cantidad"
                        TextColor="#79280F" />
                </Grid>

                <CollectionView
                    x:Name="MovementsSearch"
                    Grid.Row="4"
                    Margin="30,20,0,0"
                    ItemsSource="{Binding MovementsFilter, Mode=TwoWay}"
