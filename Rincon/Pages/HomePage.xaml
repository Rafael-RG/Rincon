                                        Text="Apellido"
                                        TextColor="#79280F" />
                                    <Label
                                        Margin="165,0,0,0"
                                        FontSize="18"
                                        Text="Fecha de creacion"
                                        TextColor="#79280F" />
                                </HorizontalStackLayout>

                                <CollectionView
                                    Grid.Row="3"
                                    Margin="50,0,30,0"
                                    IsVisible="{Binding AnyOperators}"
                                    ItemsSource="{Binding Operators}"
                                    SelectionMode="None"
                                    VerticalOptions="FillAndExpand"
                                    VerticalScrollBarVisibility="Never">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Operator">
                                            <Grid
                                                ColumnDefinitions="260,234,180,140,*,60"
                                                RowDefinitions="*"
                                                VerticalOptions="Start">

                                                <Label
                                                    Grid.Column="0"
                                                    FontSize="18"
                                                    Text="{Binding Name}"
                                                    TextColor="#000000"
                                                    VerticalOptions="Start" />

                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="18"
                                                    Text="{Binding LastName}"
                                                    TextColor="#000000"
                                                    VerticalOptions="Start" />

                                                <Label
                                                    Grid.Column="2"
                                                    FontSize="18"
                                                    Text="{Binding CreateDate, StringFormat='{0:dd/MM/yyyy}'}"
                                                    TextColor="#000000"
                                                    VerticalOptions="Start" />

                                                <Button
                                                    Grid.Column="4"
                                                    BackgroundColor="Transparent"
                                                    Clicked="ViewEditOperator_Clicked"
                                                    HorizontalOptions="End"
                                                    ImageSource="edit_operators.png" />
                                                <Button
                                                    Grid.Column="5"
                                                    BackgroundColor="Transparent"
                                                    Clicked="ConfirmDeleteOperator_Clicked"
                                                    ImageSource="delete_item_icon.png" />

                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Label
                                    Grid.Row="3"
                                    Margin="30,30,30,0"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding AnyOperators, Converter={StaticResource InvertedBoolConverter}}"
                                    MinimumHeightRequest="200"
                                    Text="Aun no hay operadores"
                                    TextColor="Black"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />

                                <BoxView
                                    Grid.Row="4"
                                    Margin="0,0,0,0"
                                    HeightRequest="2"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="End"
                                    Color="#79280F" />

                                <Button
                                    Grid.Row="5"
                                    Margin="0,20,0,0"
                                    BackgroundColor="#AD6B2A"
                                    Command="{Binding CancelConfigurationCommand}"
                                    HeightRequest="45"
                                    Text="Volver"
                                    TextColor="#FFF6ED"
                                    VerticalOptions="EndAndExpand"
                                    WidthRequest="200" />

                            </Grid>
                        </Frame>
                    </Grid>

                    <!--  Add operator  -->
                    <Grid
                        ColumnDefinitions="25*,25*,25*,25*"
                        IsVisible="{Binding IsAddOperatorView}"
                        RowDefinitions="25*,25*,25*,25*"
                        VerticalOptions="FillAndExpand">
                        <Frame
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            BackgroundColor="#D3AA84"
                            CornerRadius="18">
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Label
                                    Margin="30,20,0,0"
                                    FontAttributes="Bold"
                                    FontSize="26"
                                    Text="Nuevo Operario"
                                    TextColor="Black" />
                                <Grid
                                    Margin="30,10,0,0"
                                    ColumnDefinitions="auto,auto"
                                    ColumnSpacing="100"
                                    HorizontalOptions="FillAndExpand"
                                    RowDefinitions="auto,auto,auto,auto,auto"
                                    VerticalOptions="FillAndExpand">
                                    <Label
                                        Margin="0,20,0,0"
                                        FontSize="16"
                                        Text="Nombre"
                                        TextColor="Black" />
                                    <Frame
                                        Grid.Column="1"
                                        Margin="0,20,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="200">
                                        <Entry
                                            BackgroundColor="White"
                                            HeightRequest="60"
                                            HorizontalOptions="Start"
                                            MaxLength="25"
                                            Placeholder="Nombre"
                                            PlaceholderColor="Black"
                                            Text="{Binding OperatorName}"
                                            TextColor="Black"
                                            WidthRequest="200" />
                                    </Frame>
                                    <Label
                                        Grid.Row="1"
                                        Margin="0,20,0,0"
                                        FontSize="16"
                                        Text="Apellido"
                                        TextColor="Black" />
                                    <Frame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,20,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="200">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            MaxLength="25"
                                            Placeholder="Apellido"
                                            PlaceholderColor="Black"
                                            Text="{Binding OperatorLastName}"
                                            TextColor="Black"
                                            WidthRequest="200" />
                                    </Frame>
                                    <Label
                                        Grid.Row="2"
                                        Margin="0,20,0,0"
                                        FontSize="16"
                                        Text="Pin"
                                        TextColor="Black" />
                                    <Frame
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,20,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="200">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            MaxLength="25"
                                            Placeholder="Escriba un PIN"
                                            PlaceholderColor="Black"
                                            Text="{Binding OperatorPin}"
                                            TextColor="Black"
                                            WidthRequest="200" />
                                    </Frame>

                                    <Frame
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,20,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="200">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            MaxLength="25"
                                            Placeholder="Confirme su PIN"
                                            PlaceholderColor="Black"
                                            Text="{Binding RepeatOperatorPin}"
                                            TextColor="Black"
                                            WidthRequest="200" />
                                    </Frame>

                                    <HorizontalStackLayout
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,30,0,0"
                                        HorizontalOptions="EndAndExpand"
                                        Spacing="30"
                                        VerticalOptions="EndAndExpand">
                                        <Button
                                            BackgroundColor="#AD6B2A"
                                            Command="{Binding CancelAddOperatorCommand}"
                                            HeightRequest="35"
                                            Text="Volver"
                                            TextColor="#FFF6ED"
                                            WidthRequest="200" />
                                        <Button
                                            BackgroundColor="#4A744C"
                                            Command="{Binding OkAddOperatorCommand}"
                                            HeightRequest="35"
                                            Text="Agregar"
                                            TextColor="White"
                                            WidthRequest="200" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </StackLayout>
                        </Frame>
                    </Grid>
                    <Grid
                        ColumnDefinitions="25*,25*,25*,25*"
                        IsVisible="{Binding ValidateAddOperator}"
                        RowDefinitions="10*,10*,20*,30*"
                        VerticalOptions="FillAndExpand">
                        <Frame
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            BackgroundColor="#FFF6ED"
                            CornerRadius="18">
                            <StackLayout>
                                <Label
                                    Margin="30,30,0,0"
                                    FontSize="26"
                                    Text="Identificacion"
                                    TextColor="Black" />
                                <Grid
                                    Margin="30,30,0,0"
                                    ColumnDefinitions="100,*"
                                    RowDefinitions="*,*"
                                    RowSpacing="20">
                                    <Label
                                        FontSize="16"
                                        Text="Usuario"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        WidthRequest="300">
                                        <Entry
                                            BackgroundColor="#D3AA84"
                                            HeightRequest="60"
                                            HorizontalOptions="Start"
                                            MaxLength="25"
                                            Placeholder="Nombre de usuario"
                                            PlaceholderColor="#848484"
                                            Text="{Binding ConfirmUserConfigurations}"
                                            TextColor="Black"
                                            WidthRequest="300" />
                                    </Frame>
                                    <Label
                                        Grid.Row="1"
                                        FontSize="16"
                                        Text="Contraseña"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="300">
                                        <Entry
                                            BackgroundColor="#D3AA84"
                                            HeightRequest="60"
                                            HorizontalOptions="Start"
                                            MaxLength="25"
                                            Placeholder="Contraseña"
                                            PlaceholderColor="#848484"
                                            Text="{Binding ConfirmPasswordConfigurations}"
                                            TextColor="Black"
                                            WidthRequest="300" />
                                    </Frame>
                                </Grid>
                                <HorizontalStackLayout
                                    HorizontalOptions="EndAndExpand"
                                    Spacing="30"
                                    VerticalOptions="EndAndExpand">
                                    <Button
                                        Margin="0,60,0,60"
                                        BackgroundColor="#AD6B2A"
                                        Command="{Binding CancelValidateAddOperatorCommand}"
                                        HeightRequest="35"
                                        Text="Volver"
                                        TextColor="#FFF6ED"
                                        WidthRequest="200" />
                                    <Button
                                        Margin="0,60,60,60"
                                        BackgroundColor="#79280F"
                                        Clicked="ConfirmAddOperator_Clicked"
                                        HeightRequest="35"
                                        Text="Aceptar"
                                        TextColor="White"
                                        WidthRequest="200" />
                                </HorizontalStackLayout>
                            </StackLayout>
                        </Frame>
                    </Grid>

                    <!--  Delete Operator  -->
                    <Frame
                        Margin="560,200,560,300"
                        BackgroundColor="#FFF6ED"
                        CornerRadius="18"
                        IsVisible="{Binding ValidateDeleteOperator}">
                        <StackLayout>
                            <Label
                                Margin="30,30,0,0"
                                FontSize="26"
                                Text="Identificacion"
                                TextColor="Black" />
                            <Grid
                                Margin="30,30,0,0"
                                ColumnDefinitions="100,*"
                                RowDefinitions="*,*"
                                RowSpacing="20">
                                <Label
                                    FontSize="16"
                                    Text="Usuario"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                                <Frame
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Padding="0,0,0,0"
                                    BackgroundColor="White"
                                    CornerRadius="18"
                                    HeightRequest="40"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    WidthRequest="300">
                                    <Entry
                                        BackgroundColor="#D3AA84"
                                        HeightRequest="60"
                                        HorizontalOptions="Start"
                                        MaxLength="25"
                                        Placeholder="Nombre de usuario"
                                        PlaceholderColor="#848484"
                                        Text="{Binding ConfirmUserConfigurations}"
                                        TextColor="Black"
                                        WidthRequest="300" />
                                </Frame>
                                <Label
                                    Grid.Row="1"
                                    FontSize="16"
                                    Text="Contraseña"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                                <Frame
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Padding="0,0,0,0"
                                    BackgroundColor="White"
                                    CornerRadius="18"
                                    HeightRequest="40"
                                    HorizontalOptions="Start"
                                    WidthRequest="300">
                                    <Entry
                                        BackgroundColor="#D3AA84"
                                        HeightRequest="60"
                                        HorizontalOptions="Start"
                                        MaxLength="25"
                                        Placeholder="Contraseña"
                                        PlaceholderColor="#848484"
                                        Text="{Binding ConfirmPasswordConfigurations}"
                                        TextColor="Black"
                                        WidthRequest="300" />
                                </Frame>
                            </Grid>
                            <HorizontalStackLayout
                                HorizontalOptions="EndAndExpand"
                                Spacing="30"
                                VerticalOptions="EndAndExpand">
                                <Button
                                    Margin="0,60,0,60"
                                    BackgroundColor="#AD6B2A"
                                    Command="{Binding CancelDeleteOperatorCommand}"
                                    HeightRequest="45"
                                    Text="Volver"
                                    TextColor="#FFF6ED"
                                    WidthRequest="200" />
                                <Button
                                    Margin="0,60,60,60"
                                    BackgroundColor="#79280F"
                                    Clicked="OkDeleteOperator_Clicked"
                                    HeightRequest="45"
                                    Text="Aceptar"
                                    TextColor="White"
                                    WidthRequest="200" />
                            </HorizontalStackLayout>
                        </StackLayout>
                    </Frame>

                    <!--  Edit Operator  -->
                    <Grid
                        ColumnDefinitions="25*,25*,25*,25*"
                        IsVisible="{Binding IsEditOperatorView}"
                        RowDefinitions="25*,25*,25*,25*"
                        VerticalOptions="FillAndExpand">
                        <Frame
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Padding="30"
                            BackgroundColor="#D3AA84"
                            CornerRadius="18">
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Label
                                    Margin="30,30,0,0"
                                    FontAttributes="Bold"
                                    FontSize="26"
                                    Text="Editar Operario"
                                    TextColor="Black" />
                                <Grid
                                    Margin="30,30,0,0"
                                    ColumnDefinitions="auto,*"
                                    ColumnSpacing="100"
                                    HorizontalOptions="FillAndExpand"
                                    RowDefinitions="auto,auto,auto,auto,auto"
                                    VerticalOptions="FillAndExpand">
                                    <Label
                                        Margin="0,20,0,0"
                                        FontSize="16"
                                        Text="Nombre"
                                        TextColor="Black" />
                                    <Frame
                                        Grid.Column="1"
                                        Margin="0,20,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="300">
                                        <Entry
                                            BackgroundColor="White"
                                            HeightRequest="60"
                                            HorizontalOptions="Start"
                                            MaxLength="25"
                                            Placeholder="Nombre"
                                            PlaceholderColor="Black"
                                            Text="{Binding OperatorName}"
                                            TextColor="Black"
                                            WidthRequest="300" />
                                    </Frame>
                                    <Label
                                        Grid.Row="1"
                                        Margin="0,20,0,0"
                                        FontSize="16"
                                        Text="Apellido"
                                        TextColor="Black" />
                                    <Frame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,20,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="300">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            MaxLength="25"
                                            Placeholder="Apellido"
                                            PlaceholderColor="Black"
                                            Text="{Binding OperatorLastName}"
                                            TextColor="Black"
                                            WidthRequest="300" />
                                    </Frame>
                                    <Label
                                        Grid.Row="2"
                                        Margin="0,20,0,0"
                                        FontSize="16"
                                        Text="Pin"
                                        TextColor="Black" />
                                    <Frame
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,20,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="300">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            MaxLength="25"
                                            Placeholder="Escriba un PIN"
                                            PlaceholderColor="Black"
                                            Text="{Binding OperatorPin}"
                                            TextColor="Black"
                                            WidthRequest="300" />
                                    </Frame>

                                    <Frame
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,20,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="300">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            MaxLength="25"
                                            Placeholder="Confirme su PIN"
                                            PlaceholderColor="Black"
                                            Text="{Binding RepeatOperatorPin}"
                                            TextColor="Black"
                                            WidthRequest="300" />
                                    </Frame>

                                    <HorizontalStackLayout
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,30,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Spacing="30"
                                        VerticalOptions="EndAndExpand">
                                        <Button
                                            BackgroundColor="#AD6B2A"
                                            Command="{Binding CancelAddOperatorCommand}"
                                            HeightRequest="35"
                                            Text="Volver"
                                            TextColor="#FFF6ED"
                                            WidthRequest="200" />
                                        <Button
                                            BackgroundColor="#4A744C"
                                            Command="{Binding OkValidateEditOperatorCommand}"
                                            HeightRequest="35"
                                            Text="Editar"
                                            TextColor="White"
                                            WidthRequest="200" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </StackLayout>
                        </Frame>
                    </Grid>
                    <Grid
                        ColumnDefinitions="25*,25*,25*,25*"
                        IsVisible="{Binding ValidateEditOperator}"
                        RowDefinitions="10*,10*,20*,30*"
                        VerticalOptions="FillAndExpand">
                        <Frame
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            BackgroundColor="#FFF6ED"
                            CornerRadius="18">
                            <StackLayout>
                                <Label
                                    Margin="30,30,0,0"
                                    FontSize="26"
                                    Text="Identificacion"
                                    TextColor="Black" />
                                <Grid
                                    Margin="30,30,0,0"
                                    ColumnDefinitions="100,*"
                                    RowDefinitions="*,*"
                                    RowSpacing="20">
                                    <Label
                                        FontSize="16"
                                        Text="Usuario"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        WidthRequest="300">
                                        <Entry
                                            BackgroundColor="#D3AA84"
                                            HeightRequest="60"
                                            HorizontalOptions="Start"
                                            MaxLength="25"
                                            Placeholder="Nombre de usuario"
                                            PlaceholderColor="#848484"
                                            Text="{Binding ConfirmUserConfigurations}"
                                            TextColor="Black"
                                            WidthRequest="300" />
                                    </Frame>
                                    <Label
                                        Grid.Row="1"
                                        FontSize="16"
                                        Text="Contraseña"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        WidthRequest="300">
                                        <Entry
                                            BackgroundColor="#D3AA84"
                                            HeightRequest="60"
                                            HorizontalOptions="Start"
                                            MaxLength="25"
                                            Placeholder="Contraseña"
                                            PlaceholderColor="#848484"
                                            Text="{Binding ConfirmPasswordConfigurations}"
                                            TextColor="Black"
                                            WidthRequest="300" />
                                    </Frame>
                                </Grid>
                                <HorizontalStackLayout
                                    HorizontalOptions="EndAndExpand"
                                    Spacing="30"
                                    VerticalOptions="EndAndExpand">
                                    <Button
                                        Margin="0,60,0,60"
                                        BackgroundColor="#AD6B2A"
                                        Command="{Binding CancelDeleteOperatorCommand}"
                                        HeightRequest="45"
                                        Text="Volver"
                                        TextColor="#FFF6ED"
                                        WidthRequest="200" />
                                    <Button
                                        Margin="0,60,60,60"
                                        BackgroundColor="#79280F"
                                        Clicked="OkEditOperator_Clicked"
                                        HeightRequest="45"
                                        Text="Aceptar"
                                        TextColor="White"
                                        WidthRequest="200" />
                                </HorizontalStackLayout>
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>

            </Grid>
        </Grid>

    </StackLayout>


</pages:BaseContentPage>
