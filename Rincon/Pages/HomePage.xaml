                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Cargar Stock"
                        TextColor="#000000"
                        WidthRequest="260" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelAddStockCommand}"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Cancelar"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>


            </Grid>

            <!--  Editar stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsEditStockView}"
                RowDefinitions="auto,auto,auto,auto,auto,auto,*,auto"
                RowSpacing="5">

                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Editar stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <VerticalStackLayout
                    Grid.Row="2"
                    Margin="0,0,0,20"
                    Padding="0,0,0,0">
                    <Frame
                        Margin="0"
                        Padding="10,-3,10,-3"
                        BackgroundColor="LightGray"
                        CornerRadius="24"
                        HeightRequest="55">
                        <SearchBar
                            x:Name="SearchBarEditStock"
                            BackgroundColor="LightGray"
                            CancelButtonColor="Black"
                            Focused="SearchBar_EditStockFocused"
                            HeightRequest="55"
                            HorizontalOptions="StartAndExpand"
                            Placeholder="Buscar producto"
                            TextChanged="OnEditStockTextChanged"
                            TextColor="Black"
                            Unfocused="SearchBar_EditStockUnfocused" />

                    </Frame>


                    <Frame
                        x:Name="FrameListEditStock"
                        CornerRadius="24"
                        IsVisible="{Binding IsVisibleListEditStock}">
                        <Frame.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Offset="0.1" Color="#FFFFFF" />
                                <GradientStop Offset="1.0" Color="#FFF6ED" />
                            </LinearGradientBrush>
                        </Frame.Background>
                        <CollectionView
                            x:Name="ProductsEditStock"
                            HorizontalOptions="FillAndExpand"
                            ItemsSource="{Binding ProductsWithStock}"
                            SelectionChanged="CollectionEditStock_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand">

                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductStock">
                                    <Grid
                                        ColumnDefinitions="auto,auto,auto"
                                        RowDefinitions="*"
                                        RowSpacing="10"
                                        VerticalOptions="Start">
                                        <Label
                                            FontSize="18"
                                            Text="{Binding Id}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="1"
                                            FontSize="18"
                                            Text="{Binding Product.Description}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="18"
                                            Text="{Binding Product.WoodState}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="No se encontraron productos para editar stock"
                                    TextColor="Black"
                                    VerticalOptions="CenterAndExpand" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Frame>

                </VerticalStackLayout>

                <Grid
                    Grid.Row="3"
                    Margin="30,0,0,30"
                    ColumnDefinitions="15*,25*,15*,15*,15*,15*"
                    IsVisible="{Binding IsSelectedProductEditStock}">
                    <Label
                        FontSize="18"
                        Text="Codigo"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="Descripcion"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="Estado"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="Stock Disponible"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="4"
                        FontSize="18"
                        Text="Reserva / Proceso"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="Total"
                        TextColor="#79280F" />
                </Grid>

                <Grid
                    Grid.Row="4"
                    Margin="30,0,0,0"
                    ColumnDefinitions="15*,25*,15*,15*,15*,15*"
                    IsVisible="{Binding IsSelectedProductEditStock}"
                    RowDefinitions="*"
                    RowSpacing="10"
                    VerticalOptions="Start">
                    <Label
                        FontSize="18"
                        Text="{Binding ProductEditStock.Id}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="{Binding ProductEditStock.Product.Description}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="{Binding ProductEditStock.Product.WoodState}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="{Binding ProductEditStock.Available}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="4"
                        Margin="0,0,0,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="black">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ProductEditStock.Reserved}" />
                                <Span Text="/" />
                                <Span Text="{Binding ProductEditStock.Process}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="{Binding ProductEditStock.Quantity}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                </Grid>

                <Grid
                    Grid.Row="5"
                    Margin="30,50,0,0"
                    BackgroundColor="White">
                    <StackLayout Orientation="Horizontal">
                        <Label
                            FontSize="24"
                            Text="Ingrese nuevo Total de stock:"
                            TextColor="#79280F"
                            VerticalTextAlignment="Center" />
                        <Entry
                            Margin="20,0,0,0"
                            FontSize="24"
                            Text="{Binding QuantityEditStock}"
                            TextColor="Black"
                            WidthRequest="200" />
                    </StackLayout>

                </Grid>
                <BoxView
                    Grid.Row="6"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#D3AA84"
                        Clicked="EditStock_Clicked"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Editar Stock"
                        TextColor="#000000"
                        WidthRequest="260" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelEditStockCommand}"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Cancelar"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>


            </Grid>

            <!--  Nuevo Movimiento  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsNewMovementView}"
                RowDefinitions="auto,auto,auto,auto,auto,auto,*,auto"
                RowSpacing="5">

                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Movimiento de stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <VerticalStackLayout
                    Grid.Row="2"
                    Margin="0,0,0,20"
                    Padding="0,0,0,0">
                    <Frame
                        Margin="0"
                        Padding="10,-3,10,-3"
                        BackgroundColor="LightGray"
                        CornerRadius="24"
                        HeightRequest="55">
                        <SearchBar
                            x:Name="SearchBarNewMovement"
                            BackgroundColor="LightGray"
                            CancelButtonColor="Black"
                            Focused="SearchBar_NewMovementFocused"
                            HeightRequest="55"
                            HorizontalOptions="StartAndExpand"
                            Placeholder="Buscar producto"
                            TextChanged="OnNewMovementTextChanged"
                            TextColor="Black"
                            Unfocused="SearchBar_NewMovementUnfocused" />

                    </Frame>


                    <Frame
                        x:Name="FrameListNewMovoment"
                        CornerRadius="24"
                        IsVisible="{Binding IsVisibleListNewMovement}">
                        <Frame.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Offset="0.1" Color="#FFFFFF" />
                                <GradientStop Offset="1.0" Color="#FFF6ED" />
                            </LinearGradientBrush>
                        </Frame.Background>
                        <CollectionView
                            x:Name="ProductsNewMovement"
                            HorizontalOptions="FillAndExpand"
                            ItemsSource="{Binding ProductsWithStock}"
                            SelectionChanged="CollectionNewMovement_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand">

                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductStock">
                                    <Grid
                                        ColumnDefinitions="auto,auto,auto"
                                        ColumnSpacing="70"
                                        RowDefinitions="*"
                                        RowSpacing="10"
                                        VerticalOptions="Start">
                                        <Label
                                            FontSize="18"
                                            Text="{Binding Id}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="1"
                                            FontSize="18"
                                            Text="{Binding Product.Description}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="18"
                                            Text="{Binding Product.WoodState}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="No se encontraron productos para realizar movimientos"
                                    TextColor="Black"
                                    VerticalOptions="CenterAndExpand" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Frame>

                </VerticalStackLayout>

                <StackLayout
                    Grid.Row="3"
                    Margin="30,0,0,30"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsSelectedProductMovement}"
                    Orientation="Horizontal">
                    <Grid ColumnDefinitions="15*,25*,15*,15*,15*,15*" HorizontalOptions="FillAndExpand">
                        <Label
                            FontSize="18"
                            Text="Codigo"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="1"
                            FontSize="18"
                            Text="Descripcion"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="2"
                            FontSize="18"
                            Text="Estado"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="3"
                            FontSize="18"
                            Text="Stock Disponible"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="4"
                            FontSize="18"
                            Text="Reserva / Proceso"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="5"
                            FontSize="18"
                            Text="Total"
                            TextColor="#79280F" />
                    </Grid>
                </StackLayout>

                <Grid
                    Grid.Row="4"
                    Margin="30,0,0,0"
                    ColumnDefinitions="15*,25*,15*,15*,15*,15*"
                    IsVisible="{Binding IsSelectedProductMovement}"
                    RowDefinitions="*"
                    RowSpacing="10"
                    VerticalOptions="Start">
                    <Label
                        FontSize="18"
                        Text="{Binding ProductMovement.Id}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="{Binding ProductMovement.Product.Description}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="{Binding ProductMovement.Product.WoodState}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="{Binding ProductMovement.Available}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="black">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ProductMovement.Reserved}" />
                                <Span Text="/" />
                                <Span Text="{Binding ProductMovement.Process}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="{Binding ProductMovement.Quantity}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                </Grid>

                <Frame
                    Grid.Row="5"
                    Margin="30,150,0,0"
                    BackgroundColor="White">
                    <Grid RowDefinitions="auto, auto,auto" RowSpacing="25">
                        <HorizontalStackLayout Spacing="25">
                            <Label Text="Tipo de movimiento" TextColor="Black" />
                            <VerticalStackLayout>
                                <RadioButton
                                    Content="Venta"
                                    GroupName="MovementType"
                                    IsChecked="{Binding IsSale}"
                                    TextColor="Black"
                                    Value="Sale" />
                                <RadioButton
                                    Content="Cambio de estado"
                                    GroupName="MovementType"
                                    IsChecked="{Binding IsChangeOfState}"
                                    TextColor="Black"
                                    Value="ChangeOfState" />
                                <RadioButton
                                    Content="Para perdida"
                                    GroupName="MovementType"
                                    IsChecked="{Binding IsLoss}"
                                    TextColor="Black"
                                    Value="Loss" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Spacing="25">
                            <Label
                                Text="Cantidad"
                                TextColor="Black"
                                VerticalOptions="Center" />
                            <Entry
                                HorizontalTextAlignment="End"
                                Text="{Binding QuantityMovement}"
                                TextColor="Black"
                                WidthRequest="150" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout
                            Grid.Row="2"
                            IsVisible="{Binding IsChangeOfState}"
                            Spacing="25">
                            <Label
                                Text="Suiguiente estado:"
                                TextColor="Black"
                                VerticalOptions="Center" />
                            <Picker
                                ItemsSource="{Binding DependingProducts}"
                                SelectedItem="{Binding SelectedDependingProducts}"
                                TextColor="Black"
                                WidthRequest="350" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout
                            Grid.Row="2"
                            IsVisible="{Binding IsSale}"
                            Spacing="25">
                            <Label
                                Text="Cliente:"
                                TextColor="Black"
                                VerticalOptions="Center" />
                            <Entry
                                Text="{Binding SaleClient}"
                                TextColor="Black"
                                WidthRequest="250" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout
                            Grid.Row="2"
                            IsVisible="{Binding IsLoss}"
                            Spacing="25">
                            <Label
                                Text="Motivo:"
                                TextColor="Black"
                                VerticalOptions="Center" />
                            <Entry
                                Text="{Binding LossMotive}"
                                TextColor="Black"
                                WidthRequest="300" />
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>
                <BoxView
                    Grid.Row="6"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#D3AA84"
                        Clicked="NewMovement_Clicked"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="{Binding OkMovementText}"
                        TextColor="#000000"
                        WidthRequest="260" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelNewMovementCommand}"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Cancelar"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>


            </Grid>

            <!--  Inventario  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsInventoryView}"
                RowDefinitions="auto,auto,35,auto,*,auto,auto"
                RowSpacing="5">
                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Inventario"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Frame
                    Grid.Row="2"
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderColor="#797979">
                    <SearchBar
                        x:Name="SearchBarInventory"
                        BackgroundColor="LightGray"
                        CancelButtonColor="Black"
                        HeightRequest="55"
                        HorizontalOptions="StartAndExpand"
                        Placeholder="Buscar producto"
                        TextChanged="OnSearchStockInventoryTextChanged"
                        TextColor="Black" />
                </Frame>

                <HorizontalStackLayout Grid.Row="3" Margin="30,0,0,0">
                    <Label
                        FontSize="18"
                        Text="#Codigo"
                        TextColor="#79280F" />
                    <Label
                        Margin="148,0,0,0"
                        FontSize="18"
                        Text="Descripcion"
                        TextColor="#79280F" />
                    <Label
                        Margin="135,0,0,0"
                        FontSize="18"
                        Text="Estado"
                        TextColor="#79280F" />
                    <Label
                        Margin="180,0,0,0"
                        FontSize="18"
                        Text="Ubicación"
                        TextColor="#79280F" />
                </HorizontalStackLayout>

                <CollectionView
                    x:Name="ProductsSearchStockInventory"
                    Grid.Row="4"
                    Margin="30,0,30,0"
                    ItemsSource="{Binding Products}"
                    SelectionMode="Single"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Grid
                                ColumnDefinitions="230,230,240,140,*,60"
                                RowDefinitions="*"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding Description}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="{Binding WoodState}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="18"
                                    Text="{Binding Location}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Button
                                    Grid.Column="4"
                                    BackgroundColor="Transparent"
                                    Clicked="VisivilityProduct_Clicked"
                                    HorizontalOptions="End"
                                    ImageSource="visibility.png" />
                                <Button
                                    Grid.Column="5"
                                    BackgroundColor="Transparent"
                                    Clicked="DeleteProduct_Clicked"
                                    ImageSource="delete_item_icon.png" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <BoxView
                    Grid.Row="5"
                    Margin="0,0,0,40"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />



            </Grid>

            <!--  Inventario vista de productos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsInventoryEditView}"
                RowDefinitions="auto,auto,auto,*,*,*,auto"
                RowSpacing="5">
                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Inventario"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Grid
                    Grid.Row="2"
                    Margin="30,0,0,0"
                    ColumnDefinitions="*,*,*,*,*"
                    RowDefinitions="*,*">
                    <Label
                        FontSize="24"
                        Text="Codigo"
                        TextColor="#79280F" />
