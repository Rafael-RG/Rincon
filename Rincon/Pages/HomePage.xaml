                                            Margin="0"
                                            Padding="10,-3,10,-3"
                                            BackgroundColor="White"
                                            CornerRadius="18"
                                            HeightRequest="40">
                                            <Label
                                                FontSize="14"
                                                Text="{Binding SelectedQuestionConfigurations, Mode=TwoWay}"
                                                TextColor="Black"
                                                VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SelectQuestionCommand}" />
                                                </Label.GestureRecognizers>

                                            </Label>
                                        </Frame>
                                        <Frame
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            CornerRadius="24"
                                            HeightRequest="180"
                                            IsVisible="{Binding IsVisibleListQuestions}">
                                            <Frame
                                                x:Name="FrameListQuestions"
                                                CornerRadius="24"
                                                HeightRequest="180"
                                                IsVisible="{Binding IsVisibleListQuestions}"
                                                VerticalOptions="Start">
                                                <Frame.Background>
                                                    <LinearGradientBrush EndPoint="0,1">
                                                        <GradientStop Offset="0.1" Color="#FFFFFF" />
                                                        <GradientStop Offset="1.0" Color="#FFF6ED" />
                                                    </LinearGradientBrush>
                                                </Frame.Background>
                                                <CollectionView
                                                    x:Name="Questions"
                                                    Margin="0,5,0,5"
                                                    HeightRequest="140"
