                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button
                            BackgroundColor="#D3AA84"
                            Clicked="VisivilityConfirmBookingItem_Clicked"
                            HeightRequest="35"
                            IsVisible="{Binding SelectedBookingOrder.IsCancellable}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Text="Confirmar reserva"
                            TextColor="#000000"
                            WidthRequest="200" />
                    </HorizontalStackLayout>
                </Grid>

            </Grid>

            <!--  Historial  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="12"
                BackgroundColor="#FFF6ED"
                IsVisible="{Binding IsHistoryView}"
                RowDefinitions="auto,auto,*,auto"
                RowSpacing="12">
                
                <!-- Title Row -->
                <Label
                    Grid.Row="0"
                    FontSize="32"
                    HorizontalOptions="Start"
                    Text="Movimientos"
                    TextColor="#79280F"
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    Margin="12,0,0,0" />

                <!-- Filters Section with Frame -->
                <Frame 
                    Grid.Row="1" 
                    BackgroundColor="White" 
                    BorderColor="#79280F" 
                    CornerRadius="12" 
                    Padding="16"
                    Margin="6,0,6,0">
                    <Grid RowDefinitions="auto,auto" RowSpacing="1">
                        <!-- Filters Title -->
                        <Label 
                            Grid.Row="0"
                            FontSize="18" 
                            Text="Filtros" 
                            TextColor="#79280F" 
                            FontAttributes="Bold" 
                            HorizontalOptions="Start"
                            Margin="0,0,0,0" />
                        
                        <!-- Filters Controls -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,auto,auto" ColumnSpacing="15" RowSpacing="15" Margin="0,15,0,20">
                            <StackLayout Grid.Column="0" Orientation="Vertical" Spacing="5">
                                <Label FontSize="16" Text="Tipo de Movimiento" TextColor="#79280F" FontAttributes="Bold" />
                                <Frame BackgroundColor="#FFFFFF" BorderColor="#79280F" CornerRadius="8" Padding="8" HeightRequest="70" HasShadow="False">
                                    <Picker
                                        ItemsSource="{Binding MovementTypes}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedFilterMovementType, Mode=TwoWay}"
                                        TextColor="#000000"
                                        TitleColor="#888888"
                                        HeightRequest="60"
                                        Title="Seleccionar tipo"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        BackgroundColor="Transparent" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Grid.Column="1" Orientation="Vertical" Spacing="5">
                                <Label FontSize="16" Text="Producto" TextColor="#79280F" FontAttributes="Bold" />
                                <Frame BackgroundColor="#FFFFFF" BorderColor="#79280F" CornerRadius="8" Padding="8" HeightRequest="70" HasShadow="False">
                                    <Picker
                                        ItemsSource="{Binding ProductsMovementsFilter}"
                                        ItemDisplayBinding="{Binding ., StringFormat='{0:Code}'}"
                                        SelectedItem="{Binding SelectedFilterMovementProduct, Mode=TwoWay}"
                                        TextColor="#000000"
                                        TitleColor="#888888"
                                        HeightRequest="60"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Title="Seleccionar producto"
                                        BackgroundColor="Transparent" />
                                </Frame>
                            </StackLayout>
                            
                            <StackLayout Grid.Column="2" Orientation="Vertical" Spacing="5">
                                <Label FontSize="16" Text="Fecha" TextColor="#79280F" FontAttributes="Bold" />
                                <Frame BackgroundColor="#FFFFFF" BorderColor="#79280F" CornerRadius="8" Padding="8" HeightRequest="70" HasShadow="False">
                                    <StackLayout>
                                    <Label FontSize="16" Text="Seleccionar fecha" TextColor="#FF8B8B8B" Margin="0,0,0,-10" />
                                    <DatePicker
                                        Date="{Binding SelectedFilterMovementDate}"
                                        TextColor="#000000"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        ToolTipProperties.Text="Seleccionar fecha"
                                        HeightRequest="60"
                                        BackgroundColor="Transparent" />
                                        </StackLayout>
                                </Frame>
                            </StackLayout>

                            <StackLayout Grid.Column="3" Orientation="Vertical" Spacing="10" VerticalOptions="End">
                                <Button
                                    BackgroundColor="#79280F"
                                    BorderColor="#79280F"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=ApplyFiltersMovementsCommand}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    Text="🔍 FILTRAR"
                                    TextColor="White"
                                    WidthRequest="120"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=IsFiltersLoading, Converter={StaticResource InvertedBoolConverter}}" />
                            </StackLayout>
                            
                            <StackLayout Grid.Column="4" Orientation="Vertical" Spacing="10" VerticalOptions="End">
                                <Button
                                    BackgroundColor="#F5F5F5"
                                    BorderColor="#CCCCCC"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=ClearFiltersMovementsCommand}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    Text="🗑️ LIMPIAR"
                                    TextColor="#666666"
                                    WidthRequest="120"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=IsFiltersLoading, Converter={StaticResource InvertedBoolConverter}}" />
                            </StackLayout>
                        </Grid>
                    </Grid>
                </Frame>

                <!-- Table Section with Frame -->
                <Frame 
                    Grid.Row="2" 
                    BackgroundColor="White" 
                    BorderColor="#79280F" 
                    CornerRadius="8" 
                    Padding="8"
                    Margin="4,0,4,0">
                    <Grid>
                        <!-- ActivityIndicator for Filters Loading -->
                        <ActivityIndicator
                            Color="#79280F"
                            IsRunning="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=IsFiltersLoading}"
                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=IsFiltersLoading}"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        
                        <!-- Table Content -->
                        <Grid RowDefinitions="auto,2,*" RowSpacing="8" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=IsFiltersLoading, Converter={StaticResource InvertedBoolConverter}}">
                            <!-- Table Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="90,*,100,80,120" Padding="8,6">
                                <Label
                                    Grid.Column="0"
                                    FontSize="12"
                                    Text="Fecha"
                                    TextColor="#79280F"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="12"
                                    Text="Producto"
                                    TextColor="#79280F"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontSize="12"
                                    Text="Tipo"
                                    TextColor="#79280F"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Grid.Column="3"
                                    FontSize="12"
                                    Text="Cantidad"
                                    TextColor="#79280F"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Grid.Column="4"
                                    FontSize="12"
                                    Text="Usuario"
                                    TextColor="#79280F"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                            </Grid>

                            <!-- Header Separator -->
                            <BoxView 
                                Grid.Row="1" 
                                HeightRequest="2" 
                                BackgroundColor="#79280F" 
                                HorizontalOptions="FillAndExpand" />

                            <!-- Table Content -->
                            <CollectionView
                                x:Name="MovementsSearch"
                                Grid.Row="2"
                                ItemsSource="{Binding MovementsFilter, Mode=TwoWay}"
                                SelectionMode="None"
                                VerticalOptions="FillAndExpand"
                                VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="2" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Movement">
                                        <Frame BackgroundColor="#FAFAFA" BorderColor="#EEE" CornerRadius="4" Padding="8,6" Margin="0,1">
                                            <Grid
                                                ColumnDefinitions="90,*,100,80,120"
                                                RowDefinitions="auto"
                                                VerticalOptions="Start">
                                                <Label
                                                    Grid.Column="0"
                                                    FontSize="11"
                                                    Text="{Binding Date}"
                                                    TextColor="#000000"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="11"
                                                    Text="{Binding ProductName}"
                                                    TextColor="#000000"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="2"
                                                    FontSize="11"
                                                    Text="{Binding MovementType}"
                                                    TextColor="#000000"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="3"
                                                    FontSize="11"
                                                    Text="{Binding Quantity}"
                                                    TextColor="#000000"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="4"
                                                    FontSize="11"
                                                    Text="{Binding UserName}"
                                                    TextColor="#000000"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Grid>
                </Frame>


            </Grid>

            <!--  Configurations  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="25"
                BackgroundColor="White"
                IsVisible="{Binding IsConfigurationView}"
                RowDefinitions="auto,auto,*"
                RowSpacing="15">
                
                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    FontSize="32"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    Text="Configuración"
                    TextColor="#79280F"
                    VerticalOptions="Center"
                    Margin="0,0,0,15" />

                <!-- Separador -->
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,25"
                    HeightRequest="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Contenido principal -->
                <Grid Grid.Row="2" VerticalOptions="Fill">
                    <!-- Indicador de carga -->
                    <ActivityIndicator
                        HeightRequest="40"
                        Color="#79280F"
                        IsRunning="True"
                        IsVisible="{Binding IsBusy}"
                        WidthRequest="40"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                    <!-- Formulario de configuración -->
                    <Frame
                        IsVisible="{Binding ConfirmUserChanges, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="White"
                        BorderColor="#79280F"
                        CornerRadius="12"
                        HasShadow="True"
                        Padding="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MaximumWidthRequest="700">
                        
                        <Grid RowDefinitions="auto,*" RowSpacing="25">
                            <!-- Título del formulario -->
                            <Label
                                Grid.Row="0"
                                FontAttributes="Bold"
                                FontSize="26"
                                Text="Actualizar Información"
                                TextColor="#79280F"
                                HorizontalOptions="Center" />
                            
                            <!-- Campos del formulario -->
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="*,auto"
                                ColumnSpacing="25"
                                RowDefinitions="auto,auto,auto,auto,auto,auto"
                                RowSpacing="20">
                                
                                <!-- Nombre -->
                                <StackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                    <Label
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Text="Nombre"
                                        TextColor="#79280F" />
                                    <Frame
                                        Padding="0"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="50"
                                        HasShadow="True">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            MaxLength="25"
                                            Placeholder="Ingrese su nombre"
                                            PlaceholderColor="#999999"
                                            Text="{Binding NameConfigurations}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            Margin="15,0"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                </StackLayout>
                                
                                <!-- Contraseña -->
                                <StackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                                    <Label
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Text="Nueva Contraseña"
                                        TextColor="#79280F" />
                                    <Frame
                                        Padding="0"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="50"
                                        HasShadow="True">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            MaxLength="25"
                                            Placeholder="Nueva contraseña"
                                            PlaceholderColor="#999999"
                                            Text="{Binding PasswordConfigurations}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            Margin="15,0"
                                            IsPassword="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                </StackLayout>
                                
                                <!-- Repetir contraseña -->
                                <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                                    <Label
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Text="Confirmar Nueva Contraseña"
                                        TextColor="#79280F" />
                                    <Frame
                                        Padding="0"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="50"
                                        HasShadow="True">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            MaxLength="25"
                                            Placeholder="Confirme la nueva contraseña"
                                            PlaceholderColor="#999999"
                                            Text="{Binding RepeatPasswordConfigrations}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            Margin="15,0"
                                            IsPassword="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                </StackLayout>

                                <!-- Pregunta de seguridad -->
                                <StackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                    <Label
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Text="Pregunta de Seguridad"
                                        TextColor="#79280F" />
                                    <Frame
                                        Padding="0"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="50"
                                        HasShadow="True">
                                        <Label
                                            FontSize="16"
                                            Text="{Binding SelectedQuestionConfigurations, Mode=TwoWay}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            Margin="15,0"
                                            BackgroundColor="Transparent">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectQuestionCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Frame>
                                    
                                    <!-- Lista desplegable de preguntas -->
                                    <Frame
                                        IsVisible="{Binding IsVisibleListQuestions}"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HasShadow="True"
                                        HeightRequest="150"
                                        Padding="8">
                                        <CollectionView
                                            x:Name="Questions"
                                            ItemsSource="{Binding Questions}"
                                            SelectionChanged="Questions_SelectionChanged"
                                            SelectionMode="Single"
                                            VerticalOptions="Fill">
                                            <CollectionView.ItemsLayout>
                                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="5" />
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Frame Padding="10,8" BackgroundColor="Transparent" HasShadow="False">
                                                        <Label
                                                            FontSize="14"
                                                            Text="{Binding .}"
                                                            TextColor="#333333"
                                                            VerticalOptions="Center" />
                                                    </Frame>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </Frame>
                                </StackLayout>
                                
                                <!-- Respuesta -->
                                <StackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="8">
                                    <Label
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Text="Respuesta de Seguridad"
                                        TextColor="#79280F" />
                                    <Frame
                                        Padding="0"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="50"
                                        HasShadow="True"
                                        IsVisible="{Binding IsVisibleListQuestions, Converter={StaticResource InvertedBoolConverter}}">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            MaxLength="25"
                                            Placeholder="Ingrese la respuesta"
                                            PlaceholderColor="#999999"
                                            Text="{Binding ResponseConfigurations}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            Margin="15,0"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                </StackLayout>

                                <!-- Botones de acción -->
                                <Grid
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Margin="0,25,0,0"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="20"
                                    HorizontalOptions="Center"
                                    MaximumWidthRequest="400">
                                    <Button
                                        Grid.Column="0"
                                        BackgroundColor="#FFF6ED"
                                        BorderColor="#79280F"
                                        BorderWidth="2"
                                        Command="{Binding CancelConfigurationCommand}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HeightRequest="55"
                                        Text="Cancelar"
                                        TextColor="#79280F"
                                        CornerRadius="8" />
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="#79280F"
                                        Command="{Binding UpdateDataUserCommand}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HeightRequest="55"
                                        Text="Guardar Cambios"
                                        TextColor="White"
                                        CornerRadius="8" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Frame>
                    
                    <!-- Confirmación de cambios -->
                    <Frame
                        IsVisible="{Binding ConfirmUserChanges}"
                        BackgroundColor="White"
                        BorderColor="#79280F"
                        CornerRadius="12"
                        HasShadow="True"
                        Padding="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MaximumWidthRequest="500">
                        
                        <Grid RowDefinitions="auto,*,auto" RowSpacing="25">
                            <!-- Título de verificación -->
                            <Label
                                Grid.Row="0"
                                FontAttributes="Bold"
                                FontSize="24"
                                Text="Verificación de Identidad"
                                TextColor="#79280F"
                                HorizontalOptions="Center" />
                            
                            <!-- Campos de verificación -->
                            <Grid
                                Grid.Row="1"
                                RowDefinitions="auto,auto"
                                RowSpacing="20">
                                
                                <!-- Usuario -->
                                <StackLayout Grid.Row="0" Spacing="8">
                                    <Label
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Text="Nombre de Usuario"
                                        TextColor="#79280F" />
                                    <Frame
                                        Padding="0"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="50"
                                        HasShadow="True">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            MaxLength="25"
                                            Placeholder="Ingrese su usuario"
                                            PlaceholderColor="#999999"
                                            Text="{Binding ConfirmUserConfigurations}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            Margin="15,0"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                </StackLayout>
                                
                                <!-- Contraseña -->
                                <StackLayout Grid.Row="1" Spacing="8">
                                    <Label
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Text="Contraseña Actual"
                                        TextColor="#79280F" />
                                    <Frame
                                        Padding="0"
                                        BackgroundColor="White"
                                        BorderColor="#79280F"
                                        CornerRadius="8"
                                        HeightRequest="50"
                                        HasShadow="True">
                                        <Entry
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            MaxLength="25"
                                            Placeholder="Ingrese su contraseña"
                                            PlaceholderColor="#999999"
                                            Text="{Binding ConfirmPasswordConfigurations}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            Margin="15,0"
                                            IsPassword="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                </StackLayout>
                            </Grid>
                            
                            <!-- Botones de verificación -->
                            <Grid
                                Grid.Row="2"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="20"
                                HorizontalOptions="Center"
                                MaximumWidthRequest="350">
                                <Button
                                    Grid.Column="0"
                                    BackgroundColor="#FFF6ED"
                                    BorderColor="#79280F"
                                    BorderWidth="2"
                                    Command="{Binding CancelConfirmConfigurationCommand}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    Text="Cancelar"
                                    TextColor="#79280F"
                                    CornerRadius="8" />
                                <Button
                                    Grid.Column="1"
                                    BackgroundColor="#79280F"
                                    Clicked="ConfirmChange_Clicked"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    Text="Confirmar"
                                    TextColor="White"
                                    CornerRadius="8" />
                            </Grid>
                        </Grid>
                    </Frame>
                </Grid>
            </Grid>

            <!--  Management operators  -->
            <Grid
                Grid.RowSpan="3"
                Grid.ColumnSpan="5"
                Padding="0"
                BackgroundColor="#FFF6ED"
                IsVisible="{Binding IsManagementOperatorsView}">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <StackLayout.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Offset="0.1" Color="#AD6B2A" />
                            <GradientStop Offset="1.0" Color="#D3AA84" />
                        </LinearGradientBrush>
                    </StackLayout.Background>

                    <StackLayout
                        Margin="0,8,0,0"
                        HeightRequest="28"
                        WidthRequest="320">
                        <ActivityIndicator
                            HeightRequest="28"
                            Color="#4A744C"
                            IsRunning="True"
                            IsVisible="{Binding IsBusy}"
                            WidthRequest="28" />
                    </StackLayout>

                    <Image
                        Margin="20,20,0,0"
                        HorizontalOptions="Start"
                        Source="rincon_white.png"
                        WidthRequest="200" />

                    <!--  Operators  -->
                    <Grid
                        ColumnDefinitions="*,2*,*"
                        IsVisible="{Binding IsOperatorsView}"
                        RowDefinitions="auto,*,auto"
                        VerticalOptions="FillAndExpand"
                        Margin="0,15,0,30">
                        <Frame
                            Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="White"
                            CornerRadius="12"
                            VerticalOptions="FillAndExpand"
                            Padding="20"
                            HasShadow="True">
                            <Grid
                                ColumnDefinitions="*"
                                HorizontalOptions="FillAndExpand"
                                RowDefinitions="auto,auto,auto,*,auto,auto"
                                RowSpacing="12"
                                VerticalOptions="FillAndExpand">

                                <!-- Header mejorado con título y botón -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,auto" ColumnSpacing="15">
                                    <Label
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Start"
                                        Text="Gestión de Operarios"
                                        TextColor="#79280F"
                                        VerticalOptions="Center" />
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="#4A744C"
                                        Command="{Binding AddOperatorCommand}"
                                        HeightRequest="40"
                                        Text="+ Agregar"
                                        TextColor="White"
                                        FontSize="12"
                                        CornerRadius="8"
                                        WidthRequest="100" />
                                </Grid>

                                <!-- Separador -->
                                <BoxView
                                    Grid.Row="1"
                                    Margin="0,5,0,10"
                                    HeightRequest="2"
                                    HorizontalOptions="FillAndExpand"
                                    Color="#79280F" />

                                <!-- Header de tabla optimizado -->
                                <Frame Grid.Row="2" 
                                       BackgroundColor="#F8F8F8" 
                                       CornerRadius="6" 
                                       Padding="12,8"
                                       HasShadow="False">
                                    <Grid ColumnDefinitions="1.5*,1.5*,1.2*,0.8*" ColumnSpacing="10">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            Text="Nombre"
                                            TextColor="#79280F"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            Text="Apellido"
                                            TextColor="#79280F"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            Text="Fecha creación"
                                            TextColor="#79280F"
