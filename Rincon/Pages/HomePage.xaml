                                    RowDefinitions="*,*"
                                    RowSpacing="20">
                                    <Label
                                        FontSize="16"
                                        Text="Usuario"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HorizontalOptions="Start"
                                        MaximumHeightRequest="40"
                                        MinimumHeightRequest="40"
                                        MinimumWidthRequest="200"
                                        VerticalOptions="Start">
                                        <Entry
                                            BackgroundColor="#D3AA84"
                                            HorizontalOptions="Start"
                                            MaxLength="25"
                                            MinimumHeightRequest="60"
                                            MinimumWidthRequest="200"
                                            Placeholder="Nombre de usuario"
                                            PlaceholderColor="#848484"
                                            Text="{Binding ConfirmUserConfigurations}"
                                            TextColor="Black" />
                                    </Frame>
                                    <Label
                                        Grid.Row="1"
                                        FontSize="16"
                                        Text="Contraseña"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="0,0,0,0"
                                        BackgroundColor="White"
                                        CornerRadius="18"
                                        HorizontalOptions="Start"
                                        MaximumHeightRequest="40"
                                        MinimumHeightRequest="40"
                                        MinimumWidthRequest="200">
                                        <Entry
                                            BackgroundColor="#D3AA84"
                                            HorizontalOptions="Start"
                                            MaxLength="25"
                                            MinimumHeightRequest="60"
                                            MinimumWidthRequest="200"
                                            Placeholder="Contraseña"
                                            PlaceholderColor="#848484"
                                            Text="{Binding ConfirmPasswordConfigurations}"
                                            TextColor="Black" />
                                    </Frame>
                                </Grid>
                                <HorizontalStackLayout
                                    HorizontalOptions="EndAndExpand"
                                    Spacing="30"
                                    VerticalOptions="EndAndExpand">
                                    <Button
                                        Margin="0,60,0,60"
