                                    <Frame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="FillAndExpand">
                                        <Entry
                                            BackgroundColor="transparent"
                                            FontSize="12"
                                            HeightRequest="55"
                                            MaxLength="25"
                                            Placeholder="Apellido"
                                            PlaceholderColor="Black"
                                            Text="{Binding OperatorLastName}"
                                            TextColor="Black"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                    
                                    <!-- PIN -->
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="PIN"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="FillAndExpand">
                                        <Entry
                                            BackgroundColor="transparent"
                                            FontSize="12"
                                            HeightRequest="55"
                                            MaxLength="25"
                                            Keyboard="Numeric"
                                            Placeholder="Escriba un PIN"
                                            PlaceholderColor="Black"
                                            Text="{Binding OperatorPin}"
                                            TextColor="Black"
                                            IsPassword="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>

                                    <!-- Confirmar PIN -->
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="Confirmar PIN"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="FillAndExpand">
                                        <Entry
                                            BackgroundColor="transparent"
                                            FontSize="12"
                                            HeightRequest="55"
                                            Keyboard="Numeric"
                                            MaxLength="25"
                                            Placeholder="Confirme su PIN"
                                            PlaceholderColor="Black"
                                            Text="{Binding RepeatOperatorPin}"
                                            TextColor="Black"
                                            IsPassword="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>

                                    <!-- Botones -->
                                    <Grid
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,20,0,0"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            BackgroundColor="#AD6B2A"
                                            Command="{Binding CancelAddOperatorCommand}"
                                            FontSize="14"
                                            HeightRequest="35"
                                            Text="Volver"
                                            TextColor="#FFF6ED" />
                                        <Button
                                            Grid.Column="1"
                                            BackgroundColor="#4A744C"
                                            Command="{Binding OkValidateEditOperatorCommand}"
                                            FontSize="14"
                                            HeightRequest="35"
                                            Text="Editar"
                                            TextColor="White" />
                                    </Grid>
                                </Grid>
                            </StackLayout>
                        </Frame>
                    </Grid>
                    <Grid
                        ColumnDefinitions="*,1.2*,*"
                        IsVisible="{Binding ValidateEditOperator}"
                        RowDefinitions="auto,auto,auto"
                        VerticalOptions="FillAndExpand"
                        Margin="0,20,0,0">
                        <Frame
                            Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="#FFF6ED"
                            CornerRadius="15"
                            Padding="20">
                            <StackLayout Spacing="15">
                                <Label
                                    Margin="0,10,0,15"
                                    FontSize="22"
                                    Text="Identificación"
                                    TextColor="Black"
                                    HorizontalOptions="Center" />
                                <Grid
                                    ColumnDefinitions="*,*"
                                    RowDefinitions="auto,auto,auto"
                                    RowSpacing="12"
                                    ColumnSpacing="15">
                                    
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="Usuario"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="FillAndExpand">
                                        <Entry
                                            BackgroundColor="transparent"
                                            FontSize="12"
                                            HeightRequest="55"
                                            MaxLength="25"
                                            Placeholder="Nombre de usuario"
                                            PlaceholderColor="#848484"
                                            Text="{Binding ConfirmUserConfigurations}"
                                            TextColor="Black"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                    
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="Contraseña"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="FillAndExpand">
                                        <Entry
                                            BackgroundColor="transparent"
                                            FontSize="12"
                                            HeightRequest="55"
                                            MaxLength="25"
                                            Placeholder="Contraseña"
                                            PlaceholderColor="#848484"
                                            Text="{Binding ConfirmPasswordConfigurations}"
                                            TextColor="Black"
                                            IsPassword="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                    
                                    <Grid
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,15,0,0"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            BackgroundColor="#AD6B2A"
                                            Command="{Binding CancelDeleteOperatorCommand}"
                                            FontSize="14"
                                            HeightRequest="35"
                                            Text="Volver"
                                            TextColor="#FFF6ED" />
                                        <Button
                                            Grid.Column="1"
                                            BackgroundColor="#79280F"
                                            Clicked="OkEditOperator_Clicked"
                                            FontSize="14"
                                            HeightRequest="35"
                                            Text="Aceptar"
                                            TextColor="White" />
                                    </Grid>
                                </Grid>
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>

            </Grid>
        </Grid>

    </StackLayout>


</pages:BaseContentPage>
