<?xml version="1.0" encoding="utf-8" ?>
<pages:BaseContentPage
    x:Class="Rincon.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:customControls="clr-namespace:Rincon.CustomControls"
    xmlns:extensions="clr-namespace:Rincon.Extensions"
    xmlns:local="clr-namespace:Rincon.Converters"
    xmlns:models="clr-namespace:Rincon.Models;assembly=Rincon.Models"
    xmlns:pages="clr-namespace:Rincon.Common.Pages;assembly=Rincon.Common"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:HomeViewModel"
    x:TypeArguments="viewModels:HomeViewModel"
    Shell.NavBarIsVisible="false">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:ActiveToColorConverter x:Key="ActiveToColorConverter" />
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <local:BoolToTextConverter x:Key="BoolToTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <StackLayout
        Margin="0,0,0,0"
        Padding="0,0,0,0"
        HorizontalOptions="FillAndExpand"
        VerticalOptions="FillAndExpand">

        <StackLayout.Background>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Offset="0.1" Color="#AD6B2A" />
                <GradientStop Offset="1.0" Color="#D3AA84" />
            </LinearGradientBrush>
        </StackLayout.Background>
        <ActivityIndicator
            HeightRequest="32"
            HorizontalOptions="CenterAndExpand"
            IsRunning="True"
            Color="#4A744C"
            IsVisible="{Binding IsUserLogin, Converter={StaticResource InvertedBoolConverter}}"
            VerticalOptions="CenterAndExpand"
            WidthRequest="32" />

        <Grid
            BackgroundColor="#AD6B2A"
            ColumnDefinitions="*,*,*,*,1.6*"
            ColumnSpacing="0"
            IsVisible="{Binding IsUserLogin}"
            RowDefinitions="55,65,*"
            RowSpacing="0"
            VerticalOptions="FillAndExpand">

            <!--#region Botones principales-->
            <ImageButton
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Margin="20,40,20,20"
                BackgroundColor="#AD6B2A"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="Home"
                HeightRequest="40"
                HorizontalOptions="StartAndExpand"
                Source="rincon_home.png"
                MaximumWidthRequest="173"
                WidthRequest="173" />
            <Button
                Grid.Row="1"
                Grid.Column="0"
                Margin="15,5,15,5"
                BackgroundColor="{Binding IsMagementStockView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="MagementStock"
                CornerRadius="14"
                FontSize="19"
                MinimumHeightRequest="45"
                HeightRequest="45"
                HorizontalOptions="FillAndExpand"
                Text="Gestión de stock"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="8,5,8,5">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                Margin="15,5,15,5"
                BackgroundColor="{Binding IsTasksView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="Tasks"
                CornerRadius="14"
                FontSize="19"
                MinimumHeightRequest="45"
                HeightRequest="45"
                HorizontalOptions="FillAndExpand"
                Text="Tareas"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="8,5,8,5">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Margin="15,5,15,5"
                BackgroundColor="{Binding IsOrdersView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="Orders"
                CornerRadius="14"
                FontSize="19"
                MinimumHeightRequest="45"
                HeightRequest="45"
                HorizontalOptions="FillAndExpand"
                Text="Pedidos"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="8,5,8,5">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="3"
                Margin="15,5,15,5"
                BackgroundColor="{Binding IsHistoryView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="History"
                CornerRadius="14"
                FontSize="19"
                MinimumHeightRequest="45"
                HeightRequest="45"
                HorizontalOptions="FillAndExpand"
                Text="Historial"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="8,5,8,5">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="4"
                Margin="15,5,15,5"
                BackgroundColor="{Binding IsAddProductView, Converter={StaticResource ActiveToColorConverter}}"
                Command="{Binding ChangeViewCommand}"
                CommandParameter="AddProduct"
                CornerRadius="14"
                FontSize="17"
                MinimumHeightRequest="45"
                HeightRequest="45"
                HorizontalOptions="FillAndExpand"
                Text="Añadir producto"
                TextColor="#000000"
                LineBreakMode="WordWrap"
                Padding="6,5,6,5">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="1.4"
                        Radius="10"
                        Offset="5,5" />
                </Button.Shadow>

            </Button>
            <StackLayout
                Grid.Row="0"
                Grid.Column="4"
                Margin="0,20,0,0"
                HorizontalOptions="EndAndExpand"
                Orientation="Horizontal"
                Spacing="0"
                BackgroundColor="Transparent"
                WidthRequest="290">
                <Button
                    Margin="0,0,0,0"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    Clicked="Menu_Clicked"
                    FontSize="16"
                    HorizontalOptions="EndAndExpand"
                    VerticalOptions="Start"
                    Text="{Binding User.Name}"
                    TextColor="White" />
                <ImageButton
                    Margin="0,0,20,0"
                    BackgroundColor="Transparent"
                    Clicked="Menu_Clicked"
                    HeightRequest="30"
                    HorizontalOptions="Start"
                    Source="account.png"
                    WidthRequest="30" />
                
            </StackLayout>


            <!--  Barra lateral  -->
            <Grid
                Grid.Row="2"
                Grid.Column="4"
                Padding="0,0,0,0"
                BackgroundColor="#D3AA84"
                ColumnDefinitions="*"
                RowDefinitions="auto,*">
                <ActivityIndicator
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    HeightRequest="32"
                    Color="#4A744C"
                    IsRunning="True"
                    IsVisible="{Binding IsBusy}"
                    WidthRequest="32" />
                <Frame
                    Grid.Row="0"
                    Margin="10,15,10,15"
                    Padding="0,0,0,0"
                    BackgroundColor="#FAFAFA"
                    BorderColor="Transparent"
                    CornerRadius="12"
                    HeightRequest="45">
                    <SearchBar
                        x:Name="SearchBarLateralBar"
                        BackgroundColor="White"
                        CancelButtonColor="Black"
                        HeightRequest="45"
                        HorizontalOptions="StartAndExpand"
                        Placeholder="Buscar"
                        TextChanged="SearchBarLateralBar_TextChanged"
                        TextColor="Black" />
                </Frame>

                <CollectionView
                    x:Name="LateraBarStock"
                    Grid.Row="1"
                    Margin="5,5,5,5"
                    ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=Cards}"
                    SelectionChanged="LateraBarStock_SelectionChanged"
                    SelectionMode="Single"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CardStock">
                            <Frame
                                BackgroundColor="#EAEAEA"
                                BorderColor="Transparent"
                                CornerRadius="12"
                                HeightRequest="108"
                                VerticalOptions="FillAndExpand"
                                HorizontalOptions="FillAndExpand"
                                Margin="0,0,0,0">
                                <Grid
                                    Padding="0"
                                    ColumnSpacing="10"
                                    HorizontalOptions="FillAndExpand"
                                    RowSpacing="2"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.RowSpan="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,0"
                                        HorizontalOptions="Center"
                                        Spacing="3"
                                        VerticalOptions="Center">
                                        <Label
                                            FontSize="15"
                                            HorizontalOptions="Center"
                                            Text="{Binding Id}"
                                            TextColor="#79280F"
                                            VerticalOptions="Center" />

                                        <Image
                                            HeightRequest="35"
                                            HorizontalOptions="Center"
                                            Source="{Binding Icon}"
                                            WidthRequest="35" />

                                    </StackLayout>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,5,0"
                                        FontSize="18"
                                        MaxLines="1"
                                        HorizontalOptions="Start"
                                        TextColor="#303030"
                                        VerticalOptions="Start"
                                        LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Description}" />
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,10,0,0"
                                        HorizontalOptions="Center"
                                        Spacing="2"
                                        VerticalOptions="FillAndExpand">

                                        <Label
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            Text="Disponible"
                                            TextColor="#000000" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            Text="{Binding StockAvailable}"
                                            TextColor="#000000" />

                                    </StackLayout>

                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,10,0,0"
                                        HorizontalOptions="Center"
                                        Spacing="2"
                                        VerticalOptions="Start">

                                        <Label
                                            FontAttributes="None"
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            Text="Reservado"
                                            TextColor="#000000" />
                                        <Label
                                            FontAttributes="None"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            Text="{Binding StockReserved}"
                                            TextColor="#000000" />

                                    </StackLayout>



                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <StackLayout Spacing="10">

                            <Label
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="No hay producto stock"
                                TextColor="#797979"
                                VerticalOptions="CenterAndExpand" />

                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <!--#endregion-->

            <!--  Home  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                IsVisible="{Binding IsHomeView}"
                RowDefinitions="*,*,*,*"
                RowSpacing="20">
                <ActivityIndicator
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Color="#4A744C"
                    BackgroundColor="White"
                    HorizontalOptions="CenterAndExpand"
                    IsRunning="True"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="CenterAndExpand" />
                <Frame
                    Grid.Row="0"
                    Padding="10"
                    BackgroundColor="#EAEAEA"
                    BorderColor="Transparent">
                    <Grid
                        ColumnDefinitions="*,*,*"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <ImageButton
                            Grid.Column="0"
                            Command="{Binding ChangeViewCommand}"
                            CommandParameter="AddStock"
                            HorizontalOptions="FillAndExpand"
                            Source="add_direct_home.png"
                            VerticalOptions="FillAndExpand" />
                        <ImageButton
                            Grid.Column="1"
                            Command="{Binding ChangeViewCommand}"
                            CommandParameter="NewMovement"
                            HorizontalOptions="FillAndExpand"
                            Source="change_direct_home.png"
                            VerticalOptions="FillAndExpand" />
                        <ImageButton
                            Grid.Column="2"
                            Command="{Binding ChangeViewCommand}"
                            CommandParameter="EditStock"
                            HorizontalOptions="FillAndExpand"
                            Source="edit_direct_home.png"
                            VerticalOptions="FillAndExpand" />
                    </Grid>
                </Frame>
                <Frame
                    Grid.Row="1"
                    Grid.RowSpan="4"
                    BackgroundColor="#EAEAEA"
                    BorderColor="Transparent">
                    <StackLayout
                        Margin="0,0,0,0"
                        Padding="0"
                        Orientation="Vertical">
                        <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                            <Label
                                FontSize="22"
                                HorizontalOptions="Start"
                                Text="{Binding TaskItems.Count, StringFormat='Tareas ({0})'}"
                                TextColor="Gray"
                                VerticalOptions="Center" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                HeightRequest="35"
                                Clicked="AddTask_Clicked"
                                HorizontalOptions="EndAndExpand"
                                Source="add_circle_button.png"
                                VerticalOptions="Start"
                                WidthRequest="35" />
                        </StackLayout>
                        <BoxView
                            Margin="0,4,0,0"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Start"
                            Color="Gray" />
                        <CollectionView
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            BackgroundColor="Transparent"
                            ItemsSource="{Binding TaskItems}"
                            SelectionMode="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout
                                    HorizontalItemSpacing="5"
                                    Orientation="Vertical"
                                    Span="1"
                                    VerticalItemSpacing="5" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <Frame
                                        BackgroundColor="White"
                                        BorderColor="Transparent"
                                        CornerRadius="20"
                                        HeightRequest="120">
                                        <Grid
                                            ColumnDefinitions="*"
                                            HorizontalOptions="FillAndExpand"
                                            RowDefinitions="*,*,*,20"
                                            VerticalOptions="FillAndExpand">

                                            <Label
                                                Grid.Row="1"
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                TextColor="#000000"
                                                VerticalOptions="Start">
                                                <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Material: " FontAttributes="Bold" />
                                                    <Span Text="{Binding ProductSource}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            </Label>
                                            <Label
                                                Grid.Row="2"
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                TextColor="#000000"
                                                VerticalOptions="Start" >
                                                <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Producir: " FontAttributes="Bold" />
                                                    <Span Text="{Binding ProductDestination}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            </Label>
                                            <StackLayout Grid.Column="0" Orientation="Horizontal">
                                                <Label Text="{Binding Id, StringFormat='Tarea #{0:D5}'}" FontSize="14" TextColor="#D3AA84" FontAttributes="Bold"/>
                                                <Label Text="{Binding TaskStatus, StringFormat='({0})'}" FontSize="14" FontAttributes="Bold" TextColor="#797979" Margin="4,0,0,0"/>
                                                <Button
                                                    Margin="10,0,0,0"
                                                    Padding="0,0,0,0"
                                                    BackgroundColor="Transparent"
                                                    Clicked="VisivilityTaskItem_Clicked"
                                                    HorizontalOptions="EndAndExpand"
                                                    WidthRequest="35"
                                                    HeightRequest="35"
                                                    ImageSource="visibility.png" />
                                            </StackLayout>
                                            <Label
                                                Grid.Row="3"
                                                FontSize="12"
                                                HorizontalOptions="EndAndExpand"
                                                Text="{Binding CreatedAt, StringFormat='Creada {0:dd/MM/yyyy HH:mm}'}"
                                                TextColor="#D3AA84"
                                                VerticalOptions="EndAndExpand" />

                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    
                    </StackLayout>
                </Frame>
                <Frame
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    BackgroundColor="#EAEAEA"
                    BorderColor="Transparent">
                    <StackLayout
                        Margin="0"
                        Padding="0"
                        Orientation="Vertical">
                        <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                            <Label
                                FontSize="22"
                                HorizontalOptions="Start"
                                Text="{Binding BookingOrderItems.Count, StringFormat='Reservas ({0})'}"
                                TextColor="Gray"
                                VerticalOptions="Center" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                HeightRequest="35"
                                Clicked="AddBooking_Clicked"
                                HorizontalOptions="EndAndExpand"
                                Source="add_circle_button.png"
                                VerticalOptions="Start"
                                WidthRequest="35" />
                        </StackLayout>
                        <BoxView
                            Margin="0,0,0,0"
                            BackgroundColor="Gray"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Start" />
                        <CollectionView
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            BackgroundColor="Transparent"
                            ItemsSource="{Binding BookingOrderItems}"
                            SelectionMode="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout
                                    HorizontalItemSpacing="5"
                                    Orientation="Vertical"
                                    Span="1"
                                    VerticalItemSpacing="5" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:BookingOrder">
                                    <Frame
                                        BackgroundColor="White"
                                        BorderColor="Transparent"
                                        CornerRadius="20"
                                        HeightRequest="100">
                                        <Grid
                                            ColumnDefinitions="*"
                                            HorizontalOptions="FillAndExpand"
                                            RowDefinitions="*,*,20"
                                            VerticalOptions="FillAndExpand">

                                            <Label
                                                Grid.Row="1"
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                TextColor="#000000"
                                                VerticalOptions="Start">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Teléfono: " FontAttributes="Bold" />
                                                        <Span Text="{Binding Phone}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <StackLayout Grid.Column="0" Orientation="Horizontal">
                                                <Label
                                                    FontSize="18"
                                                    TextColor="#D3AA84"
                                                    VerticalOptions="Start">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Cliente: " FontAttributes="Bold" />
                                                            <Span Text="{Binding Client}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                    

                                                <Button
                                                    Margin="10,0,0,0"
                                                    Padding="0,0,0,0"
                                                    BackgroundColor="Transparent"
                                                    Clicked="VisivilityBookingItem_Clicked"
                                                    HorizontalOptions="EndAndExpand"
                                                    WidthRequest="35"
                                                    HeightRequest="35"
                                                    ImageSource="visibility.png" />
                                            </StackLayout>
                                            <Label
                                                Grid.Row="2"
                                                FontSize="12"
                                                HorizontalOptions="EndAndExpand"
                                                Text="{Binding OrderDate, StringFormat='Creada {0:dd/MM/yyyy}'}"
                                                TextColor="#D3AA84"
                                                VerticalOptions="EndAndExpand" />

                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    
                    </StackLayout>
                </Frame>
                <Frame
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    BackgroundColor="#EAEAEA"
                    BorderColor="Transparent">
                    <StackLayout
                        Margin="0"
                        Padding="0"
                        Orientation="Vertical">
                        <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                            <Label
                                FontSize="22"
                                HorizontalOptions="Start"
                                Text="{Binding Notes.Count, StringFormat='Notas ({0})'}"
                                TextColor="Gray"
                                VerticalOptions="Center" />
                            <ImageButton
                                BackgroundColor="Transparent"
                                Clicked="AddNote_Clicked"
                                HeightRequest="35"
                                HorizontalOptions="EndAndExpand"
                                Source="add_circle_button.png"
                                VerticalOptions="Start"
                                WidthRequest="35" />
                        </StackLayout>

                        <BoxView
                            Margin="0,0,0,0"
                            BackgroundColor="Gray"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Start" />

                        <CollectionView
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            BackgroundColor="Transparent"
                            ItemsSource="{Binding Notes}"
                            SelectionMode="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout
                                    HorizontalItemSpacing="5"
                                    Orientation="Vertical"
                                    Span="1"
                                    VerticalItemSpacing="5" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Note">
                                    <Frame
                                        BackgroundColor="White"
                                        BorderColor="Transparent"
                                        CornerRadius="20"
                                        HeightRequest="120">
                                        <Grid
                                            ColumnDefinitions="*"
                                            HorizontalOptions="FillAndExpand"
                                            RowDefinitions="*,*,20"
                                            VerticalOptions="FillAndExpand">

                                            <Label
                                                Grid.Row="1"
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Text="{Binding Content}"
                                                TextColor="#000000"
                                                VerticalOptions="Start" />
                                            <StackLayout Grid.Column="0" Orientation="Horizontal">
                                                <Label
                                                    FontSize="18"
                                                    TextColor="#D3AA84"
                                                    VerticalOptions="Start">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Titulo: " FontAttributes="Bold" />
                                                            <Span Text="{Binding Title}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                    
                                                <Button
                                                    Padding="0,0,0,0"
                                                    BackgroundColor="Transparent"
                                                    Clicked="DeleteNote_Clicked"
                                                    HorizontalOptions="EndAndExpand"
                                                    ImageSource="delete_item_icon.png" />

                                                <Button
                                                    Margin="10,0,0,0"
                                                    Padding="0,0,0,0"
                                                    BackgroundColor="Transparent"
                                                    Clicked="VisivilityNote_Clicked"
                                                    HorizontalOptions="End"
                                                    ImageSource="visibility.png" />
                                            </StackLayout>
                                            <Label
                                                Grid.Row="2"
                                                FontSize="12"
                                                HorizontalOptions="EndAndExpand"
                                                Text="{Binding CreatedAt, StringFormat='Creada {0:dd/MM/yyyy HH:mm}'}"
                                                TextColor="#D3AA84"
                                                VerticalOptions="EndAndExpand" />

                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>
            </Grid>

            <!--  Gestion de Stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsMagementStockView}"
                RowDefinitions="auto,auto,*"
                RowSpacing="10">
                
                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    FontSize="24"
                    HorizontalOptions="Start"
                    Text="Gestión de Stock"
                    TextColor="#79280F"
                    VerticalOptions="Start" />
                    
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Lista de opciones compacta -->
                <StackLayout Grid.Row="2" Spacing="15" HorizontalOptions="Start" MaximumWidthRequest="600">
                    <!-- Carga de stock -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="add_stock_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="AddStock" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Carga de stock"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="AddStock" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Nuevo movimiento -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="new_movement_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="NewMovement" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Nuevo movimiento"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="NewMovement" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Consulta de stock -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="consult_stock_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CheckStock" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Consulta de stock"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CheckStock" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Editar stock -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="edit_stock_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="EditStock" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Editar stock"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="EditStock" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Inventario -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="inventory_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="Inventory" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Inventario"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="Inventory" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                </StackLayout>
            </Grid>

            <!--  Añadir producto  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15"
                BackgroundColor="White"
                IsVisible="{Binding IsAddProductView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="8">

                <Label
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Nuevo Producto"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,15"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Grid Grid.Row="2" ColumnDefinitions="1.2*,*" ColumnSpacing="20" RowDefinitions="*" Padding="0" VerticalOptions="FillAndExpand">
                    <!-- Columna izquierda - Información básica -->
                    <StackLayout Grid.Column="0" Spacing="8" VerticalOptions="FillAndExpand">
                        <!-- Código del producto -->
                        <Grid ColumnDefinitions="auto,250" ColumnSpacing="12" HorizontalOptions="Start" Padding="0">
                            <Label
                                Grid.Column="0"
                                FontSize="14"
                                Text="Código:"
                                TextColor="#79280F"
                                VerticalOptions="Center" />
                            
                            <Frame
                                Grid.Column="1"
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderColor="#797979"
                                HeightRequest="34">
                                <Entry
                                    FontSize="14"
                                    HeightRequest="55"
                                    Placeholder="Código del producto"
                                    Text="{Binding ProductCode}"
                                    TextColor="Black"
                                    BackgroundColor="Transparent"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False" />
                            </Frame>
                        </Grid>

                        <!-- Tipo de producto -->
                        <Label
                            FontSize="14"
                            Text="Tipo"
                            TextColor="#79280F"
                            Margin="0,5,0,0" />

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" RowSpacing="0">
                            <RadioButton
                                Grid.Column="0"
                                Content="Tirante"
                                FontSize="12"
                                GroupName="Type"
                                HorizontalOptions="Center"
                                IsChecked="{Binding IsTiranteSelect}"
                                Value="Tirante" />

                            <RadioButton
                                Grid.Column="1"
                                Content="Polin"
                                FontSize="12"
                                GroupName="Type"
                                HorizontalOptions="Center"
                                IsChecked="{Binding IsPolinSelect}"
                                Value="Polin" />

                            <RadioButton
                                Grid.Column="2"
                                Content="Medio Polin"
                                FontSize="12"
                                GroupName="Type"
                                HorizontalOptions="Center"
                                IsChecked="{Binding IsMedioPolinSelect}"
                                Value="Medio Polin" />

                            <RadioButton
                                Grid.Column="3"
                                Content="Tabla"
                                FontSize="12"
                                GroupName="Type"
                                HorizontalOptions="Center"
                                IsChecked="{Binding IsTablaSelect}"
                                Value="Tabla" />
                        </Grid>

                        <!-- Medidas para productos con medidas -->
                        <StackLayout IsVisible="{Binding IsMeasureSelect}" Spacing="6">
                            <Label
                                FontSize="14"
                                Text="Medidas"
                                TextColor="#79280F" />
                            
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="auto,auto">
                                <!-- Grosor -->
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Frame
                                        Padding="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="#797979"
                                        HeightRequest="34">
                                        <Entry
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="55"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Grosor"
                                            Text="{Binding Thickness}"
                                            TextColor="Black" />
                                    </Frame>
                                    <Label
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                        Text="Grosor"
                                        TextColor="Black" />
                                </StackLayout>

                                <!-- Ancho -->
                                <StackLayout Grid.Column="1" Spacing="2">
                                    <Frame
                                        Padding="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="#797979"
                                        HeightRequest="34">
                                        <Entry
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="55"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Ancho"
                                            Text="{Binding Width}"
                                            TextColor="Black" />
                                    </Frame>
                                    <Label
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                        Text="Ancho"
                                        TextColor="Black" />
                                </StackLayout>

                                <!-- Largo -->
                                <StackLayout Grid.Column="2" Spacing="2">
                                    <Frame
                                        Padding="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="#797979"
                                        HeightRequest="34">
                                        <Entry
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="55"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Largo"
                                            Text="{Binding Length}"
                                            TextColor="Black" />
                                    </Frame>
                                    <Label
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                        Text="Largo"
                                        TextColor="Black" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>

                        <!-- Medidas para Polin -->
                        <StackLayout IsVisible="{Binding IsPolinSelect}" Spacing="6">
                            <Label
                                FontSize="14"
                                Text="Medidas"
                                TextColor="#79280F" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <!-- Diámetro -->
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Frame
                                        Padding="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="#797979"
                                        HeightRequest="34">
                                        <Entry
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            Keyboard="Numeric"
                                            HeightRequest="55"
                                            MaxLength="9"
                                            Placeholder="Diámetro"
                                            Text="{Binding Diameter}"
                                            TextColor="Black" />
                                    </Frame>
                                    <Label
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                        Text="Diámetro"
                                        TextColor="Black" />
                                </StackLayout>

                                <!-- Largo -->
                                <StackLayout Grid.Column="1" Spacing="2">
                                    <Frame
                                        Padding="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="#797979"
                                        HeightRequest="34">
                                        <Entry
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="55"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Largo"
                                            Text="{Binding Length}"
                                            TextColor="Black" />
                                    </Frame>
                                    <Label
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                        Text="Largo"
                                        TextColor="Black" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>

                        <!-- Medidas para Medio Polin -->
                        <StackLayout IsVisible="{Binding IsMedioPolinSelect}" Spacing="6">
                            <Label
                                FontSize="14"
                                Text="Medidas"
                                TextColor="#79280F" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <!-- Diámetro -->
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Frame
                                        Padding="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="#797979"
                                        HeightRequest="34">
                                        <Entry
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="55"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Diámetro"
                                            Text="{Binding Diameter}"
                                            TextColor="Black" />
                                    </Frame>
                                    <Label
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                        Text="Diámetro"
                                        TextColor="Black" />
                                </StackLayout>

                                <!-- Largo -->
                                <StackLayout Grid.Column="1" Spacing="2">
                                    <Frame
                                        Padding="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="#797979"
                                        HeightRequest="34">
                                        <Entry
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            HeightRequest="55"
                                            Keyboard="Numeric"
                                            MaxLength="9"
                                            Placeholder="Largo"
                                            Text="{Binding Length}"
                                            TextColor="Black" />
                                    </Frame>
                                    <Label
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                        Text="Largo"
                                        TextColor="Black" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </StackLayout>

                    <!-- Columna derecha - Información adicional -->
                    <StackLayout Grid.Column="1" Spacing="8" VerticalOptions="FillAndExpand">
                        <!-- Estado -->
                        <StackLayout Spacing="6">
                            <Label
                                FontSize="14"
                                Text="Estado"
                                TextColor="#79280F" />

                            <Frame
                                Padding="6,3"
                                BackgroundColor="White"
                                CornerRadius="15"
                                HeightRequest="30">
                                <Label
                                    FontSize="12"
                                    Text="{Binding SelectedState, Mode=TwoWay}"
                                    VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectStateCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                            
                            <Frame
                                CornerRadius="15"
                                HeightRequest="100"
                                IsVisible="{Binding IsVisibleListStates}"
                                VerticalOptions="Start">
                                <Frame.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Offset="0.1" Color="#FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#FFF6ED" />
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <CollectionView
                                    x:Name="StatesList"
                                    HeightRequest="100"
                                    ItemsSource="{Binding States}"
                                    SelectionChanged="States_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Start">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="6" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label
                                                FontSize="12"
                                                Text="{Binding .}"
                                                TextColor="#000000"
                                                VerticalOptions="Start" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>
                        </StackLayout>

                        <!-- Derivado de -->
                        <StackLayout Spacing="6">
                            <Label
                                FontSize="14"
                                Text="Derivado de"
                                TextColor="#79280F" />

                            <Frame
                                Padding="6,3"
                                BackgroundColor="White"
                                CornerRadius="15"
                                HeightRequest="30">
                                <Label
                                    FontSize="12"
                                    Text="{Binding SelectedProduct, Mode=TwoWay}"
                                    VerticalOptions="Center" />
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectProductMocvementCommand}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                            
                            <Frame
                                CornerRadius="20"
                                HeightRequest="110"
                                IsVisible="{Binding IsVisibleListProducts}"
                                VerticalOptions="Start">
                                <Frame.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Offset="0.1" Color="#FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#FFF6ED" />
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <CollectionView
                                    x:Name="ProductList"
                                    HeightRequest="110"
                                    ItemsSource="{Binding Products}"
                                    SelectionChanged="Product_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Start">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="8" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Product">
                                            <Label
                                                FontSize="14"
                                                Text="{Binding .}"
                                                TextColor="#000000"
                                                VerticalOptions="Start" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>
                        </StackLayout>

                        <!-- Machimbre y Deck -->
                        <Grid IsVisible="{Binding IsMachimbreOption}" ColumnDefinitions="*,auto,*,auto" ColumnSpacing="15" RowSpacing="10">
                            <!-- Machimbre -->
                            <Label
                                Grid.Column="0"
                                FontSize="14"
                                Text="Machimbre"
                                TextColor="#79280F"
                                VerticalOptions="Center" />

                            <CheckBox
                                Grid.Column="1"
                                HeightRequest="35"
                                IsChecked="{Binding IsMachimbre}"
                                WidthRequest="35"
                                Color="#79280F" />

                            <!-- Deck -->
                            <Label
                                Grid.Column="2"
                                FontSize="14"
                                IsVisible="{Binding IsDeckOption}"
                                Text="Deck"
                                TextColor="#79280F"
                                VerticalOptions="Center" />

                            <CheckBox
                                Grid.Column="3"
                                HeightRequest="35"
                                IsChecked="{Binding IsDeck}"
                                IsVisible="{Binding IsDeckOption}"
                                WidthRequest="35"
                                Color="#79280F" />
                        </Grid>

                        <!-- Lista de Machimbre -->
                        <StackLayout IsVisible="{Binding IsMachimbre}" Spacing="6">
                            <Frame
                                Padding="6,3"
                                BackgroundColor="White"
                                CornerRadius="15"
                                HeightRequest="30">
                                <Label
                                    FontSize="12"
                                    Text="{Binding SelectedMachimbre, Mode=TwoWay}"
                                    VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMachimbreCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                            
                            <Frame
                                x:Name="FrameListMachimbres"
                                CornerRadius="20"
                                HeightRequest="110"
                                IsVisible="{Binding IsVisibleListMachimbres}"
                                VerticalOptions="Start">
                                <Frame.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Offset="0.1" Color="#FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#FFF6ED" />
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <CollectionView
                                    x:Name="MachimbreList"
                                    HeightRequest="110"
                                    ItemsSource="{Binding Machimbres}"
                                    SelectionChanged="Machimbres_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Start">

                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="8" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label
                                                FontSize="14"
                                                Text="{Binding .}"
                                                TextColor="#000000"
                                                VerticalOptions="Start" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>
                        </StackLayout>

                        <!-- Ubicación, Comentarios y Proveedor en layout horizontal compacto -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="auto,auto,auto,auto,auto" RowSpacing="6">
                            <!-- Ubicación -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="14"
                                Text="Ubicación"
                                TextColor="Black" />

                            <Frame
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="3"
                                BackgroundColor="Transparent"
                                BorderColor="#797979"
                                HeightRequest="34">
                                <Entry
                                    FontSize="12"
                                    HeightRequest="55"
                                    Text="{Binding Location}"
                                    TextColor="Black"
                                    Placeholder="Ubicación del producto" />
                            </Frame>

                            <!-- Proveedor -->
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="14"
                                Text="Proveedor"
                                TextColor="Black" />

                            <Frame
                                Grid.Row="3"
                                Grid.Column="0"
                                Padding="3"
                                BackgroundColor="Transparent"
                                BorderColor="#797979"
                                HeightRequest="34">
                                <Entry
                                    FontSize="12"
                                    Keyboard="Text"
                                    HeightRequest="55"
                                    Text="{Binding Supplier}"
                                    TextColor="Black"
                                    Placeholder="Nombre del proveedor" />
                            </Frame>

                            <!-- Comentarios -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="14"
                                Text="Comentarios"
                                TextColor="Black" />

                            <Frame
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                Padding="3"
                                BackgroundColor="Transparent"
                                BorderColor="#797979"
                                HeightRequest="75">
                                <Editor
                                    AutoSize="TextChanges"
                                    FontSize="12"
                                    HeightRequest="95"
                                    Margin="0,20,0,0"
                                    Text="{Binding Comments}"
                                    TextColor="Black"
                                    Placeholder="Comentarios adicionales" />
                            </Frame>
                        </Grid>
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    VerticalOptions="EndAndExpand"
                    HeightRequest="2"
                    Color="#79280F"
                    Margin="0,15,0,0" />

                <Grid
                    Grid.Row="4"
                    Margin="0,10,0,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="15">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#D3AA84"
                        Command="{Binding SaveProductCommand}"
                        CommandParameter="AddProduct"
                        FontSize="14"
                        HeightRequest="35"
                        Text="Crear Producto"
                        TextColor="#000000" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelAddProductCommand}"
                        FontSize="14"
                        HeightRequest="35"
                        Text="Cancelar"
                        TextColor="#000000" />
                </Grid>

            </Grid>

            <!--  Carga de stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsAddStockView}"
                RowDefinitions="auto,auto,auto,*,auto,auto"
                RowSpacing="5">

                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Carga de stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <VerticalStackLayout
                    Grid.Row="2"
                    Margin="0,0,0,20"
                    Padding="0,0,0,0">
                    <Frame
                        Margin="0"
                        Padding="10,-3,10,-3"
                        BackgroundColor="LightGray"
                        CornerRadius="24"
                        HeightRequest="55">
                        <SearchBar
                            x:Name="SearchBarAddStock"
                            BackgroundColor="LightGray"
                            CancelButtonColor="Black"
                            Focused="SearchBar_Focused"
                            HeightRequest="55"
                            HorizontalOptions="StartAndExpand"
                            Placeholder="Buscar producto"
                            TextChanged="OnAddStockTextChanged"
                            TextColor="Black"
                            Unfocused="SearchBar_Unfocused" />

                    </Frame>


                    <Frame
                        x:Name="FrameListAddStock"
                        CornerRadius="24"
                        IsVisible="{Binding IsVisibleListAddStock}">
                        <Frame.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Offset="0.1" Color="#FFFFFF" />
                                <GradientStop Offset="1.0" Color="#FFF6ED" />
                            </LinearGradientBrush>
                        </Frame.Background>
                        <CollectionView
                            x:Name="ProductsAddStock"
                            HorizontalOptions="FillAndExpand"
                            ItemsSource="{Binding Products}"
                            SelectionChanged="Collection_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand">

                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Product">
                                    <Grid
                                        ColumnDefinitions="*,*,*"
                                        RowDefinitions="*"
                                        RowSpacing="10"
                                        VerticalOptions="Start">
                                        <Label
                                            FontSize="18"
                                            Text="{Binding Id}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="1"
                                            FontSize="18"
                                            Text="{Binding Description}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="18"
                                            Text="{Binding WoodState}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="No se encontraron productos"
                                    TextColor="Black"
                                    VerticalOptions="CenterAndExpand" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Frame>

                </VerticalStackLayout>

                <CollectionView
                    Grid.Row="3"
                    Margin="30,0,30,0"
                    ItemsSource="{Binding ProductsStock, Mode=TwoWay}"
                    SelectionMode="Single"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <HorizontalStackLayout Margin="30,0,0,30">
                            <Label
                                FontSize="18"
                                Text="Codigo"
                                TextColor="#79280F" />
                            <Label
                                Margin="230,0,0,0"
                                FontSize="18"
                                Text="Descripcion"
                                TextColor="#79280F" />
                            <Label
                                Margin="200,0,0,0"
                                FontSize="18"
                                Text="Estado"
                                TextColor="#79280F" />
                            <Label
                                Margin="520,0,0,0"
                                FontSize="18"
                                Text="Cantidad"
                                TextColor="#79280F" />
                        </HorizontalStackLayout>
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <StackLayout>
                            <Label
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="No se han cargado productos"
                                TextColor="#797979"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductStock">
                            <Grid
                                ColumnDefinitions="300,300,*,100,auto"
                                RowDefinitions="*"
                                RowSpacing="10"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Product.Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding Product.Description}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="{Binding Product.WoodState}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Frame
                                    Grid.Column="3"
                                    Margin="0,0,0,5"
                                    Padding="0"
                                    BackgroundColor="Transparent">
                                    <Entry
                                        FontSize="18"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Quantity, Mode=TwoWay}"
                                        TextColor="#000000"
                                        VerticalOptions="FillAndExpand" />
                                </Frame>


                                <ImageButton
                                    Grid.Column="4"
                                    Margin="30,0,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=RemoveProductToAddedCommand}"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="15"
                                    Source="delete_item_icon.png"
                                    WidthRequest="15" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <BoxView
                    Grid.Row="4"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="5"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#D3AA84"
                        Clicked="AddStock_Clicked"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Cargar Stock"
                        TextColor="#000000"
                        WidthRequest="260" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelAddStockCommand}"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Cancelar"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>


            </Grid>

            <!--  Editar stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsEditStockView}"
                RowDefinitions="auto,auto,auto,auto,auto,auto,*,auto"
                RowSpacing="5">

                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Editar stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <VerticalStackLayout
                    Grid.Row="2"
                    Margin="0,0,0,20"
                    Padding="0,0,0,0">
                    <Frame
                        Margin="0"
                        Padding="10,-3,10,-3"
                        BackgroundColor="LightGray"
                        CornerRadius="24"
                        HeightRequest="55">
                        <SearchBar
                            x:Name="SearchBarEditStock"
                            BackgroundColor="LightGray"
                            CancelButtonColor="Black"
                            Focused="SearchBar_EditStockFocused"
                            HeightRequest="55"
                            HorizontalOptions="StartAndExpand"
                            Placeholder="Buscar producto"
                            TextChanged="OnEditStockTextChanged"
                            TextColor="Black"
                            Unfocused="SearchBar_EditStockUnfocused" />

                    </Frame>


                    <Frame
                        x:Name="FrameListEditStock"
                        CornerRadius="24"
                        IsVisible="{Binding IsVisibleListEditStock}">
                        <Frame.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Offset="0.1" Color="#FFFFFF" />
                                <GradientStop Offset="1.0" Color="#FFF6ED" />
                            </LinearGradientBrush>
                        </Frame.Background>
                        <CollectionView
                            x:Name="ProductsEditStock"
                            HorizontalOptions="FillAndExpand"
                            ItemsSource="{Binding ProductsWithStock}"
                            SelectionChanged="CollectionEditStock_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand">

                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductStock">
                                    <Grid
                                        ColumnDefinitions="auto,auto,auto"
                                        RowDefinitions="*"
                                        RowSpacing="10"
                                        VerticalOptions="Start">
                                        <Label
                                            FontSize="18"
                                            Text="{Binding Id}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="1"
                                            FontSize="18"
                                            Text="{Binding Product.Description}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="18"
                                            Text="{Binding Product.WoodState}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="No se encontraron productos para editar stock"
                                    TextColor="Black"
                                    VerticalOptions="CenterAndExpand" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Frame>

                </VerticalStackLayout>

                <Grid
                    Grid.Row="3"
                    Margin="30,0,0,30"
                    ColumnDefinitions="15*,25*,15*,15*,15*,15*"
                    IsVisible="{Binding IsSelectedProductEditStock}">
                    <Label
                        FontSize="18"
                        Text="Codigo"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="Descripcion"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="Estado"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="Stock Disponible"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="4"
                        FontSize="18"
                        Text="Reserva / Proceso"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="Total"
                        TextColor="#79280F" />
                </Grid>

                <Grid
                    Grid.Row="4"
                    Margin="30,0,0,0"
                    ColumnDefinitions="15*,25*,15*,15*,15*,15*"
                    IsVisible="{Binding IsSelectedProductEditStock}"
                    RowDefinitions="*"
                    RowSpacing="10"
                    VerticalOptions="Start">
                    <Label
                        FontSize="18"
                        Text="{Binding ProductEditStock.Id}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="{Binding ProductEditStock.Product.Description}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="{Binding ProductEditStock.Product.WoodState}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="{Binding ProductEditStock.Available}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="4"
                        Margin="0,0,0,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="black">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ProductEditStock.Reserved}" />
                                <Span Text="/" />
                                <Span Text="{Binding ProductEditStock.Process}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="{Binding ProductEditStock.Quantity}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                </Grid>

                <Grid
                    Grid.Row="5"
                    Margin="30,50,0,0"
                    BackgroundColor="White">
                    <StackLayout Orientation="Horizontal">
                        <Label
                            FontSize="24"
                            Text="Ingrese nuevo Total de stock:"
                            TextColor="#79280F"
                            VerticalTextAlignment="Center" />
                        <Entry
                            Margin="20,0,0,0"
                            FontSize="24"
                            Text="{Binding QuantityEditStock}"
                            TextColor="Black"
                            WidthRequest="200" />
                    </StackLayout>

                </Grid>
                <BoxView
                    Grid.Row="6"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#D3AA84"
                        Clicked="EditStock_Clicked"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Editar Stock"
                        TextColor="#000000"
                        WidthRequest="260" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelEditStockCommand}"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Cancelar"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>


            </Grid>

            <!--  Nuevo Movimiento  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsNewMovementView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="12">

                <Label
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Movimiento de Stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Layout horizontal optimizado para landscape -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="*">
                    
                    <!-- Panel izquierdo: Búsqueda y selección de producto -->
                    <StackLayout Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
                        <!-- Búsqueda compacta -->
                        <Frame
                            Padding="0"
                            HeightRequest="35"
                            BackgroundColor="Transparent"
                            BorderColor="#797979">
                            <SearchBar
                                x:Name="SearchBarNewMovement"
                                BackgroundColor="Transparent"
                                CancelButtonColor="#79280F"
                                Focused="SearchBar_NewMovementFocused"
                                HeightRequest="30"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"
                                Placeholder="Buscar producto"
                                PlaceholderColor="#999999"
                                TextChanged="OnNewMovementTextChanged"
                                TextColor="#333333"
                                FontSize="14"
                                Unfocused="SearchBar_NewMovementUnfocused" />
                        </Frame>

                        <!-- Lista de productos compacta -->
                        <Frame
                            x:Name="FrameListNewMovoment"
                            CornerRadius="6"
                            IsVisible="{Binding IsVisibleListNewMovement}"
                            HeightRequest="140"
                            HorizontalOptions="Fill">
                            <Frame.Background>
                                <LinearGradientBrush EndPoint="0,1">
                                    <GradientStop Offset="0.1" Color="#FFFFFF" />
                                    <GradientStop Offset="1.0" Color="#FFF6ED" />
                                </LinearGradientBrush>
                            </Frame.Background>
                            <CollectionView
                                x:Name="ProductsNewMovement"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding ProductsWithStock}"
                                SelectionChanged="CollectionNewMovement_SelectionChanged"
                                SelectionMode="Single"
                                VerticalOptions="Fill">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="4" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductStock">
                                        <Grid
                                            ColumnDefinitions="60,*,60"
                                            ColumnSpacing="8"
                                            RowDefinitions="auto"
                                            Padding="6,3"
                                            VerticalOptions="Center">
                                            <Label
                                                FontSize="12"
                                                Text="{Binding Id}"
                                                TextColor="#000000"
                                                HorizontalTextAlignment="Center"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding Product.Description}"
                                                TextColor="#000000"
                                                VerticalOptions="Center"
                                                LineBreakMode="TailTruncation" />

                                            <Label
                                                Grid.Column="2"
                                                FontSize="12"
                                                Text="{Binding Product.WoodState}"
                                                TextColor="#000000"
                                                HorizontalTextAlignment="Center"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label
                                        FontSize="12"
                                        HorizontalOptions="Center"
                                        Text="No se encontraron productos"
                                        TextColor="Black"
                                        Padding="10"
                                        VerticalOptions="Center" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Frame>

                        <!-- Información del producto seleccionado compacta -->
                        <Frame IsVisible="{Binding IsSelectedProductMovement}"
                               BackgroundColor="#F5F5F5"
                               BorderColor="#CCCCCC"
                               CornerRadius="6"
                               Padding="10">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="54">
                                
                                <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,auto,auto,auto" ColumnSpacing="24" RowSpacing="4">
                                    
                                    <Label Grid.Row="1" Text="Código:" FontSize="14" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProductMovement.Id}" FontSize="14" HorizontalOptions="Start" TextColor="#000000" />
                                    
                                    <Label Grid.Row="2" Text="Descripción:" FontSize="14" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProductMovement.Product.Description}" 
                                           FontSize="14" TextColor="#000000" LineBreakMode="TailTruncation" />
                                    
                                    <Label Grid.Row="3" Text="Estado:" FontSize="11" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding ProductMovement.Product.WoodState}" FontSize="14" TextColor="#000000" />
                                </Grid>
                                
                                <!-- Stock info en una línea -->
                                <Grid Grid.Column="1" RowDefinitions="*,*,*" ColumnDefinitions="auto,*" ColumnSpacing="6">
                                    <Label Text="Disponible:" FontSize="14" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Column="1" Text="{Binding ProductMovement.Available}" FontSize="14" TextColor="#000000" />

                                    <Label Grid.Row="1" Text="Reserva/Proceso:" FontSize="14" FontAttributes="Bold" TextColor="#79280F" />
                                        <Label Grid.Row="1" Grid.Column="1" FontSize="14" TextColor="#000000">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ProductMovement.Reserved}" />
                                                    <Span Text="/" />
                                                    <Span Text="{Binding ProductMovement.Process}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    
                                    <Label Grid.Row="2" Text="Total:" FontSize="14" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProductMovement.Quantity}" FontSize="14" TextColor="#000000" />
                                    
                                </Grid>
                            </Grid>
                        </Frame>

                        <Label IsVisible="{Binding IsSelectedProductMovement,Converter = { StaticResource InvertedBoolConverter }}" 
                               TextColor="#79280F" FontSize="14" Text="Seleccione un producto para realizar movimiento"
                               HorizontalTextAlignment="Center" />
                                
                        <StackLayout Spacing="15">
                            
                            <!-- Tipo de movimiento optimizado -->
                            <Grid IsVisible="{Binding IsSelectedProductMovement}" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="auto">
                                <!-- Tipo de movimiento -->
                                <StackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="Tipo de movimiento:" 
                                           TextColor="#79280F"
                                           FontSize="14" 
                                           FontAttributes="Bold"/>
                                    <StackLayout Orientation="Horizontal" Spacing="12">
                                        <RadioButton
                                            Content="Venta"
                                            GroupName="MovementType"
                                            IsChecked="{Binding IsSale}"
                                            TextColor="#79280F"
                                            FontSize="13"
                                            Value="Sale" />
                                        <RadioButton
                                            Content="Cambio de estado"
                                            GroupName="MovementType"
                                            IsChecked="{Binding IsChangeOfState}"
                                            TextColor="#79280F"
                                            FontSize="13"
                                            Value="ChangeOfState" />
                                        <RadioButton
                                            Content="Para pérdida"
                                            GroupName="MovementType"
                                            IsChecked="{Binding IsLoss}"
                                            TextColor="#79280F"
                                            FontSize="13"
                                            Value="Loss" />
                                    </StackLayout>
                                </StackLayout>

                                <!-- Cantidad -->
                                <StackLayout Grid.Column="1" Spacing="6">
                                    <Label
                                        Text="Cantidad"
                                        TextColor="#79280F"
                                        FontSize="14"
                                        FontAttributes="Bold" />
                                    <Frame
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="Start">
                                        <Entry
                                            HorizontalTextAlignment="Start"
                                            Text="{Binding QuantityMovement}"
                                            TextColor="Black"
                                            FontSize="13"
                                            Keyboard="Numeric"                                        
                                            BackgroundColor="Transparent"
                                            Placeholder="Ingrese cantidad"
                                            HorizontalOptions="Start"
                                            HeightRequest="55" />
                                    </Frame>
                                </StackLayout>
                            </Grid>

                            <!-- Opciones condicionales -->
                            <!-- Cambio de estado -->
                            <Grid IsVisible="{Binding IsChangeOfState}" ColumnDefinitions="auto,*" ColumnSpacing="5" RowDefinitions="auto">
                                <Label Grid.Column="0"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="Siguiente estado:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center" />

                                <Frame Grid.Column="1"
                                    Padding="6"
                                    BackgroundColor="White"
                                    BorderColor="#CCCCCC"
                                    CornerRadius="5"
                                    HeightRequest="35"
                                    WidthRequest="300"
                                    HorizontalOptions="Start">
                                    <Picker
                                        ItemsSource="{Binding DependingProducts}"
                                        SelectedItem="{Binding SelectedDependingProducts}"
                                        TextColor="Black"
                                        FontSize="13"
                                        Title="Seleccione un estado"
                                        HeightRequest="55"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Fill" />
                                </Frame>
                            </Grid>

                            <!-- Venta -->
                            <Grid IsVisible="{Binding IsSale}" ColumnDefinitions="auto,*" ColumnSpacing="15" RowDefinitions="auto">
                                <Label Grid.Column="0"
                                    FontSize="14"
                                    IsVisible="{Binding IsSelectedProductMovement}"
                                    FontAttributes="Bold"
                                    Text="Cliente:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center" />

                                <Frame Grid.Column="1"
                                    Padding="3"
                                    IsVisible="{Binding IsSelectedProductMovement}"
                                    BackgroundColor="White"
                                    CornerRadius="12"
                                    HeightRequest="35"
                                    HorizontalOptions="Start">
                                    <Entry
                                        Text="{Binding SaleClient}"
                                        TextColor="Black"
                                        FontSize="13"
                                        WidthRequest="250"
                                        BackgroundColor="Transparent"
                                        Placeholder="Nombre del cliente"
                                        HeightRequest="55" />
                                </Frame>
                            </Grid>

                            <!-- Pérdida -->
                            <Grid IsVisible="{Binding IsLoss}" ColumnDefinitions="auto,*" ColumnSpacing="15" RowDefinitions="auto">
                                <Label Grid.Column="0"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="Motivo:"
                                    TextColor="#79280F"
                                    VerticalOptions="Start" />

                                <Frame Grid.Column="1"
                                    Padding="3"
                                    BackgroundColor="Transparent"
                                    BorderColor="#CCCCCC"
                                    CornerRadius="5"
                                    HeightRequest="60"
                                    HorizontalOptions="Start">
                                    <Editor
                                        Text="{Binding LossMotive}"
                                        TextColor="Black"
                                        FontSize="13"
                                        WidthRequest="450"
                                        Margin="0,10,0,0"
                                        Placeholder="Motivo de la pérdida"
                                        HeightRequest="80"
                                        AutoSize="TextChanges" />
                                </Frame>
                            </Grid>
                        </StackLayout>
                   
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="0,10,0,0"
                    Color="#79280F" />

                <!-- Botones optimizados para horizontal -->
                <Grid
                    Grid.Row="4"
                    Margin="0,12,0,5"
                    ColumnDefinitions="*,180,180,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#D3AA84"
                        Clicked="NewMovement_Clicked"
                        HeightRequest="36"
                        Text="{Binding OkMovementText}"
                        TextColor="#000000"
                        FontSize="14"
                        CornerRadius="5" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelNewMovementCommand}"
                        HeightRequest="36"
                        Text="Cancelar"
                        TextColor="#000000"
                        FontSize="14"
                        CornerRadius="5" />
                </Grid>

            </Grid>

            <!--  Inventario  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsInventoryView}"
                RowDefinitions="auto,auto,35,auto,*,auto,auto"
                RowSpacing="5">
                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Inventario"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Frame
                    Grid.Row="2"
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderColor="#797979">
                    <SearchBar
                        x:Name="SearchBarInventory"
                        BackgroundColor="LightGray"
                        CancelButtonColor="Black"
                        HeightRequest="55"
                        HorizontalOptions="StartAndExpand"
                        Placeholder="Buscar producto"
                        TextChanged="OnSearchStockInventoryTextChanged"
                        TextColor="Black" />
                </Frame>

                <HorizontalStackLayout Grid.Row="3" Margin="30,0,0,0">
                    <Label
                        FontSize="18"
                        Text="#Codigo"
                        TextColor="#79280F" />
                    <Label
                        Margin="148,0,0,0"
                        FontSize="18"
                        Text="Descripcion"
                        TextColor="#79280F" />
                    <Label
                        Margin="135,0,0,0"
                        FontSize="18"
                        Text="Estado"
                        TextColor="#79280F" />
                    <Label
                        Margin="180,0,0,0"
                        FontSize="18"
                        Text="Ubicación"
                        TextColor="#79280F" />
                </HorizontalStackLayout>

                <CollectionView
                    x:Name="ProductsSearchStockInventory"
                    Grid.Row="4"
                    Margin="30,0,30,0"
                    ItemsSource="{Binding Products}"
                    SelectionMode="Single"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Grid
                                ColumnDefinitions="230,230,240,140,*,60"
                                RowDefinitions="*"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding Description}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="{Binding WoodState}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="18"
                                    Text="{Binding Location}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Button
                                    Grid.Column="4"
                                    BackgroundColor="Transparent"
                                    Clicked="VisivilityProduct_Clicked"
                                    HorizontalOptions="End"
                                    ImageSource="visibility.png" />
                                <Button
                                    Grid.Column="5"
                                    BackgroundColor="Transparent"
                                    Clicked="DeleteProduct_Clicked"
                                    ImageSource="delete_item_icon.png" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <BoxView
                    Grid.Row="5"
                    Margin="0,0,0,40"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />



            </Grid>

            <!--  Inventario vista de productos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsInventoryEditView}"
                RowDefinitions="auto,auto,auto,*,*,*,auto"
                RowSpacing="5">
                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Inventario"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Grid
                    Grid.Row="2"
                    Margin="30,0,0,0"
                    ColumnDefinitions="*,*,*,*,*"
                    RowDefinitions="*,*">
                    <Label
                        FontSize="24"
                        Text="Codigo"
                        TextColor="#79280F" />
                    <Label
                        Grid.Row="1"
                        FontSize="24"
                        Text="{Binding SelectedProduct.Id}" />
                    <Label
                        Grid.Column="1"
                        FontSize="24"
                        Text="Descripcion"
                        TextColor="#79280F" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="24"
                        Text="{Binding SelectedProduct.Description}" />
                    <Label
                        Grid.Column="2"
                        FontSize="24"
                        Text="Estado"
                        TextColor="#79280F" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        FontSize="24"
                        Text="{Binding SelectedProduct.WoodState}" />
                    <Label
                        Grid.Column="3"
                        FontSize="24"
                        Text="Ubicación"
                        TextColor="#79280F" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="3"
                        FontSize="24"
                        Text="{Binding SelectedProduct.Location}" />
                </Grid>

                <VerticalStackLayout Grid.Row="3" Margin="30,90,0,0">
                    <Label
                        FontSize="24"
                        Text="Comentarios:"
                        TextColor="#79280F"
                        VerticalOptions="EndAndExpand" />
                    <Label FontSize="24" Text="{Binding SelectedProduct.Comment}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Row="4"
                    Margin="30,0,0,0"
                    VerticalOptions="CenterAndExpand">
                    <Label
                        FontSize="24"
                        Text="Proveedor:"
                        TextColor="#79280F" />
                    <Label FontSize="24" Text="{Binding SelectedProduct.Supplier}" />
                </VerticalStackLayout>

                <BoxView
                    Grid.Row="5"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="6"
                    Margin="0,20,0,30"
                    HeightRequest="30"
                    HorizontalOptions="Center"
                    Spacing="50"
                    VerticalOptions="Start">
                    <Button
                        BackgroundColor="#D3AA84"
                        Clicked="BackToInventory_Clicked"
                        FontSize="18"
                        HeightRequest="50"
                        Text="Volver"
                        TextColor="Black"
                        VerticalOptions="Start"
                        WidthRequest="300" />
                    <Button
                        BackgroundColor="#FFF6ED"
                        Clicked="EditProductPage_Clicked"
                        FontSize="18"
                        HeightRequest="50"
                        Text="Editar"
                        TextColor="Black"
                        VerticalOptions="Start"
                        WidthRequest="300" />
                </HorizontalStackLayout>


            </Grid>

            <!--  Inventario vista de edicion de productos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsInventoryEditProductView}"
                RowDefinitions="auto,auto,auto,*,*,*,auto"
                RowSpacing="5">
                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Inventario"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Grid
                    Grid.Row="2"
                    Margin="30,0,0,0"
                    ColumnDefinitions="*,*,*,*,*"
                    RowDefinitions="*,*">
                    <Label
                        FontSize="24"
                        Text="Codigo"
                        TextColor="#79280F" />
                    <Label
                        Grid.Row="1"
                        FontSize="24"
                        Text="{Binding SelectedProduct.Id}" />
                    <Label
                        Grid.Column="1"
                        FontSize="24"
                        Text="Descripcion"
                        TextColor="#79280F" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="24"
                        Text="{Binding SelectedProduct.Description}" />
                    <Label
                        Grid.Column="2"
                        FontSize="24"
                        Text="Estado"
                        TextColor="#79280F" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        FontSize="24"
                        Text="{Binding SelectedProduct.WoodState}" />

                    <Label
                        Grid.Column="3"
                        FontSize="24"
                        Text="Ubicación"
                        TextColor="#79280F" />
                    <Entry
                        Grid.Row="1"
                        Grid.Column="3"
                        FontSize="24"
                        Text="{Binding ProductLocationEdit}" />
                </Grid>

                <VerticalStackLayout Grid.Row="3" Margin="30,90,0,0">
                    <Label
                        FontSize="24"
                        Text="Comentarios:"
                        TextColor="#79280F"
                        VerticalOptions="EndAndExpand" />
                    <Editor FontSize="24" Text="{Binding ProductCommentEdit}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Row="4"
                    Margin="30,0,0,0"
                    VerticalOptions="CenterAndExpand">
                    <Label
                        FontSize="24"
                        Text="Proveedor:"
                        TextColor="#79280F" />
                    <Entry FontSize="24" Text="{Binding ProduSupplierEdit}" />
                </VerticalStackLayout>

                <BoxView
                    Grid.Row="5"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="6"
                    Margin="0,20,0,30"
                    HeightRequest="30"
                    HorizontalOptions="Center"
                    Spacing="50"
                    VerticalOptions="Start">
                    <Button
                        BackgroundColor="#D3AA84"
                        Clicked="SaveEditProductPage_Clicked"
                        FontSize="18"
                        HeightRequest="50"
                        Text="Guardar"
                        TextColor="Black"
                        VerticalOptions="Start"
                        WidthRequest="300" />
                    <Button
                        BackgroundColor="#FFF6ED"
                        Clicked="CancelEditProductPage_Clicked"
                        FontSize="18"
                        HeightRequest="50"
                        Text="Cancelar"
                        TextColor="Black"
                        VerticalOptions="Start"
                        WidthRequest="300" />
                </HorizontalStackLayout>


            </Grid>

            <!--  Consultar stock  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsCheckStockView}"
                RowDefinitions="auto,auto,auto,auto,*,auto,auto"
                RowSpacing="5">
                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Consulta de stock"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Frame
                    Grid.Row="2"
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderColor="#797979">
                    <SearchBar
                        x:Name="SearchBarSeachStock"
                        BackgroundColor="LightGray"
                        CancelButtonColor="Black"
                        HeightRequest="55"
                        HorizontalOptions="StartAndExpand"
                        Placeholder="Buscar producto"
                        TextChanged="OnSearchStockTextChanged"
                        TextColor="Black" />
                </Frame>

                <HorizontalStackLayout Grid.Row="3" Margin="30,0,0,0">
                    <Label
                        FontSize="18"
                        Text="#Codigo"
                        TextColor="#79280F" />
                    <Label
                        Margin="145,0,0,0"
                        FontSize="18"
                        Text="Descripcion"
                        TextColor="#79280F" />
                    <Label
                        Margin="115,0,0,0"
                        FontSize="18"
                        Text="Estado"
                        TextColor="#79280F" />
                    <Label
                        Margin="160,0,0,0"
                        FontSize="18"
                        Text="Disponible"
                        TextColor="#79280F" />
                    <Label
                        Margin="70,0,0,0"
                        FontSize="18"
                        Text="Reserva/Proceso"
                        TextColor="#79280F" />
                    <Label
                        Margin="125,0,0,0"
                        FontSize="18"
                        Text="Total"
                        TextColor="#79280F" />
                </HorizontalStackLayout>

                <CollectionView
                    x:Name="ProductsSearchStock"
                    Grid.Row="4"
                    Margin="30,0,30,0"
                    ItemsSource="{Binding Stock, Mode=TwoWay}"
                    SelectionMode="None"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductStock">
                            <Grid
                                ColumnDefinitions="*,*,*,*,*,*"
                                RowDefinitions="*"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding Product.Description}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="{Binding Product.WoodState}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="18"
                                    Text="{Binding Available}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="4"
                                    Margin="0,0,6,0"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    TextColor="black">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Reserved}" />
                                            <Span Text="/" />
                                            <Span Text="{Binding Process}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label
                                    Grid.Column="5"
                                    FontSize="18"
                                    Text="{Binding Quantity}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <BoxView
                    Grid.Row="5"
                    Margin="0,0,0,40"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />
            </Grid>

            <!--  Tareas  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsTasksView}"
                RowDefinitions="auto,auto,*"
                RowSpacing="10">

                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    FontSize="24"
                    HorizontalOptions="Start"
                    Text="Tareas"
                    TextColor="#79280F"
                    VerticalOptions="Start" />
                    
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Lista de opciones compacta -->
                <StackLayout Grid.Row="2" Spacing="15" HorizontalOptions="Start" MaximumWidthRequest="600">
                    <!-- Administrar tareas -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="add_stock_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ManagementTasks" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Administrar tareas"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ManagementTasks" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Crear Tarea -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="new_movement_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CreateTask" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Crear Tarea"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CreateTask" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                </StackLayout>
            </Grid>

            <!--  Crear Tareas  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15,20,15,15"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsCreateTaskView}"
                RowDefinitions="auto,auto,*,auto,auto"
                RowSpacing="12">

                <Label
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Nueva Tarea"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Layout horizontal optimizado para landscape -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="*">
                    
                    <!-- Panel izquierdo: Búsqueda y selección de producto -->
                    <StackLayout Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
                        <!-- Búsqueda compacta -->
                        <Frame
                            Padding="0"
                            HeightRequest="35"
                            BackgroundColor="Transparent"
                            BorderColor="#797979">
                            <SearchBar
                                x:Name="SearchBarNewTask"
                                BackgroundColor="Transparent"
                                CancelButtonColor="#79280F"
                                Focused="SearchBar_NewTaskFocused"
                                HeightRequest="30"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"
                                Placeholder="Buscar producto"
                                PlaceholderColor="#999999"
                                TextChanged="OnNewTaskTextChanged"
                                TextColor="#333333"
                                FontSize="14"
                                Unfocused="SearchBar_NewTaskUnfocused" />
                        </Frame>

                        <!-- Lista de productos compacta -->
                        <Frame
                            x:Name="FrameListNewTask"
                            CornerRadius="6"
                            IsVisible="{Binding IsVisibleListNewTask}"
                            HeightRequest="140"
                            HorizontalOptions="Fill">
                            <Frame.Background>
                                <LinearGradientBrush EndPoint="0,1">
                                    <GradientStop Offset="0.1" Color="#FFFFFF" />
                                    <GradientStop Offset="1.0" Color="#FFF6ED" />
                                </LinearGradientBrush>
                            </Frame.Background>
                            <CollectionView
                                x:Name="ProductsNewTask"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding ProductsWithStock}"
                                SelectionChanged="CollectionNewTask_SelectionChanged"
                                SelectionMode="Single"
                                VerticalOptions="Fill">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="4" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductStock">
                                        <Grid
                                            ColumnDefinitions="60,*,60"
                                            ColumnSpacing="8"
                                            RowDefinitions="auto"
                                            Padding="6,3"
                                            VerticalOptions="Center">
                                            <Label
                                                FontSize="12"
                                                Text="{Binding Id}"
                                                TextColor="#000000"
                                                HorizontalTextAlignment="Center"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding Product.Description}"
                                                TextColor="#000000"
                                                VerticalOptions="Center"
                                                LineBreakMode="TailTruncation" />

                                            <Label
                                                Grid.Column="2"
                                                FontSize="12"
                                                Text="{Binding Product.WoodState}"
                                                TextColor="#000000"
                                                HorizontalTextAlignment="Center"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label
                                        FontSize="12"
                                        HorizontalOptions="Center"
                                        Text="No se encontraron productos"
                                        TextColor="Black"
                                        Padding="10"
                                        VerticalOptions="Center" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Frame>

                        <!-- Información del producto seleccionado compacta -->
                        <Frame IsVisible="{Binding IsSelectedProductTask}"
                               BackgroundColor="#F5F5F5"
                               BorderColor="#CCCCCC"
                               CornerRadius="6"
                               Padding="10">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="54">
                                
                                <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,auto,auto,auto" ColumnSpacing="24" RowSpacing="4">
                                    
                                    <Label Grid.Row="1" Text="Código:" FontSize="14" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="1"  Grid.Column="1" Text="{Binding ProductTask.Id}" FontSize="14" HorizontalOptions="Start" TextColor="#000000" />
                                    
                                    <Label Grid.Row="2" Text="Descripción:" FontSize="14" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProductTask.Product.Description}" 
                                           FontSize="14" TextColor="#000000" LineBreakMode="TailTruncation" />
                                    
                                    <Label Grid.Row="3" Text="Estado:" FontSize="11" FontAttributes="Bold" TextColor="#79280F" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding ProductTask.Product.WoodState}" FontSize="14" TextColor="#000000" />
                                </Grid>
                                
                                <!-- Stock info en una línea -->
                                <Grid Grid.Column="1" RowDefinitions="*,*,*" ColumnDefinitions="auto,*" ColumnSpacing="6">
                                    <Label Text="Disponible:" FontSize="14" FontAttributes="Bold" TextColor="#79280F"  />
                                    <Label Grid.Column="1" Text="{Binding ProductTask.Available}" FontSize="14" TextColor="#000000"  />

                                    <Label Grid.Row="1" Text="Reserva/Proceso:" FontSize="14" FontAttributes="Bold" TextColor="#79280F"  />
                                        <Label Grid.Row="1" Grid.Column="1" FontSize="14" TextColor="#000000" >
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ProductTask.Reserved}" />
                                                    <Span Text="/" />
                                                    <Span Text="{Binding ProductTask.Process}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    
                                    <Label Grid.Row="2" Text="Total:" FontSize="14" FontAttributes="Bold" TextColor="#79280F"  />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProductTask.Quantity}" FontSize="14" TextColor="#000000"  />
                                    
                                </Grid>
                            </Grid>
                        </Frame>

                        <Label IsVisible="{Binding IsSelectedProductTask,Converter = { StaticResource InvertedBoolConverter }}" 
                               TextColor="#79280F" FontSize="14" Text="Seleccione un producto para crear una tarea"
                               HorizontalTextAlignment="Center" />
                                <StackLayout Spacing="15">
                            
                            <!-- Fila 1: Prioridad y Cantidad en horizontal -->
                            <Grid IsVisible="{Binding IsSelectedProductTask}" ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="auto">
                                <!-- Prioridad -->
                                <StackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="¿Dar prioridad?" 
                                           TextColor="#79280F"
                                           FontSize="14" 
                                           FontAttributes="Bold"/>
                                    <StackLayout Orientation="Horizontal" Spacing="12">
                                        <RadioButton
                                            Content="No"
                                            GroupName="PriorityType"
                                            IsChecked="{Binding IsNoPriorityTask}"
                                            TextColor="#79280F"
                                            FontSize="13"
                                            Value="no" />
                                        <RadioButton
                                            Content="Sí"
                                            TextColor="#79280F"
                                            FontSize="13"
                                            GroupName="PriorityType"
                                            IsChecked="{Binding IsYesPriorityTask}"
                                            Value="yes" />
                                    </StackLayout>
                                </StackLayout>

                                <!-- Cantidad -->
                                <StackLayout Grid.Column="1" Spacing="6">
                                    <Label
                                        Text="Cantidad a procesar"
                                        TextColor="#79280F"
                                        FontSize="14"
                                        FontAttributes="Bold" />
                                <Frame
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="Start">
                                    <Entry
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding QuantityTask}"
                                        TextColor="Black"
                                        FontSize="13"
                                        Keyboard="Numeric"                                        
                                        BackgroundColor="Transparent"
                                        Placeholder="Ingrese cantidad"
                                        HorizontalOptions="Start"
                                        HeightRequest="55" />
                                        </Frame>
                                </StackLayout>
                            </Grid>

                            <!-- Producto final en una línea -->
                            <Grid IsVisible="{Binding IsSelectedProductTask}" ColumnDefinitions="150,*" ColumnSpacing="15" RowDefinitions="auto,auto">
                                <Label Grid.Column="0"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="Producto final:"
                                    TextColor="#79280F"
                                    VerticalOptions="Center" />

                                <Frame Grid.Column="1"
                                    Padding="6"
                                    BackgroundColor="White"
                                    BorderColor="#CCCCCC"
                                    CornerRadius="5"
                                    HeightRequest="32"
                                    HorizontalOptions="Fill">
                                    <Label
                                        FontSize="13"
                                        TextColor="Black"
                                        Text="{Binding SelectedDerivateProducts, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Fill" />
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectProductDerivateTaskCommand}" />
                                    </Frame.GestureRecognizers>
                                </Frame>

                                <Frame Grid.Row="1" Grid.ColumnSpan="2"
                                    CornerRadius="5"
                                    HeightRequest="100"
                                    IsVisible="{Binding IsVisibleListProductsDerivateTask}"
                                    Padding="6"
                                    HorizontalOptions="Fill">
                                    <Frame.Background>
                                        <LinearGradientBrush EndPoint="0,1">
                                            <GradientStop Offset="0.1" Color="#FFFFFF" />
                                            <GradientStop Offset="1.0" Color="#FFF6ED" />
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <CollectionView
                                        x:Name="ProductListDerivateTask"
                                        HeightRequest="100"
                                        HorizontalOptions="Fill"
                                        ItemsSource="{Binding DerivateProducts}"
                                        SelectionChanged="ProductDerivate_SelectionChanged"
                                        SelectionMode="Single"
                                        VerticalOptions="Fill">

                                        <CollectionView.ItemsLayout>
                                            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="3" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:Product">
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding .}"
                                                    TextColor="#000000"
                                                    Padding="3"
                                                    VerticalOptions="Center" />
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Frame>
                            </Grid>

                            <!-- Comentarios compactos -->
                            <Grid IsVisible="{Binding IsSelectedProductTask}" ColumnDefinitions="150,*" ColumnSpacing="15" RowDefinitions="auto">
                                <Label Grid.Column="0"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="Comentarios:"
                                    TextColor="#79280F"
                                    VerticalOptions="Start" />

                                <Frame Grid.Column="1"
                                    Padding="3"
                                    BackgroundColor="Transparent"
                                    BorderColor="#CCCCCC"
                                    CornerRadius="5"
                                    HeightRequest="60"
                                    HorizontalOptions="Fill">
                                    <Editor
                                        AutoSize="TextChanges"
                                        FontSize="13"
                                        Margin="0,10,0,0"
                                        HeightRequest="80"
                                        HorizontalOptions="Fill"
                                        Text="{Binding CommentsTask}"
                                        TextColor="Black"
                                        Placeholder="Comentarios adicionales..."
                                        VerticalOptions="Fill" />
                                </Frame>
                            </Grid>
                        </StackLayout>
                   
                    </StackLayout>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="0,10,0,0"
                    Color="#79280F" />

                <!-- Botones optimizados para horizontal -->
                <Grid
                    Grid.Row="4"
                    Margin="0,12,0,5"
                    ColumnDefinitions="*,180,180,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#D3AA84"
                        Clicked="CreateTask_Clicked"
                        HeightRequest="36"
                        Text="Crear Tarea"
                        TextColor="#000000"
                        FontSize="14"
                        CornerRadius="5" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelCreateTaskCommand}"
                        HeightRequest="36"
                        Text="Cancelar"
                        TextColor="#000000"
                        FontSize="14"
                        CornerRadius="5" />
                </Grid>

            </Grid>

            <!--  Historial de Tareas  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsHistoryOfTaskView}"
                RowDefinitions="auto,auto,auto,auto,auto,*,auto"
                RowSpacing="5">

                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Historial de Tarea"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Frame
                    Grid.Row="2"
                    Padding="0"
                    Margin="0,0,0,20"
                    BackgroundColor="Transparent"
                    BorderColor="#797979">
                    <SearchBar
                        x:Name="SearchBarTask"
                        BackgroundColor="LightGray"
                        CancelButtonColor="Black"
                        HeightRequest="55"
                        HorizontalOptions="StartAndExpand"
                        Placeholder="Buscar tarea"
                        TextChanged="OnSearchTaskTextChanged"
                        TextColor="Black" />
                </Frame>

                <Grid Grid.Row="3" ColumnDefinitions="10*,20*,10*,20*,15*,15*,5*,5*" Margin="30,0,0,0">
                    <Label
                        FontSize="18"
                        Text="#Codigo"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="Producto inicial"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="Cantidad"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="Producto final"
                        TextColor="#79280F" />
                        <Label
                        Grid.Column="4"
                        FontSize="18"
                        Text="Estado"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="Fecha"
                        TextColor="#79280F" />

                </Grid>

                <CollectionView
                    x:Name="TaskItemsSearch"
                    Grid.Row="4"
                    Margin="30,10,30,0"
                    ItemsSource="{Binding TaskItems}"
                    SelectionMode="Single"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskItem">
                            <Grid
                                ColumnDefinitions="10*,20*,10*,20*,15*,15*,5*,5*"
                                RowDefinitions="*"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding ProductSource}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="{Binding Quantity}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="18"
                                    Text="{Binding ProductDestination}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="4"
                                    FontSize="18"
                                    Text="{Binding TaskStatus}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="5"
                                    FontSize="18"
                                    Text="{Binding CreatedAt}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Button
                                    Grid.Column="6"
                                    BackgroundColor="Transparent"
                                    Clicked="VisivilityTaskItemEdit_Clicked"
                                    HorizontalOptions="End"
                                    ImageSource="visibility.png" />
                                <Button
                                    Grid.Column="7"
                                    BackgroundColor="Transparent"
                                    Clicked="VisivilityTaskItem_Clicked"
                                    ImageSource="delete_item_icon.png" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <BoxView
                    Grid.Row="5"
                    Margin="0,0,0,40"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

            </Grid>

            <!--  Editar Tarea  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsTaskItemEditView}"
                RowDefinitions="auto,auto,auto,auto,auto,auto,*,auto"
                RowSpacing="5">

                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Editar Tarea"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <VerticalStackLayout
                    Grid.Row="2"
                    Margin="0,0,0,20"
                    Padding="0,0,0,0">
                    <Frame
                        Margin="0"
                        Padding="10,-3,10,-3"
                        BackgroundColor="LightGray"
                        CornerRadius="24"
                        HeightRequest="55">
                        <SearchBar
                            x:Name="SearchBarEditTask"
                            BackgroundColor="LightGray"
                            CancelButtonColor="Black"
                            Focused="SearchBar_EditTaskFocused"
                            HeightRequest="55"
                            HorizontalOptions="StartAndExpand"
                            Placeholder="Buscar producto"
                            TextChanged="OnEditTaskTextChanged"
                            TextColor="Black"
                            Unfocused="SearchBar_EditTaskUnfocused" />

                    </Frame>


                    <Frame
                        x:Name="FrameListEditTask"
                        CornerRadius="24"
                        IsVisible="{Binding IsVisibleListNewTask}">
                        <Frame.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Offset="0.1" Color="#FFFFFF" />
                                <GradientStop Offset="1.0" Color="#FFF6ED" />
                            </LinearGradientBrush>
                        </Frame.Background>
                        <CollectionView
                            x:Name="ProductsEditTask"
                            HorizontalOptions="FillAndExpand"
                            ItemsSource="{Binding ProductsWithStock}"
                            SelectionChanged="CollectionEditTask_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand">

                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductStock">
                                    <Grid
                                        ColumnDefinitions="auto,auto,auto"
                                        ColumnSpacing="70"
                                        RowDefinitions="*"
                                        RowSpacing="10"
                                        VerticalOptions="Start">
                                        <Label
                                            FontSize="18"
                                            Text="{Binding Id}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="1"
                                            FontSize="18"
                                            Text="{Binding Product.Description}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="18"
                                            Text="{Binding Product.WoodState}"
                                            TextColor="#000000"
                                            VerticalOptions="Start" />

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="No se encontraron productos para realizar movimientos"
                                    TextColor="Black"
                                    VerticalOptions="CenterAndExpand" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Frame>

                </VerticalStackLayout>

                <StackLayout
                    Grid.Row="3"
                    Margin="30,0,0,30"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsSelectedProductTask}"
                    Orientation="Horizontal">
                    <Grid ColumnDefinitions="15*,25*,15*,15*,15*,15*" HorizontalOptions="FillAndExpand">
                        <Label
                            FontSize="18"
                            Text="Codigo"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="1"
                            FontSize="18"
                            Text="Descripcion"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="2"
                            FontSize="18"
                            Text="Estado"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="3"
                            FontSize="18"
                            Text="Stock Disponible"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="4"
                            FontSize="18"
                            Text="Reserva / Proceso"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="5"
                            FontSize="18"
                            Text="Total"
                            TextColor="#79280F" />
                    </Grid>
                </StackLayout>

                <Grid
                    Grid.Row="4"
                    Margin="30,0,0,0"
                    ColumnDefinitions="15*,25*,15*,15*,15*,15*"
                    IsVisible="{Binding IsSelectedProductTask}"
                    RowDefinitions="*"
                    RowSpacing="10"
                    VerticalOptions="Start">
                    <Label
                        FontSize="18"
                        Text="{Binding ProductTask.Id}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="{Binding ProductTask.Product.Description}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="{Binding ProductTask.Product.WoodState}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="{Binding ProductTask.Available}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="black">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ProductTask.Reserved}" />
                                <Span Text="/" />
                                <Span Text="{Binding ProductTask.Process}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="{Binding ProductTask.Quantity}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                </Grid>

                
                    <Grid Margin="35,50,0,0"  Grid.Row="5"  RowDefinitions="auto,auto,auto,auto" RowSpacing="45">
                        <HorizontalStackLayout Spacing="25">
                            <Label Text="¿Dar prioridad?" FontSize="18" TextColor="#79280F" />
                            <HorizontalStackLayout>
                                <RadioButton
                                    Content="No"
                                    GroupName="PriorityTypeEdit"
                                    IsChecked="{Binding IsNoPriorityTask}"
                                    TextColor="Black"
                                    Value="no" />
                                <RadioButton
                                    Content="Si"
                                    GroupName="PriorityTypeEdit"
                                    IsChecked="{Binding IsYesPriorityTask}"
                                    TextColor="Black"
                                    Value="si" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Spacing="25">
                            <Label
                                Text="Cantidad"
                                FontSize="18" TextColor="#79280F"
                                VerticalOptions="Center" />
                            <Entry
                                HorizontalTextAlignment="End"
                                Text="{Binding QuantityTask}"
                                TextColor="Black"
                                WidthRequest="150" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="2">
                            <Label
                                FontSize="18"
                                Text="Producto final"
                                TextColor="#79280F"
                                VerticalOptions="Center" />

                            <StackLayout
                                Margin="70,20,0,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="270">
                                <Frame
                                    Margin="0"
                                    Padding="10,-3,10,-3"
                                    BackgroundColor="White"
                                    CornerRadius="18"
                                    HeightRequest="40">
                                    <Label
                                        FontSize="14"
                                        Text="{Binding SelectedDerivateProducts, Mode=TwoWay}"
                                        TextColor="Black"
                                        VerticalOptions="Center">
                                        

                                    </Label>
                                    <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectProductDerivateTaskCommand}" />
                                        </Frame.GestureRecognizers>
                                </Frame>
                                <Frame
                                    CornerRadius="24"
                                    HeightRequest="140"
                                    IsVisible="{Binding IsVisibleListProductsDerivateTask}"
                                    VerticalOptions="Start">
                                    <Frame.Background>
                                        <LinearGradientBrush EndPoint="0,1">
                                            <GradientStop Offset="0.1" Color="#FFFFFF" />
                                            <GradientStop Offset="1.0" Color="#FFF6ED" />
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <CollectionView
                                        x:Name="ProductListDerivateEditTask"
                                        HeightRequest="140"
                                        HorizontalOptions="Start"
                                        ItemsSource="{Binding DerivateProducts}"
                                        SelectionChanged="ProductDerivateEdit_SelectionChanged"
                                        SelectionMode="Single"
                                        VerticalOptions="Start">

                                        <CollectionView.ItemsLayout>
                                            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:Product">
                                                <Label
                                                    Grid.Column="2"
                                                    FontSize="18"
                                                    Text="{Binding .}"
                                                    TextColor="#000000"
                                                    VerticalOptions="Start" />
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Frame>
                            </StackLayout>


                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="3">
                            <Label
                                Grid.Row="0"
                                Grid.Column="2"
                                HorizontalOptions="Start"
                                Text="Comentarios"
                                FontSize="18" TextColor="#79280F"
                                VerticalOptions="Center" />

                            <Frame
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Margin="30,0,0,0"
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderColor="#797979"
                                WidthRequest="550">
                                <Editor
                                    AutoSize="TextChanges"
                                    FontSize="18"
                                    HeightRequest="75"
                                    HorizontalOptions="FillAndExpand"
                                    Text="{Binding CommentsTask}"
                                    TextColor="Black"
                                    VerticalOptions="FillAndExpand" />
                            </Frame>
                        </HorizontalStackLayout>
                    </Grid>
                
                <BoxView
                    Grid.Row="6"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#D3AA84"
                        Clicked="EditTask_Clicked"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Editar Tarea"
                        TextColor="#000000"
                        WidthRequest="260" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelEditTaskCommand}"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Cancelar"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>


            </Grid>

            <!--  Ver Tarea  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsTaskItemView}"
                RowDefinitions="auto,auto,auto,auto,auto,auto,*,auto"
                RowSpacing="5">

                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Tarea"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <StackLayout
                    Grid.Row="3"
                    Margin="30,0,0,30"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsSelectedProductTask}"
                    Orientation="Horizontal">
                    <Grid ColumnDefinitions="15*,25*,15*,15*,15*,15*" HorizontalOptions="FillAndExpand">
                        <Label
                            FontSize="18"
                            Text="Codigo"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="1"
                            FontSize="18"
                            Text="Descripcion"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="2"
                            FontSize="18"
                            Text="Estado"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="3"
                            FontSize="18"
                            Text="Stock Disponible"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="4"
                            FontSize="18"
                            Text="Reserva / Proceso"
                            TextColor="#79280F" />
                        <Label
                            Grid.Column="5"
                            FontSize="18"
                            Text="Total"
                            TextColor="#79280F" />
                    </Grid>
                </StackLayout>

                <Grid
                    Grid.Row="4"
                    Margin="30,0,0,0"
                    ColumnDefinitions="15*,25*,15*,15*,15*,15*"
                    IsVisible="{Binding IsSelectedProductTask}"
                    RowDefinitions="*"
                    RowSpacing="10"
                    VerticalOptions="Start">
                    <Label
                        FontSize="18"
                        Text="{Binding ProductTask.Id}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="{Binding ProductTask.Product.Description}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="{Binding ProductTask.Product.WoodState}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="{Binding ProductTask.Available}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                    <Label
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="black">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ProductTask.Reserved}" />
                                <Span Text="/" />
                                <Span Text="{Binding ProductTask.Process}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label
                        Grid.Column="5"
                        FontSize="18"
                        Text="{Binding ProductTask.Quantity}"
                        TextColor="#000000"
                        VerticalOptions="Start" />

                </Grid>

                <Grid Grid.Row="5"
                    Margin="30,100,0,0" RowDefinitions="auto,auto,auto, auto" RowSpacing="45">
                        <HorizontalStackLayout Spacing="25">
                            <Label Text="¿Dar prioridad?" FontSize="18"
                                TextColor="#79280F"/>
                            <Label Text="{Binding SelectedTaskItem.Priority, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Sí|No'}"  />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Spacing="25">
                            <Label
                                Text="Cantidad"
                                FontSize="18"
                                TextColor="#79280F"
                                VerticalOptions="Center" />
                            <Label
                                HorizontalTextAlignment="End"
                                Text="{Binding QuantityTask}"
                                TextColor="Black"
                                WidthRequest="150" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="2" >
                            <Label
                                FontSize="18"
                                Text="Producto final"
                                TextColor="#79280F"
                                VerticalOptions="Center" />

                            <StackLayout
                                Margin="70,20,0,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="270">
                                <Frame
                                    Margin="0"
                                    Padding="10,-3,10,-3"
                                    BackgroundColor="White"
                                    CornerRadius="18"
                                    HeightRequest="40">
                                    <Label
                                        FontSize="14"
                                        Text="{Binding SelectedDerivateProducts, Mode=TwoWay}"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                </Frame>
                            </StackLayout>


                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="3">
                            <Label
                                Grid.Row="0"
                                Grid.Column="2"
                                FontSize="18"
                                HeightRequest="75"
                                TextColor="#79280F"
                                HorizontalOptions="Start"
                                Text="Comentarios"
                                VerticalOptions="Center" />

                            
                                <Label
                                    Margin="40,0,0,0"
                                    FontSize="18"
                                    HeightRequest="75"
                                    HorizontalOptions="FillAndExpand"
                                    Text="{Binding CommentsTask}"
                                    TextColor="Black"
                                    VerticalOptions="FillAndExpand" />
                        </HorizontalStackLayout>
                    </Grid>
               
                <BoxView
                    Grid.Row="6"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding BackViewTaskCommand}"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Volver"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>


            </Grid>


            <!--  Reservas y Pedidos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsOrdersView}"
                RowDefinitions="auto,auto,*"
                RowSpacing="10">

                <!-- Título principal -->
                <Label
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    FontSize="24"
                    HorizontalOptions="Start"
                    Text="Reservas y Pedidos"
                    TextColor="#79280F"
                    VerticalOptions="Start" />
                    
                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Lista de opciones compacta -->
                <StackLayout Grid.Row="2" Spacing="15" HorizontalOptions="Start" MaximumWidthRequest="600">
                    <!-- Nuevo Pedido/Reserva -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="add_stock_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CreateBookingOrder" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Nuevo Pedido/Reserva"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="CreateBookingOrder" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Lista de Reservas -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="new_movement_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ListBooking" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Lista de Reservas"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ListBooking" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <!-- Lista de Pedidos -->
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Source="new_movement_icon_small.png"
                            WidthRequest="40"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ListOrders" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontSize="20"
                            HorizontalOptions="Start"
                            Text="Lista de Pedidos"
                            TextColor="#303030"
                            VerticalOptions="Center"
                            MinimumWidthRequest="200">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="ListOrders" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                </StackLayout>
            </Grid>

            <!--  Crear reservas o pedidos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="15"
                BackgroundColor="White"
                ColumnDefinitions="*,1.5*"
                ColumnSpacing="20"
                IsVisible="{Binding IsVisibleCreateBookingOrderView}"
                RowDefinitions="auto,auto,*,auto"
                RowSpacing="5"
                VerticalOptions="FillAndExpand">

                <!-- Título -->
                <Label
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,0"
                    FontSize="22"
                    HorizontalOptions="Start"
                    Text="Nueva reserva o pedido"
                    TextColor="#79280F"
                    VerticalOptions="Center" />
                
                <!-- Separador -->
                <BoxView
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Formulario principal compacto -->
                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="15"
                    RowDefinitions="auto,auto,auto,auto,auto"
                    RowSpacing="8">
                    
                    <!-- Tipo y Cliente -->
                    <StackLayout Grid.Column="0" Spacing="8" Grid.ColumnSpan="2">
                        <Label Text="Tipo:" FontSize="14" TextColor="#79280F"/>
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <RadioButton
                                Content="Reserva"
                                GroupName="BookingOrderType"
                                IsChecked="{Binding IsBooking}"
                                FontSize="12"
                                TextColor="Black"
                                Value="reserva" />
                            <RadioButton
                                Content="Pedido"
                                GroupName="BookingOrderType"
                                IsChecked="{Binding IsOrder}"
                                FontSize="12"
                                TextColor="Black"
                                Value="pedido" />
                        </StackLayout>
                        
                        <Label Text="Cliente" TextColor="#79280F" FontSize="14"/>
                        <Frame Padding="3" BackgroundColor="White" BorderColor="#797979" CornerRadius="8" HeightRequest="30">
                            <Entry 
                                BackgroundColor="transparent"
                                FontSize="12"
                                HeightRequest="55"
                                Placeholder="Nombre del cliente"
                                Text="{Binding ClientBookingOrder}"
                                TextColor="Black"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False" />
                        </Frame>
                        
                        <Label Text="Fecha despacho" FontSize="14" TextColor="#79280F"/>
                        <Frame Padding="3" BackgroundColor="White" BorderColor="#797979" CornerRadius="8" HeightRequest="30">
                        <DatePicker
                            Date="{Binding DateBookingOrder}"
                            TextColor="Black"
                            HeightRequest="55"
                            FontSize="12" />
                        </Frame>
                        <Label Text="Dirección" FontSize="14" TextColor="#79280F"/>
                        <Frame Padding="3" BackgroundColor="White" BorderColor="#797979" CornerRadius="8" HeightRequest="30">
                            <Entry
                                BackgroundColor="transparent"
                                FontSize="12"
                                HeightRequest="55"
                                Placeholder="Dirección de entrega"
                                Text="{Binding AddressBookingOrder}"
                                TextColor="Black"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False" />
                        </Frame>
                    <Label Text="Teléfono" FontSize="14" TextColor="#79280F"/>
                        <Frame Padding="3" BackgroundColor="White" BorderColor="#797979" CornerRadius="8" HeightRequest="30">
                            <Entry
                                BackgroundColor="transparent"
                                FontSize="12"
                                HeightRequest="55"
                                Placeholder="Número de teléfono"
                                Text="{Binding PhoneBookingOrder}"
                                TextColor="Black"
                                Keyboard="Telephone"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False" />
                        </Frame>
                        
                        <Label Text="Envío" FontSize="14" TextColor="#79280F" />
                        <StackLayout Orientation="Horizontal" Spacing="15">
                            <RadioButton
                                Content="No"
                                GroupName="BookingOrderShipment"
                                IsChecked="{Binding IsNoShipmentTask}"
                                FontSize="12"
                                TextColor="Black"
                                Value="no" />
                            <RadioButton
                                Content="Sí"
                                GroupName="BookingOrderShipment"
                                IsChecked="{Binding IsShipmentTask}"
                                FontSize="12"
                                TextColor="Black"
                                Value="si" />
                        </StackLayout>
                        
                        
                    </StackLayout>
                </Grid>

                <!-- Panel de búsqueda y selección de productos -->
                <StackLayout
                    Grid.Row="2"
                    Grid.Column="1"
                    Spacing="8">
                    
                    <!-- Búsqueda de productos -->
                    <Label Text="Buscar productos" FontSize="14" TextColor="#79280F"/>
                    <Frame Padding="8,3" BackgroundColor="LightGray" CornerRadius="15" HeightRequest="32">
                        <SearchBar
                            x:Name="SearchBarAddProductsBookingOrder"
                            BackgroundColor="LightGray"
                            CancelButtonColor="Black"
                            Focused="SearchBarProductBookingOrder_Focused"
                            FontSize="12"
                            HeightRequest="26"
                            HorizontalOptions="FillAndExpand"
                            Placeholder="Buscar producto"
                            TextChanged="OnProductsBookingORderTextChanged"
                            TextColor="Black"
                            Unfocused="SearchBarProductBookingOrder_Unfocused" />
                    </Frame>

                    <!-- Lista de productos disponibles -->
                    <Frame
                        x:Name="FrameListProductsBookingOrder"
                        CornerRadius="15"
                        HeightRequest="80"
                        IsVisible="{Binding IsVisibleListProductsBookingOrders}">
                        <Frame.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Offset="0.1" Color="#FFFFFF" />
                                <GradientStop Offset="1.0" Color="#FFF6ED" />
                            </LinearGradientBrush>
                        </Frame.Background>
                        <CollectionView
                            x:Name="ProductsBookingOrder"
                            HorizontalOptions="FillAndExpand"
                            ItemsSource="{Binding ProductsWithStock}"
                            SelectionChanged="CollectionProductsBookingOrder_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="2" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Product">
                                    <Grid
                                        ColumnDefinitions="0.8*,1.5*,0.7*"
                                        RowDefinitions="*"
                                        VerticalOptions="Start"
                                        Padding="3,1">
                                        <Label
                                            FontSize="9"
                                            Text="{Binding Id}"
                                            TextColor="#000000"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="9"
                                            Text="{Binding Description}"
                                            TextColor="#000000"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="9"
                                            Text="{Binding WoodState}"
                                            TextColor="#000000"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label
                                    FontSize="10"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="No se encontraron productos"
                                    TextColor="Black"
                                    VerticalOptions="CenterAndExpand" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Frame>
                    
                    <!-- Headers de productos seleccionados -->
                    <Grid Margin="0,8,0,3" ColumnDefinitions="0.8*,1.5*,0.8*,1*,0.3*">
                        <Label
                            FontSize="11"
                            Text="Código"
                            TextColor="#79280F"
                            FontAttributes="Bold" />
                        <Label
                            Grid.Column="1"
                            FontSize="11"
                            Text="Descripción"
                            TextColor="#79280F"
                            FontAttributes="Bold" />
                        <Label
                            Grid.Column="2"
                            FontSize="11"
                            Text="Estado"
                            TextColor="#79280F"
                            FontAttributes="Bold" />
                        <Label
                            Grid.Column="3"
                            FontSize="11"
                            Text="Cantidad"
                            TextColor="#79280F"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Grid.Column="4"
                            FontSize="11"
                            Text="Acción"
                            TextColor="#79280F"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />
                    </Grid>
                    
                    <!-- Lista de productos seleccionados -->
                    <Frame
                        Padding="3"
                        CornerRadius="8"
                        BackgroundColor="#FAFAFA"
                        BorderColor="#E0E0E0"
                        HeightRequest="180">
                        <CollectionView
                            ItemsSource="{Binding ProductsBookingOrder, Mode=TwoWay}"
                            SelectionMode="Single"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Default">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <StackLayout>
                                    <Label
                                        FontSize="12"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="No se han seleccionado productos"
                                        TextColor="#797979"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductStock">
                                    <Grid  
                                        ColumnDefinitions="0.8*,1.5*,0.8*,1*,0.3*"
                                        RowDefinitions="*"
                                        VerticalOptions="Start"
                                        Padding="2"
                                        BackgroundColor="White">
                                        <Label
                                            FontSize="10"
                                            Text="{Binding Product.Id}"
                                            TextColor="#000000"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="10"
                                            Text="{Binding Product.Description}"
                                            TextColor="#000000"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="10"
                                            Text="{Binding Product.WoodState}"
                                            TextColor="#000000"
                                            VerticalOptions="Center" />
                                        <Frame
                                            Grid.Column="3"
                                            Padding="1"
                                            BackgroundColor="White"
                                            BorderColor="#797979"
                                            CornerRadius="4"
                                            HeightRequest="22"
                                            HorizontalOptions="Center"
                                            WidthRequest="60">
                                            <Entry
                                                BackgroundColor="transparent"
                                                HeightRequest="40"
                                                FontSize="9"
                                                Keyboard="Numeric"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding QuantityBookingOrder, Mode=TwoWay}"
                                                TextColor="#000000"
                                                VerticalOptions="Center"
                                                IsSpellCheckEnabled="False"
                                                IsTextPredictionEnabled="False" />
                                        </Frame>
                                        <ImageButton
                                            Grid.Column="4"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=RemoveProductToAddedBookingOrderCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="16"
                                            Source="delete_item_icon.png"
                                            WidthRequest="16"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Frame>
                    <Label Text="Comentarios" FontSize="14" TextColor="#79280F"/>
                        <Frame Padding="3" BackgroundColor="White" BorderColor="#797979" CornerRadius="8" HeightRequest="50">
                            <Entry
                                BackgroundColor="transparent"
                                FontSize="12"
                                HeightRequest="65"
                                Placeholder="Comentarios adicionales"
                                Text="{Binding CommentsBookingOrder}"
                                TextColor="Black"
                                VerticalTextAlignment="Start"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False" />
                        </Frame>
                </StackLayout>

                <!-- Headers de productos seleccionados - Eliminar -->
                
                <!-- Lista de productos seleccionados - Eliminar -->

                <!-- Separador final y botones -->
                <BoxView
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,8"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Grid
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,15,0,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Center"
                    WidthRequest="400">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#D3AA84"
                        Clicked="CreateBookingOrder_Clicked"
                        FontSize="14"
                        HeightRequest="35"
                        Text="Crear"
                        TextColor="#000000" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding CancelCreateBookingOrderCommand}"
                        FontSize="14"
                        HeightRequest="35"
                        Text="Cancelar"
                        TextColor="#000000" />
                </Grid>

            </Grid>

            <!--  Historial de pedidos  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsVisibleListOrdersView}"
                RowDefinitions="auto,auto,auto,auto,*,auto"
                RowSpacing="8">

                <Label
                    Margin="0,0,0,0"
                    FontSize="24"
                    HorizontalOptions="Start"
                    Text="Historial de pedidos"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <Frame
                    Grid.Row="2"
                    Padding="0"
                    HeightRequest="35"
                    BackgroundColor="Transparent"
                    BorderColor="#797979">
                    <SearchBar
                        x:Name="SearchBarOrder"
                        BackgroundColor="Transparent"
                        CancelButtonColor="#79280F"
                        Placeholder="Buscar pedido por cliente, código o teléfono..."
                        HeightRequest="55"
                        FontSize="14"
                        VerticalOptions="Center"
                        TextChanged="OnSearchOrderTextChanged"
                        TextColor="Black" />
                </Frame>
                <Frame 
                   Grid.Row="3" 
                   Margin="20,20,20,10" 
                   Padding="15,10"
                   BackgroundColor="#F5F5F5"
                   BorderColor="#79280F"
                   CornerRadius="8">
                <Grid  ColumnDefinitions="0.15*,0.35*,0.25*,0.25*" ColumnSpacing="10">
                    <Label
                        FontSize="14"
                        Text="#Codigo"
                        FontAttributes="Bold"
                        TextColor="#79280F"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontSize="14"
                        Text="Cliente"
                        FontAttributes="Bold"
                        TextColor="#79280F"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        FontSize="14"
                        Text="Fecha"
                        FontAttributes="Bold"
                        TextColor="#79280F"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="3"
                        FontSize="14"
                        FontAttributes="Bold"
                        Text="Estado"
                        TextColor="#79280F"
                        VerticalOptions="Center" />

                </Grid>
              </Frame>
              <ScrollView
                    Grid.Row="4"
                    Margin="20,0,20,20"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                <CollectionView
                    x:Name="OrderItemsSearch"
                    Margin="0,0,0,20"
                    ItemsSource="{Binding BookingOrderItems}"
                    SelectionMode="Single"
                    VerticalOptions="Start"
                    BackgroundColor="White">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="2" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BookingOrder">
                            <Frame
                                    Padding="15,12"
                                    Margin="0,0,0,4"
                                    BackgroundColor="White"
                                    HeightRequest="45"
                                    BorderColor="#AD6B2A"
                                    CornerRadius="12">
                            <Grid
                                ColumnDefinitions="0.15*,0.35*,0.25*,0.15*,0.05*,0.05*"
                                        ColumnSpacing="2"
                                        VerticalOptions="Center">
                                <Label
                                    FontSize="14"
                                    Text="{Binding Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding Client}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="14"
                                    Text="{Binding OrderDate, StringFormat='{0:dd/MM/yyyy}'}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="14"
                                    Text="{Binding Status}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Button
                                    Grid.Column="4"
                                    BackgroundColor="Transparent"
                                    Clicked="VisivilityCancelOrderItem_Clicked"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    ImageSource="delete_item_icon.png"
                                    IsVisible="{Binding IsCancellable}" 
                                    HeightRequest="35"
                                    WidthRequest="35"
                                    Padding="0"/>
                                <Button
                                    Grid.Column="5"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Clicked="VisivilityOrderItem_Clicked"
                                    ImageSource="visibility.png"
                                    HeightRequest="35"
                                    WidthRequest="35"
                                    Padding="0" />

                            </Grid>
                        </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                            <StackLayout 
                                Spacing="20" 
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Padding="40">
                                <Image 
                                    Source="no_data_icon.png" 
                                    HeightRequest="80" 
                                    WidthRequest="80"
                                    HorizontalOptions="Center" />
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="No hay pedidos disponibles"
                                    TextColor="#797979"
                                    FontAttributes="Italic" />
                            </StackLayout>
                        </CollectionView.EmptyView>
                </CollectionView>
            </ScrollView>

                <BoxView
                    Grid.Row="6"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />
            </Grid>

            <!--  Ver pedido  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="-150"
                IsVisible="{Binding IsVisibleOrderView}"
                RowDefinitions="auto,auto,auto,auto,*,auto,auto"
                RowSpacing="6"
                VerticalOptions="FillAndExpand">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Pedido"
                    TextColor="#79280F"
                    VerticalOptions="Center" />
                <BoxView
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

<Frame Grid.Row="2" BorderColor="#79280F" Grid.ColumnSpan="2" 
                        Margin="35,0,50,20">
                        
                        <Grid
                        
                        ColumnDefinitions="auto,auto"
                        RowDefinitions="auto,auto,auto,auto,auto,auto">

                        <StackLayout
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <Label Text="Client" Margin="0,40,10,0" TextColor="#79280F" VerticalOptions="Center" FontSize="18"/>
                            <Label
                                    WidthRequest="400"
                                    FontSize="18"
                                    Margin="0,40,10,0"
                                    HorizontalOptions="FillAndExpand"
                                    Text="{Binding SelectedBookingOrder.Client}"
                                    TextColor="Black"
                                    VerticalOptions="FillAndExpand" />
                            
                            <Label Text="Telefono" FontSize="18" Margin="30,40,10,0" VerticalOptions="Center" TextColor="#79280F"/>
                            <Label
                                    FontSize="18"
                                    Margin="0,40,10,0"
                                    HorizontalOptions="FillAndExpand"
                                    Text="{Binding SelectedBookingOrder.Phone}"
                                    TextColor="Black"
                                    VerticalOptions="FillAndExpand" />
                            
                        </StackLayout>
                        <StackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <Label VerticalOptions="Center" Text="Fecha" FontSize="18" Margin="0,0,10,0" TextColor="#79280F" />
                            <Label
                                Text="{Binding SelectedBookingOrder.OrderDate}"
                                TextColor="Black"
                                FontSize="18"
                                VerticalOptions="Center"
                                WidthRequest="200" />
                            <Label  Text="Envio" VerticalOptions="Center" FontSize="18" Margin="0,25,10,30" TextColor="#79280F" />
                            <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                                <Label FontSize="18" Text="{Binding SelectedBookingOrder.Shipment, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Sí|No'}" />
                            </StackLayout>
                        </StackLayout>
                        <HorizontalStackLayout Grid.Row="2"  Margin="0,10,0,10">
                        <Label VerticalOptions="Center" Text="Direccion" FontSize="18"  TextColor="#79280F" Margin="0,0,30,0" />
                            <Label
                                WidthRequest="500"
                                FontSize="18"
                                HorizontalOptions="FillAndExpand"
                                Text="{Binding SelectedBookingOrder.Address}"
                                TextColor="Black"
                                VerticalOptions="FillAndExpand" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="3"  Margin="0,10,0,60">
                        <Label VerticalOptions="Center"  Text="Comentarios" FontSize="18"  TextColor="#79280F"/>
                            <Label
                                FontSize="18"
                                Margin="30,0,0,0"
                                HorizontalOptions="FillAndExpand"
                                Text="{Binding SelectedBookingOrder.Comments}"
                                TextColor="Black"
                                VerticalOptions="FillAndExpand" />
                        </HorizontalStackLayout>
                       
                    </Grid>

                        </Frame>
                    
                    <Grid  Grid.Row="3"
                    Grid.ColumnSpan="2" Margin="35,0,0,30" ColumnDefinitions=".1*,.1*,.22*">
                            <Label
                                FontSize="18"
                                Text="Codigo"
                                TextColor="#79280F" />
                            <Label
                                Grid.Column="1"
                                FontSize="18"
                                Text="Descripcion"
                                TextColor="#79280F" />
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Text="Cantidad"
                                TextColor="#79280F" />
                        </Grid>
                <CollectionView
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="35,0,50,0"
                    ItemsSource="{Binding OrderItems, Mode=TwoWay}"
                    SelectionMode="None"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <StackLayout>
                            <Label
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="No se han cargado productos"
                                TextColor="#797979"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Grid
                                ColumnDefinitions=".1*,.1*,.2*"
                                RowDefinitions="*"
                                RowSpacing="10"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding ProductName}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="18"
                                    Text="{Binding Quantity}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <BoxView
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding ChangeViewCommand}"
                        CommandParameter="ListOrders"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Volver"
                        TextColor="#000000"
                        WidthRequest="260" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#D3AA84"
                        Command="{Binding GeneratePdfCommand}"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Exportar"
                        TextColor="Black"
                        WidthRequest="260" />
                </HorizontalStackLayout>

            </Grid>

            <!--  Reservas  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="*"
                IsVisible="{Binding IsVisibleListBookingsView}"
                RowDefinitions="auto,auto,auto,auto,*,auto"
                RowSpacing="8">

                <Label
                    Margin="0,0,0,0"
                    FontSize="24"
                    HorizontalOptions="Start"
                    Text="Reservas"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <!-- Barra de búsqueda optimizada -->
                <Frame
                    Grid.Row="2"
                    Padding="0"
                    HeightRequest="35"
                    BackgroundColor="Transparent"
                    BorderColor="#797979">
                    <SearchBar
                        x:Name="SearchBarBooking"
                        BackgroundColor="Transparent"
                        CancelButtonColor="#79280F"
                        Placeholder="Buscar reservas por cliente, código o teléfono..."
                        PlaceholderColor="#999999"
                        TextChanged="OnSearchBookingTextChanged"
                        TextColor="#333333"
                        FontSize="14"
                        VerticalOptions="Center" />
                </Frame>

               <!-- Encabezados de la lista -->
               <Frame 
                   Grid.Row="3" 
                   Margin="20,20,20,10" 
                   Padding="15,10"
                   BackgroundColor="#F5F5F5"
                   BorderColor="#79280F"
                   CornerRadius="8">
                   <Grid ColumnDefinitions="0.15*,0.35*,0.25*,0.25*" ColumnSpacing="10">
                       <Label
                           FontSize="14"
                           FontAttributes="Bold"
                           Text="#Código"
                           TextColor="#79280F"
                           VerticalOptions="Center" />
                       <Label
                           Grid.Column="1"
                           FontSize="14"
                           FontAttributes="Bold"
                           Text="Cliente"
                           TextColor="#79280F"
                           VerticalOptions="Center" />
                       <Label
                           Grid.Column="2"
                           FontSize="14"
                           FontAttributes="Bold"
                           Text="Fecha"
                           TextColor="#79280F"
                           VerticalOptions="Center" />
                       <Label
                           Grid.Column="3"
                           FontSize="14"
                           FontAttributes="Bold"
                           Text="Teléfono"
                           TextColor="#79280F"
                           VerticalOptions="Center" />
                   </Grid>
               </Frame>

                <!-- Lista de reservas optimizada para tablet/desktop -->
                <ScrollView
                    Grid.Row="4"
                    Margin="20,0,20,20"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView
                        x:Name="BookingItemsSearch"
                        ItemsSource="{Binding BookingOrderItems}"
                        SelectionMode="Single"
                        VerticalOptions="Start"
                        BackgroundColor="White">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BookingOrder">
                                <Frame
                                    Padding="15,12"
                                    Margin="0,0,0,4"
                                    BackgroundColor="White"
                                    HeightRequest="45"
                                    BorderColor="#AD6B2A"
                                    CornerRadius="12">
                                    <Grid
                                        ColumnDefinitions="0.15*,0.35*,0.25*,0.15*,0.05*,0.05*"
                                        ColumnSpacing="2"
                                        VerticalOptions="Center">
                                        <Label
                                            FontSize="14"
                                            Text="{Binding Id}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Grid.Column="1"
                                            FontSize="14"
                                            Text="{Binding Client}"
                                            TextColor="#333333"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="14"
                                            Text="{Binding OrderDate, StringFormat='{0:dd/MM/yyyy}'}"
                                            TextColor="#666666"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="3"
                                            FontSize="14"
                                            Text="{Binding Phone}"
                                            TextColor="#666666"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation" />

                                        <Button
                                            Grid.Column="4"
                                            BackgroundColor="Transparent"
                                            Clicked="VisivilityCancelBookingItem_Clicked"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            ImageSource="delete_item_icon.png"
                                            HeightRequest="35"
                                            WidthRequest="35"
                                            Padding="0" />

                                        <Button
                                            Grid.Column="5"
                                            BackgroundColor="Transparent"
                                            Clicked="VisivilityBookingItem_Clicked"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            ImageSource="visibility.png"
                                            HeightRequest="35"
                                            WidthRequest="35"
                                            Padding="0" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <StackLayout 
                                Spacing="20" 
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Padding="40">
                                <Image 
                                    Source="no_data_icon.png" 
                                    HeightRequest="80" 
                                    WidthRequest="80"
                                    HorizontalOptions="Center" />
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="No hay reservas disponibles"
                                    TextColor="#797979"
                                    FontAttributes="Italic" />
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </ScrollView>


                <BoxView
                    Grid.Row="6"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />
            </Grid>

            <!--  Ver Reserva  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="White"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="-150"
                IsVisible="{Binding IsVisibleBookingView}"
                RowDefinitions="auto,auto,auto,auto,*,auto,auto"
                RowSpacing="6"
                VerticalOptions="FillAndExpand">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Reserva"
                    TextColor="#79280F"
                    VerticalOptions="Center" />
                <BoxView
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />
<Frame Grid.Row="2" BorderColor="#79280F" Grid.ColumnSpan="2" 
                        Margin="35,0,50,20">
                <Grid
                    Margin="30,0,0,0"
                    ColumnDefinitions="auto,auto"
                    RowDefinitions="auto,auto,auto,auto,auto">

                    <StackLayout
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal">
                        <Label  Text="Client" Margin="0,40,10,0" TextColor="#79280F" VerticalOptions="Center" FontSize="18" />
                        
                            <Label
                                WidthRequest="400"
                                FontSize="18"
                                Margin="0,40,10,0"
                                HorizontalOptions="FillAndExpand"
                                Text="{Binding SelectedBookingOrder.Client}"
                                TextColor="Black"
                                VerticalOptions="FillAndExpand" />
                        
                        <Label  Text="Telefono" FontSize="18" Margin="30,40,10,0" VerticalOptions="Center" TextColor="#79280F"/>
                        
                             <Label
                                    FontSize="18"
                                    Margin="0,40,10,0"
                                    HorizontalOptions="FillAndExpand"
                                    Text="{Binding SelectedBookingOrder.Phone}"
                                    TextColor="Black"
                                    VerticalOptions="FillAndExpand" />
                        
                    </StackLayout>
                    <StackLayout
                        Grid.Row="1"
                        Margin="0,20,0,10"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal">
                        <Label VerticalOptions="Center" Text="Fecha" FontSize="18" Margin="0,0,10,0" TextColor="#79280F"/>
                        <Label
                            Text="{Binding SelectedBookingOrder.OrderDate}"
                            TextColor="Black"
                            FontSize="18"
                            WidthRequest="200" />
                        <Label TextColor="#79280F" FontSize="18" Text="Envio" Margin="0,0,10,0"/>
                        <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                            <Label FontSize="18" Text="{Binding SelectedBookingOrder.Shipment, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Sí|No'}" />
                        </StackLayout>
                    </StackLayout>
                    <HorizontalStackLayout Grid.Row="2"  Margin="0,10,0,10">
                    <Label  VerticalOptions="Center" Text="Direccion" FontSize="18"  TextColor="#79280F" Margin="0,0,20,0" />
                    
                        <Label
                            FontSize="18"
                            HorizontalOptions="FillAndExpand"
                            Text="{Binding SelectedBookingOrder.Address}"
                            TextColor="Black"
                            VerticalOptions="FillAndExpand" />
                    
                    </HorizontalStackLayout>
                     <HorizontalStackLayout Grid.Row="3"  Margin="0,10,0,60">
                    <Label  VerticalOptions="Center"  Margin="0,0,20,0" Text="Comentarios" FontSize="18"  TextColor="#79280F"/>
                    
                        <Label
                            FontSize="18"
                            HorizontalOptions="FillAndExpand"
                            Text="{Binding SelectedBookingOrder.Comments}"
                            TextColor="Black"
                            VerticalOptions="FillAndExpand" />
                 
 </HorizontalStackLayout>
                </Grid>
</Frame>
 <Grid  Grid.Row="3"
                    Grid.ColumnSpan="2" Margin="45,0,0,30" ColumnDefinitions=".1*,.1*,.22*">
                            <Label
                                FontSize="18"
                                Text="Codigo"
                                TextColor="#79280F" />
                            <Label
                                Grid.Column="1"
                                FontSize="18"
                                Text="Descripcion"
                                TextColor="#79280F" />
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Text="Cantidad"
                                TextColor="#79280F" />
                        </Grid>
                <CollectionView
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="45,0,30,0"
                    ItemsSource="{Binding BookingItems, Mode=TwoWay}"
                    SelectionMode="None"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <StackLayout>
                            <Label
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="No se han cargado productos"
                                TextColor="#797979"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Booking">
                            <Grid
                                ColumnDefinitions=".1*,.1*,.2*"
                                RowDefinitions="*"
                                RowSpacing="10"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Id}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding ProductName}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="18"
                                    Text="{Binding Quantity}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <BoxView
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,10"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
                        Command="{Binding ChangeViewCommand}"
                        CommandParameter="ListBooking"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Volver"
                        TextColor="#000000"
                        WidthRequest="260" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#D3AA84"
                        Clicked="VisivilityConfirmBookingItem_Clicked"
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Text="Confirmar reserva"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>

            </Grid>

            <!--  Historial  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="#FFF6ED"
                IsVisible="{Binding IsHistoryView}"
                RowDefinitions="auto,auto,auto,auto,*,auto,auto"
                RowSpacing="5">
                <Label
                    Margin="0,0,0,10"
                    FontSize="26"
                    HorizontalOptions="Start"
                    Text="Movimientos"
                    TextColor="#79280F"
                    VerticalOptions="Center" />

                <BoxView
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />
                <Grid
                    Grid.Row="2"
                    Margin="30,0,0,40"
                    ColumnDefinitions="auto,*,auto"
                    ColumnSpacing="60"
                    RowDefinitions="auto,30,30,30">
                    <Frame
                        Grid.RowSpan="4"
                        Grid.ColumnSpan="3"
                        Margin="-10,-10,40,-10"
                        BackgroundColor="Transparent"
                        BorderColor="#79280F"
                        HorizontalOptions="FillAndExpand" />

                    <Label
                        Margin="0,0,0,10"
                        FontSize="30"
                        Text="Filtros"
                        TextColor="#79280F"
                        VerticalTextAlignment="Center" />

                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="40,0,0,6"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalOptions="End">
                        <Label
                            FontSize="16"
                            Text="Tipo de movimiento:"
                            TextColor="Black"
                            VerticalOptions="Center" />
                        <Picker
                            ItemsSource="{Binding MovementTypes}"
                            SelectedItem="{Binding SelectedFilterMovementType, Mode=TwoWay}"
                            TextColor="black"
                            WidthRequest="200" />
                    </StackLayout>

                    <StackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="40,0,0,6"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            FontSize="16"
                            Text="Producto:"
                            TextColor="Black"
                            VerticalOptions="Center" />
                        <Picker
                            ItemsSource="{Binding ProductsMovementsFilter}"
                            SelectedItem="{Binding SelectedFilterMovementProduct, Mode=TwoWay}"
                            TextColor="Black"
                            WidthRequest="300" />
                    </StackLayout>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="40,3,0,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Label
                            FontSize="16"
                            Text="Fecha del movimiento:"
                            TextColor="Black" />
                        <DatePicker
                            Date="{Binding SelectedFilterMovementDate}"
                            TextColor="Black"
                            WidthRequest="200" />
                    </StackLayout>

                    <StackLayout
                        Grid.RowSpan="4"
                        Grid.Column="2"
                        Margin="0,0,60,0"
                        Spacing="10"
                        VerticalOptions="CenterAndExpand">
                        <Button
                            BackgroundColor="#FFF6ED"
                            BorderColor="#79280F"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=ApplyFiltersMovementsCommand}"
                            FontSize="15"
                            HeightRequest="45"
                            Text="Aplicar filtros"
                            TextColor="#79280F"
                            WidthRequest="140" />
                        <Button
                            BackgroundColor="#FFF6ED"
                            BorderColor="#79280F"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=ClearFiltersMovementsCommand}"
                            FontSize="15"
                            HeightRequest="45"
                            Text="Limpiar filtros"
                            TextColor="#79280F"
                            WidthRequest="140" />
                    </StackLayout>

                </Grid>

                <Grid
                    Grid.Row="3"
                    Margin="30,0,0,0"
                    ColumnDefinitions="25*,25*,25*,25*">
                    <Label
                        FontSize="18"
                        Text="Fecha"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="1"
                        FontSize="18"
                        Text="Producto"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="2"
                        FontSize="18"
                        Text="Tipo de movimiento"
                        TextColor="#79280F" />
                    <Label
                        Grid.Column="3"
                        FontSize="18"
                        Text="Cantidad"
                        TextColor="#79280F" />
                </Grid>

                <CollectionView
                    x:Name="MovementsSearch"
                    Grid.Row="4"
                    Margin="30,20,0,0"
                    ItemsSource="{Binding MovementsFilter, Mode=TwoWay}"
                    SelectionMode="None"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Movement">
                            <Grid
                                ColumnDefinitions="25*,25*,25*,25*"
                                RowDefinitions="*"
                                VerticalOptions="Start">
                                <Label
                                    FontSize="18"
                                    Text="{Binding Date}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="18"
                                    Text="{Binding ProductName}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="{Binding MovementType}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="3"
                                    FontSize="18"
                                    Text="{Binding Quantity}"
                                    TextColor="#000000"
                                    VerticalOptions="Start" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <BoxView
                    Grid.Row="5"
                    Margin="0,0,0,40"
                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="EndAndExpand"
                    Color="#79280F" />


            </Grid>

            <!--  Configurations  -->
            <Grid
                Grid.RowSpan="3"
                Grid.ColumnSpan="5"
                Padding="0"
                BackgroundColor="#FFF6ED"
                IsVisible="{Binding IsConfigurationView}">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <StackLayout.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Offset="0.1" Color="#AD6B2A" />
                            <GradientStop Offset="1.0" Color="#D3AA84" />
                        </LinearGradientBrush>
                    </StackLayout.Background>

                    <StackLayout
                        Margin="0,0,0,0"
                        >
                        <ActivityIndicator
                            HeightRequest="28"
                            Color="#4A744C"
                            IsRunning="True"
                            IsVisible="{Binding IsBusy}"
                            WidthRequest="28" />
                    </StackLayout>

                    <Image
                        Margin="20,20,0,0"
                        HeightRequest="100"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Source="rincon_white.png"
                        WidthRequest="200" />
                    
                    <Grid
                        ColumnDefinitions="*,1.5*,*"
                        IsVisible="{Binding ConfirmUserChanges, Converter={StaticResource InvertedBoolConverter}}"
                        RowDefinitions="auto,auto,auto"
                        VerticalOptions="FillAndExpand"
                        Margin="0,20,0,0">
                        <Frame
                            Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="#D3AA84"
                            CornerRadius="15"
                            Padding="20">
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Spacing="12">
                                <Label
                                    Margin="0,10,0,15"
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    Text="Configuración"
                                    TextColor="Black"
                                    HorizontalOptions="Center" />
                                
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="15"
                                    HorizontalOptions="FillAndExpand"
                                    RowDefinitions="auto,auto,auto,auto,auto,auto,auto"
                                    RowSpacing="8"
                                    VerticalOptions="FillAndExpand">
                                    
                                    <!-- Nombre -->
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="Nombre"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="FillAndExpand">
                                        <Entry
                                            BackgroundColor="transparent"
                                            FontSize="12"
                                            HeightRequest="55"
                                            MaxLength="25"
                                            Placeholder="Nombre"
                                            PlaceholderColor="#848484"
                                            Text="{Binding NameConfigurations}"
                                            TextColor="Black"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                    
                                    <!-- Contraseña -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="Contraseña"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="FillAndExpand">
                                        <Entry
                                            BackgroundColor="transparent"
                                            FontSize="12"
                                            HeightRequest="55"
                                            MaxLength="25"
                                            Placeholder="Contraseña"
                                            PlaceholderColor="#848484"
                                            Text="{Binding PasswordConfigurations}"
                                            TextColor="Black"
                                            IsPassword="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>
                                    
                                    <!-- Repetir contraseña -->
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="Repetir contraseña"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <Frame
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Padding="3"
                                        BackgroundColor="White"
                                        CornerRadius="12"
                                        HeightRequest="35"
                                        HorizontalOptions="FillAndExpand">
                                        <Entry
                                            BackgroundColor="transparent"
                                            FontSize="12"
                                            HeightRequest="55"
                                            MaxLength="25"
                                            Placeholder="Repetir contraseña"
                                            PlaceholderColor="#848484"
                                            Text="{Binding RepeatPasswordConfigrations}"
                                            TextColor="Black"
                                            IsPassword="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False" />
                                    </Frame>

                                    <!-- Pregunta de seguridad -->
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="Pregunta de seguridad"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                    <StackLayout
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand">
                                        <Frame
                                            Padding="8,3"
                                            BackgroundColor="White"
                                            CornerRadius="12"
                                            HeightRequest="32">
                                            <Label
                                                FontSize="12"
                                                Text="{Binding SelectedQuestionConfigurations, Mode=TwoWay}"
                                                TextColor="Black"
                                                VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SelectQuestionCommand}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Frame>
                                        <Frame
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            CornerRadius="15"
                                            HeightRequest="120"
                                            IsVisible="{Binding IsVisibleListQuestions}">
                                            <Frame
                                                x:Name="FrameListQuestions"
                                                CornerRadius="15"
                                                HeightRequest="120"
                                                IsVisible="{Binding IsVisibleListQuestions}"
                                                VerticalOptions="Start">
                                                <Frame.Background>
                                                    <LinearGradientBrush EndPoint="0,1">
                                                        <GradientStop Offset="0.1" Color="#FFFFFF" />
                                                        <GradientStop Offset="1.0" Color="#FFF6ED" />
                                                    </LinearGradientBrush>
                                                </Frame.Background>
                                                <CollectionView
                                                    x:Name="Questions"
                                                    Margin="0,5,0,5"
                                                    HeightRequest="110"
                                                    HorizontalOptions="Start"
                                                    ItemsSource="{Binding Questions}"
                                                    SelectionChanged="Questions_SelectionChanged"
                                                    SelectionMode="Single"
                                                    VerticalOptions="Start">
                                                    <CollectionView.ItemsLayout>
                                                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="6" />
                                                    </CollectionView.ItemsLayout>
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Label
                                                                FontSize="12"
                                                                Text="{Binding .}"
