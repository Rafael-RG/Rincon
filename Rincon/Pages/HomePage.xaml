                    HeightRequest="2"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    Color="#79280F" />

                <HorizontalStackLayout
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,20,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="Start">
                    <Button
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="20,0,20,0"
                        BackgroundColor="#FFF6ED"
