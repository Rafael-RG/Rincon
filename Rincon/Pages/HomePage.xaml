                        HorizontalOptions="Center"
                        Text="Confirmar reserva"
                        TextColor="#000000"
                        WidthRequest="260" />
                </HorizontalStackLayout>

            </Grid>

            <!--  Historial  -->
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="20"
                BackgroundColor="#FFF6ED"
