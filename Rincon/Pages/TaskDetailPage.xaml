<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Rincon.Pages.TaskDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:OperatorsViewModel"
    xmlns:local="clr-namespace:Rincon.Converters"
    BackgroundColor="#80000000">

    <ContentView.Resources>
        <ResourceDictionary>
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid>
        <Frame Margin="120,80,120,80" 
               Padding="30" 
               BackgroundColor="White" 
               BorderColor="#79280F"
               CornerRadius="12" 
               HasShadow="True" 
               VerticalOptions="Fill" 
               HorizontalOptions="Fill">
            <Grid RowDefinitions="auto,auto,*,auto,auto" RowSpacing="20">
                <!-- Header con título e ID -->
                <Grid Grid.Row="0" ColumnDefinitions="*,auto" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="📋 Detalle de Tarea" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#79280F" 
                           VerticalOptions="Center" />
                    <Frame Grid.Column="1"
                           BackgroundColor="#79280F"
                           CornerRadius="8"
                           Padding="10,6"
                           HasShadow="False">
                        <Label Text="{Binding SelectedTask.Id, StringFormat='#{0:D5}'}" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="White" 
                               VerticalOptions="Center" />
                    </Frame>
                </Grid>
                
                <!-- Separador -->
                <BoxView Grid.Row="1" 
                         HeightRequest="2" 
                         Color="#79280F" 
                         HorizontalOptions="Fill" />
                
                <!-- Información de la tarea -->
                <ScrollView Grid.Row="2" VerticalOptions="Fill">
                    <Grid RowDefinitions="auto,auto,auto,auto,auto" 
                          RowSpacing="18" 
                          ColumnDefinitions="auto,*" 
                          ColumnSpacing="20">
                        
                        <!-- Material -->
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="Material:" 
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#79280F" 
                               VerticalOptions="Center" />
                        <Frame Grid.Row="0" Grid.Column="1"
                               BackgroundColor="#F8F8F8"
                               BorderColor="#E0E0E0"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="3">
                                <Label FontSize="13" FontAttributes="Bold" Text="{Binding SelectedTask.ProductSourceId}" TextColor="#79280F" />
                                <Label FontSize="15" Text="{Binding SelectedTask.ProductSourceDetail.Description}" TextColor="#333333" LineBreakMode="WordWrap" />
                                <StackLayout Orientation="Horizontal" Spacing="6">
                                    <Label FontSize="12" Text="{Binding SelectedTask.ProductSourceDetail.ProductType}" TextColor="#555555" />
                                    <Label FontSize="12" FontAttributes="Bold" Text="{Binding SelectedTask.ProductSourceDetail.MachimbreDeckLabel}" TextColor="#79280F" />
                                    <Label FontSize="12" Text="{Binding SelectedTask.ProductSourceDetail.MachimbreDeckSubLabel}" TextColor="#79280F" />
                                    <Label FontSize="12" Text="{Binding SelectedTask.ProductSourceDetail.WoodState}" TextColor="#666666" />
                                </StackLayout>
                            </VerticalStackLayout>
                        </Frame>
                        
                        <!-- Producir -->
                        <Label Grid.Row="1" Grid.Column="0" 
                               Text="Producir:" 
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#79280F" 
                               VerticalOptions="Center" />
                        <Frame Grid.Row="1" Grid.Column="1"
                               BackgroundColor="#F8F8F8"
                               BorderColor="#E0E0E0"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="3">
                                <Label FontSize="13" FontAttributes="Bold" Text="{Binding SelectedTask.ProductDestinationId}" TextColor="#79280F" />
                                <Label FontSize="15" Text="{Binding SelectedTask.ProductDestinationDetail.Description}" TextColor="#333333" LineBreakMode="WordWrap" />
                                <StackLayout Orientation="Horizontal" Spacing="6">
                                    <Label FontSize="12" Text="{Binding SelectedTask.ProductDestinationDetail.ProductType}" TextColor="#555555" />
                                    <Label FontSize="12" FontAttributes="Bold" Text="{Binding SelectedTask.ProductDestinationDetail.MachimbreDeckLabel}" TextColor="#79280F" />
                                    <Label FontSize="12" Text="{Binding SelectedTask.ProductDestinationDetail.MachimbreDeckSubLabel}" TextColor="#79280F" />
                                    <Label FontSize="12" Text="{Binding SelectedTask.ProductDestinationDetail.WoodState}" TextColor="#666666" />
                                </StackLayout>
                            </VerticalStackLayout>
                        </Frame>
                        
                        <!-- Cantidad -->
                        <Label Grid.Row="2" Grid.Column="0" 
                               Text="Cantidad:" 
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#79280F" 
                               VerticalOptions="Center" />
                        <Frame Grid.Row="2" Grid.Column="1"
                               BackgroundColor="#F8F8F8"
                               BorderColor="#E0E0E0"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False">
                            <Label Text="{Binding SelectedTask.Quantity, StringFormat='{0} unidades'}" 
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#4A744C" />
                        </Frame>
                        
                        <!-- Prioridad -->
                        <Label Grid.Row="3" Grid.Column="0" 
                               Text="Prioridad:" 
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#79280F" 
                               VerticalOptions="Center" />
                        <Frame Grid.Row="3" Grid.Column="1"
                               BackgroundColor="#F8F8F8"
                               BorderColor="#E0E0E0"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False">
                            <StackLayout>
                                <Label IsVisible="{Binding SelectedTask.Priority}" 
                                       Text="Alta prioridad" 
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#FF5722" />
                                <Label IsVisible="{Binding SelectedTask.Priority, Converter={StaticResource InvertedBoolConverter}}" 
                                       Text="Prioridad normal" 
                                       FontSize="15"
                                       TextColor="#666666" />
                            </StackLayout>
                        </Frame>
                        
                        <!-- Descripción -->
                        <Label Grid.Row="4" Grid.Column="0" 
                               Text="Descripción:" 
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#79280F" 
                               VerticalOptions="Start" />
                        <Frame Grid.Row="4" Grid.Column="1"
                               BackgroundColor="#F8F8F8"
                               BorderColor="#E0E0E0"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False"
                               MinimumHeightRequest="60">
                            <Label Text="{Binding SelectedTask.Description}" 
                                   FontSize="15"
                                   TextColor="#333333"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Start" />
                        </Frame>
                    </Grid>
                </ScrollView>
                
                <!-- Separador inferior -->
                <BoxView Grid.Row="3" 
                         HeightRequest="2" 
                         Color="#79280F" 
                         HorizontalOptions="Fill" />
                
                <!-- Botones de acción -->
                <Grid Grid.Row="4" 
                      ColumnDefinitions="auto,*" 
                      ColumnSpacing="20" 
                      HorizontalOptions="Fill">
                    <Frame Grid.Column="0"
                           Padding="10"
                           BackgroundColor="#F8F9FA"
                           BorderColor="#79280F"
                           CornerRadius="25"
                           HasShadow="False">
                        <ImageButton Source="back_brown.png" 
                                     BackgroundColor="Transparent"
                                     WidthRequest="32"
                                     HeightRequest="32"
                                     Command="{Binding ClosePopupCommand}" />
                    </Frame>
                    <Button Grid.Column="1"
                            Text="Asignarme esta tarea" 
                            BackgroundColor="#4A744C" 
                            TextColor="White" 
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="8" 
                            HeightRequest="55"
                            HorizontalOptions="Fill"
                            Command="{Binding ShowAssignOperatorPopupCommand}" />
                </Grid>
            </Grid>
        </Frame>
    </Grid>
</ContentView>
