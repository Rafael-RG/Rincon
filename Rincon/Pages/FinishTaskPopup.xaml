<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Rincon.Pages.FinishTaskPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:OperatorsViewModel"
    xmlns:local="clr-namespace:Rincon.Converters"
    BackgroundColor="#80000000">

    <ContentView.Resources>
        <ResourceDictionary>
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid>
        <Frame Margin="100,60,100,60" 
               Padding="30" 
               BackgroundColor="White" 
               BorderColor="#4A744C"
               CornerRadius="12" 
               HasShadow="True" 
               VerticalOptions="Fill" 
               HorizontalOptions="Fill">
            <Grid RowDefinitions="auto,auto,*,auto,auto" RowSpacing="25">
                <!-- Header con título e ID -->
                <Grid Grid.Row="0" ColumnDefinitions="*,auto" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="Finalizar Tarea" 
                           FontSize="26" 
                           FontAttributes="Bold" 
                           TextColor="#4A744C" 
                           VerticalOptions="Center" />
                    <Frame Grid.Column="1"
                           BackgroundColor="#4A744C"
                           CornerRadius="8"
                           Padding="12,8"
                           HasShadow="False">
                        <Label Text="{Binding SelectedTask.Id, StringFormat='#{0:D5}'}" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="White" 
                               VerticalOptions="Center" />
                    </Frame>
                </Grid>
                
                <!-- Separador -->
                <BoxView Grid.Row="1" 
                         HeightRequest="2" 
                         Color="#4A744C" 
                         HorizontalOptions="Fill" />
                
                <!-- Contenido principal -->
                <ScrollView Grid.Row="2" VerticalOptions="Fill">
                    <Grid ColumnDefinitions="1.2*,*" ColumnSpacing="30" RowSpacing="25">
                        <!-- Información de la tarea -->
                        <StackLayout Grid.Column="0" Spacing="20">
                            <Label Text="Información de la Tarea" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="#4A744C" />
                            
                            <Grid RowDefinitions="auto,auto,auto,auto,auto,auto" 
                                  RowSpacing="15" 
                                  ColumnDefinitions="auto,*" 
                                  ColumnSpacing="15">
                                
                                <!-- Material -->
                                <Label Grid.Row="0" Grid.Column="0" 
                                       Text="Material:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#4A744C" 
                                       VerticalOptions="Center" />
                                <Frame Grid.Row="0" Grid.Column="1"
                                       BackgroundColor="#F0F8FF"
                                       BorderColor="#E0E0E0"
                                       CornerRadius="6"
                                       Padding="10"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="3">
                                        <Label FontSize="12" FontAttributes="Bold" Text="{Binding SelectedTask.ProductSourceId}" TextColor="#4A744C" />
                                        <Label FontSize="14" Text="{Binding SelectedTask.ProductSourceDetail.Description}" TextColor="#333333" LineBreakMode="WordWrap" />
                                        <StackLayout Orientation="Horizontal" Spacing="6">
                                            <Label FontSize="11" Text="{Binding SelectedTask.ProductSourceDetail.ProductType}" TextColor="#555555" />
                                            <Label FontSize="11" FontAttributes="Bold" Text="{Binding SelectedTask.ProductSourceDetail.MachimbreDeckLabel}" TextColor="#4A744C" />
                                            <Label FontSize="11" Text="{Binding SelectedTask.ProductSourceDetail.MachimbreDeckSubLabel}" TextColor="#4A744C" />
                                            <Label FontSize="11" Text="{Binding SelectedTask.ProductSourceDetail.WoodState}" TextColor="#666666" />
                                        </StackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                                
                                <!-- Producir -->
                                <Label Grid.Row="1" Grid.Column="0" 
                                       Text="Producir:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#4A744C" 
                                       VerticalOptions="Center" />
                                <Frame Grid.Row="1" Grid.Column="1"
                                       BackgroundColor="#F0F8FF"
                                       BorderColor="#E0E0E0"
                                       CornerRadius="6"
                                       Padding="10"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="3">
                                        <Label FontSize="12" FontAttributes="Bold" Text="{Binding SelectedTask.ProductDestinationId}" TextColor="#4A744C" />
                                        <Label FontSize="14" Text="{Binding SelectedTask.ProductDestinationDetail.Description}" TextColor="#333333" LineBreakMode="WordWrap" />
                                        <StackLayout Orientation="Horizontal" Spacing="6">
                                            <Label FontSize="11" Text="{Binding SelectedTask.ProductDestinationDetail.ProductType}" TextColor="#555555" />
                                            <Label FontSize="11" FontAttributes="Bold" Text="{Binding SelectedTask.ProductDestinationDetail.MachimbreDeckLabel}" TextColor="#4A744C" />
                                            <Label FontSize="11" Text="{Binding SelectedTask.ProductDestinationDetail.MachimbreDeckSubLabel}" TextColor="#4A744C" />
                                            <Label FontSize="11" Text="{Binding SelectedTask.ProductDestinationDetail.WoodState}" TextColor="#666666" />
                                        </StackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                                
                                <!-- Cantidad -->
                                <Label Grid.Row="2" Grid.Column="0" 
                                       Text="Cantidad:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#4A744C" 
                                       VerticalOptions="Center" />
                                <Frame Grid.Row="2" Grid.Column="1"
                                       BackgroundColor="#F0F8FF"
                                       BorderColor="#E0E0E0"
                                       CornerRadius="6"
                                       Padding="10"
                                       HasShadow="False">
                                    <Label Text="{Binding SelectedTask.Quantity, StringFormat='{0} unidades'}" 
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#4A744C" />
                                </Frame>
                                
                                <!-- Prioridad -->
                                <Label Grid.Row="3" Grid.Column="0" 
                                       Text="Prioridad:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#4A744C" 
                                       VerticalOptions="Center" />
                                <Frame Grid.Row="3" Grid.Column="1"
                                       BackgroundColor="#F0F8FF"
                                       BorderColor="#E0E0E0"
                                       CornerRadius="6"
                                       Padding="10"
                                       HasShadow="False">
                                    <StackLayout>
                                        <Label IsVisible="{Binding SelectedTask.Priority}" 
                                               Text="Alta prioridad" 
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#FF5722" />
                                        <Label IsVisible="{Binding SelectedTask.Priority, Converter={StaticResource InvertedBoolConverter}}" 
                                               Text="Prioridad normal" 
                                               FontSize="14"
                                               TextColor="#666666" />
                                    </StackLayout>
                                </Frame>
                                
                                <!-- Descripción -->
                                <Label Grid.Row="4" Grid.Column="0" 
                                       Text="Descripción:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#4A744C" 
                                       VerticalOptions="Start" />
                                <Frame Grid.Row="4" Grid.Column="1"
                                       BackgroundColor="#F0F8FF"
                                       BorderColor="#E0E0E0"
                                       CornerRadius="6"
                                       Padding="10"
                                       HasShadow="False"
                                       MinimumHeightRequest="40">
                                    <Label Text="{Binding SelectedTask.Description}" 
                                           FontSize="14"
                                           TextColor="#333333"
                                           LineBreakMode="WordWrap"
                                           VerticalOptions="Start" />
                                </Frame>
                                
                                <!-- Operario -->
                                <Label Grid.Row="5" Grid.Column="0" 
                                       Text="Operario:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#4A744C" 
                                       VerticalOptions="Center" />
                                <Frame Grid.Row="5" Grid.Column="1"
                                       BackgroundColor="#E8F5E8"
                                       BorderColor="#4A744C"
                                       CornerRadius="6"
                                       Padding="10"
                                       HasShadow="False">
                                    <Label Text="{Binding SelectedTask.OperatorName}" 
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#4A744C" />
                                </Frame>
                            </Grid>
                        </StackLayout>
                        
                        <!-- Panel de finalización -->
                        <StackLayout Grid.Column="1" Spacing="20">
                            <Label Text="Finalización de Tarea" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="#4A744C" />
                            
                            <!-- Material para pérdida -->
                            <StackLayout Spacing="10">
                                <Label Text="⚠️ Material para pérdida" 
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#FF9800" />
                                <Frame BackgroundColor="White"
                                       BorderColor="#FF9800"
                                       CornerRadius="8"
                                       Padding="0"
                                       HeightRequest="50"
                                       HasShadow="True">
                                    <Entry Text="{Binding LossMaterial, Mode=TwoWay}" 
                                           Keyboard="Numeric" 
                                           FontSize="16" 
                                           TextColor="#333333" 
                                           BackgroundColor="Transparent" 
                                           Placeholder="0"
                                           PlaceholderColor="#999999"
                                           VerticalOptions="Center"
                                           Margin="15,0" />
                                </Frame>
                                <Label Text="Especifique las unidades perdidas durante la producción" 
                                       FontSize="12"
                                       TextColor="#666666"
                                       LineBreakMode="WordWrap" />
                            </StackLayout>
                            
                            <!-- Comentarios adicionales -->
                            <StackLayout Spacing="10">
                                <Label Text="Comentarios Adicionales" 
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#4A744C" />
                                <Frame BackgroundColor="White"
                                       BorderColor="#4A744C"
                                       CornerRadius="8"
                                       Padding="0"
                                       MinimumHeightRequest="100"
                                       HasShadow="True">
                                    <Editor Text="{Binding AdditionalComments}" 
                                            BackgroundColor="Transparent" 
                                            FontSize="14"
                                            TextColor="#333333"
                                            Placeholder="Ingrese comentarios sobre la finalización de la tarea..."
                                            PlaceholderColor="#999999"
                                            AutoSize="TextChanges"
                                            Margin="15" />
                                </Frame>
                                <Label Text="Opcional: Agregue observaciones sobre la tarea completada" 
                                       FontSize="12"
                                       TextColor="#666666"
                                       LineBreakMode="WordWrap" />
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </ScrollView>
                
                <!-- Separador inferior -->
                <BoxView Grid.Row="3" 
                         HeightRequest="2" 
                         Color="#4A744C" 
                         HorizontalOptions="Fill" />
                
                <!-- Botones de acción -->
                <Grid Grid.Row="4" 
                      ColumnDefinitions="auto,*" 
                      ColumnSpacing="20" 
                      HorizontalOptions="Fill">
                    <Frame Grid.Column="0"
                           Padding="12"
                           BackgroundColor="#F8F9FA"
                           BorderColor="#4A744C"
                           CornerRadius="25"
                           HasShadow="False">
                        <ImageButton Source="back_brown.png" 
                                     BackgroundColor="Transparent"
                                     WidthRequest="32"
                                     HeightRequest="32"
                                     Command="{Binding ClosePopupCommand}" />
                    </Frame>
                    <Button Grid.Column="1"
                            Text="Completar Tarea" 
                            BackgroundColor="#4A744C" 
                            TextColor="White" 
                            FontSize="18"
                            FontAttributes="Bold"
                            CornerRadius="8" 
                            HeightRequest="60"
                            HorizontalOptions="Fill"
                            Command="{Binding ShowFinishTaskAuthPopupCommand}" />
                </Grid>
            </Grid>
        </Frame>
    </Grid>
</ContentView>
