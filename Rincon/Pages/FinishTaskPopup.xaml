<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Rincon.Pages.FinishTaskPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Rincon.ViewModels"
    x:DataType="viewModels:OperatorsViewModel"
    BackgroundColor="#80000000">
  <Grid VerticalOptions="Center" HorizontalOptions="Center">
    <Frame Margin="40" Padding="25" BackgroundColor="#FAFAFA" CornerRadius="12" HasShadow="True" VerticalOptions="Center" HorizontalOptions="Center">
      <StackLayout Spacing="18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Label Text="Finalizar tarea" Grid.Column="1" FontSize="22" FontAttributes="Bold" TextColor="#222" HorizontalOptions="Center" />
          <Label Text="{Binding SelectedTask.Id, StringFormat='Tarea #{0}'}" Grid.Column="2" FontSize="16" TextColor="#888" VerticalTextAlignment="End" HorizontalOptions="End" />
        </Grid>
        <BoxView HeightRequest="1" Color="#BDBDBD" Margin="0,10,0,10" />
        <Grid ColumnSpacing="12" RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <!-- Info tarea -->
          <Label Text="Tipo de proceso" Grid.Row="0" Grid.Column="0" TextColor="#666" />
          <Label Text="{Binding SelectedTask.ProductSource}" Grid.Row="0" Grid.Column="1" TextColor="#222" />
          <Label Text="Producto" Grid.Row="1" Grid.Column="0" TextColor="#666" />
          <Label Text="{Binding SelectedTask.ProductDestination}" Grid.Row="1" Grid.Column="1" TextColor="#222" />
          <Label Text="Unidades" Grid.Row="2" Grid.Column="0" TextColor="#666" />
          <Label Text="{Binding SelectedTask.Quantity}" Grid.Row="2" Grid.Column="1" TextColor="#222" />
          <Label Text="Prioridad" Grid.Row="3" Grid.Column="0" TextColor="#666" />
          <Label Text="{Binding SelectedTask.Priority, Converter={StaticResource BoolToTextConverter}}" Grid.Row="3" Grid.Column="1" TextColor="#222" />
          <Label Text="Comentarios" Grid.Row="4" Grid.Column="0" TextColor="#666" />
          <Label Text="{Binding SelectedTask.OperatorComment}" Grid.Row="4" Grid.Column="1" TextColor="#222" />
          <!-- Material para pérdida -->
          <Label Text="Material para pérdida" Grid.Row="5" Grid.Column="0" TextColor="#666" />
          <Entry Text="{Binding LossMaterial}" Grid.Row="5" Grid.Column="1" BackgroundColor="#E0E0E0" HeightRequest="30" />
          <!-- Comentarios adicionales -->
          <Label Text="Comentarios adicionales" Grid.Row="6" Grid.Column="0" TextColor="#666" />
          <Editor Text="{Binding AdditionalComments}" Grid.Row="6" Grid.Column="1" BackgroundColor="#E0E0E0" HeightRequest="60" />
        </Grid>
        <BoxView HeightRequest="1" Color="#BDBDBD" Margin="0,20,0,10" />
        <Button Text="Finalizar" BackgroundColor="#E0E0E0" TextColor="#222" CornerRadius="8" HorizontalOptions="Center" WidthRequest="120"  Command="{Binding ShowFinishTaskAuthPopupCommand}" />
        <Button Text="Cerrar" BackgroundColor="#F5F5F5" TextColor="#888" CornerRadius="8" HorizontalOptions="Center" WidthRequest="120" Command="{Binding ClosePopupCommand}" />
      </StackLayout>
    </Frame>
  </Grid>
</ContentView>
